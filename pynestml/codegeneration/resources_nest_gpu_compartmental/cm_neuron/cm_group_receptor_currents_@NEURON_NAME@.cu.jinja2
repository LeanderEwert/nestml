__global__
void {{receptor_name}}_device_update(double* y, double* param, std::size_t neuron_{{receptor_name}}_receptor_count)
{
  std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < neuron_{{receptor_name}}_receptor_count)
  {
          {%- for ode_variable, ode_info in receptor_info["ODEs"].items() %}
          {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
      y[i_{{ propagator }}+i] = {{ cuda_printer.print(propagator_info["init_expression"], "i") }};
          {%- endfor %}
          {%- for state, state_solution_info in ode_info["transformed_solutions"][0]["states"].items() %}
      y[i_{{state}}+i] = {{ cuda_printer.print(state_solution_info["update_expression"], "i") }};
          {%- endfor %}
      {%- endfor %}

      // update kernel state variable / compute recaptic conductance
      {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items() %}
      y[i_{{state_variable_name}}+i] = {{ cuda_printer.print(state_variable_info["update_expression"], "i") }};
          {%- if convolution_info["spikes"]["name"] == "self_spikes" %}
      //y[i_{{state_variable_name}}+i] += self_spikes[i] * {{ cuda_printer.print(state_variable_info["init_expression"], "i") }};
          {%- else %}
      y[i_{{state_variable_name}}+i] += y[i_s_val+i] * {{ cuda_printer.print(state_variable_info["init_expression"], "i") }};
          {%- endif %}
      {%- endfor %}
      {%- endfor %}

      // total current
      // this expression should be the transformed inline expression
      y[i_i_tot_{{receptor_name}}+i] = {{ cuda_printer.print(receptor_info["root_expression"], "i") }};

      // derivative of that expression
      // voltage derivative of total current
      // compute derivative with respect to current with sympy
      y[i_d_i_tot_dv+i] = {{ cuda_printer.print(receptor_info["inline_derivative"], "i") }};

      // for numerical integration
      y[i_g_val+i] = - y[i_d_i_tot_dv+i];
      y[i_i_val+i] = y[i_i_tot_{{receptor_name}}+i] - y[i_d_i_tot_dv+i] * y[i_v_comp+i];
  }
}

std::pair< std::vector< double >, std::vector< double > > {{receptor_name}}{{cm_unique_suffix}}::f_numstep(std::vector< double > v_comp, const long lag {% for ode in receptor_info["Dependencies"]["concentrations"] %}, std::vector< double > {{ode.lhs.name}}{% endfor %}{% if receptor_info["Dependencies"]["receptors"]|length %}
                        {% endif %}{% for inline in receptor_info["Dependencies"]["receptors"] %}, std::vector< double > {{inline.variable_name}}{% endfor %}{% if receptor_info["Dependencies"]["channels"]|length %}
                        {% endif %}{% for inline in receptor_info["Dependencies"]["channels"] %}, std::vector< double > {{inline.variable_name}}{% endfor %}{% if receptor_info["Dependencies"]["continuous"]|length %}
                        {% endif %}{% for inline in receptor_info["Dependencies"]["continuous"] %}, std::vector< double > {{inline.variable_name}}{% endfor %})
{

    {% if receptor_info["ODEs"].items()|length %} std::vector< double > {{ printer_no_origin.print(receptor_info["analytic_helpers"]["__h"]["ASTVariable"]) }}(neuron_{{ receptor_name }}_receptor_count, time_resolution); {% endif %}

  for(std::size_t i = 0; i < neuron_{{ receptor_name }}_receptor_count; i++){
      // get spikes
      s_val[i] = *{{receptor_info["buffer_name"]}}_[i];
  }

  cudaMemcpy(GPU_v_comp, v_comp.data(), neuron_{{receptor_name}}_receptor_count * sizeof(double), cudaMemcpyHostToDevice);
  cudaMemcpy(GPU_s_val, s_val.data(), neuron_{{receptor_name}}_receptor_count * sizeof(double), cudaMemcpyHostToDevice);

  const int threads_per_block = 256;
  const int blocks = (neuron_{{receptor_name}}_receptor_count + threads_per_block - 1) / threads_per_block;
  {{receptor_name}}_device_update<<<blocks, threads_per_block>>>(GPU_{{receptor_name}}_vars, GPU_{{receptor_name}}_param, neuron_{{receptor_name}}_receptor_count);
  cudaDeviceSynchronize();

  cudaMemcpy(i_tot_{{receptor_name}}.data(), GPU_i_tot_{{receptor_name}}, neuron_{{receptor_name}}_receptor_count * sizeof(double), cudaMemcpyDeviceToHost);
  cudaMemcpy(g_val.data(), GPU_g_val, neuron_{{receptor_name}}_receptor_count * sizeof(double), cudaMemcpyDeviceToHost);
  cudaMemcpy(i_val.data(), GPU_i_val, neuron_{{receptor_name}}_receptor_count * sizeof(double), cudaMemcpyDeviceToHost);

  return std::make_pair(g_val, i_val);

}

