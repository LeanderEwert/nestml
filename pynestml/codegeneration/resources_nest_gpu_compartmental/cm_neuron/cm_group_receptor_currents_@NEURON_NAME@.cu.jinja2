// {{receptor_name}} receptor ////////////////////////////////////////////////////////////////

void {{receptor_name}}{{cm_unique_suffix}}::new_receptor(std::size_t comp_ass, const long rec_index)
{
    neuron_{{ receptor_name }}_receptor_count++;
    i_tot_{{receptor_name}}.push_back(0);
    compartment_association.push_back(comp_ass);
    rec_idx.push_back(rec_index);

    {%- for pure_variable_name, variable_info in receptor_info["States"].items() %}
    // state variable {{pure_variable_name }}
    {%- set variable = variable_info["ASTVariable"] %}
    {%- set rhs_expression = variable_info["rhs_expression"] %}
    {{ variable.name}}.push_back({{ vector_printer.print(rhs_expression, "neuron_"+receptor_name+"_receptor_count-1") -}});
    {%- endfor %}

    {% for variable_type, variable_info in receptor_info["Parameters"].items() %}
    // receptor parameter {{variable_type }}
    {%- set variable = variable_info["ASTVariable"] %}
    {%- set rhs_expression = variable_info["rhs_expression"] %}
    {{ variable.name}}.push_back({{ vector_printer.print(rhs_expression, "neuron_"+receptor_name+"_receptor_count-1") -}});
    {%- endfor %}

    // set propagators to ode toolbox returned value
  {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
  {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
    {{state_variable_name}}.push_back(0);
  {%- endfor %}
  {%- endfor %}

    // initial values for kernel state variables, set to zero
  {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
  {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
    {{state_variable_name}}.push_back(0);
  {%- endfor %}
  {%- endfor %}

    // user declared internals in order they were declared
  {%- for internal_name, internal_declaration in receptor_info["internals_used_declared"] %}
    {{internal_name}}.push_back(0);
  {%- endfor %}
}

void {{receptor_name}}{{cm_unique_suffix}}::new_receptor(std::size_t comp_ass, const long rec_index, const nlohmann::json& receptor_params)
/* update {{receptor}} receptor parameters and states */
{
    neuron_{{ receptor_name }}_receptor_count++;
    compartment_association.push_back(comp_ass);
    i_tot_{{receptor_name}}.push_back(0);
    rec_idx.push_back(rec_index);

    {%- for pure_variable_name, variable_info in receptor_info["States"].items() %}
    // state variable {{pure_variable_name }}
    {%- set variable = variable_info["ASTVariable"] %}
    {%- set rhs_expression = variable_info["rhs_expression"] %}
    {{ variable.name}}.push_back({{ vector_printer.print(rhs_expression, "neuron_"+receptor_name+"_receptor_count-1") -}});
    {%- endfor %}

    {%- for variable_type, variable_info in receptor_info["States"].items() %}
        {%- set variable = variable_info["ASTVariable"] %}
    if( receptor_params.contains( "{{variable.name}}" ) )
        {{variable.name}}[neuron_{{ receptor_name }}_receptor_count-1] = receptor_params.at("{{variable.name}}").get<double>();
    {%- endfor %}

    {%- for variable_type, variable_info in receptor_info["ODEs"].items() %}
        {%- set variable_name = variable_type %}
        {%- set dynamic_variable = render_dynamic_channel_variable_name(variable_type, ion_channel_name) %}
    // {{concentration_name}} concentration ODE state {{dynamic_variable }}
    if( receptor_params.contains( "{{variable_name}}" ) )
        {{variable_name}}[neuron_{{ receptor_name }}_receptor_count-1] = receptor_params.at("{{variable_name}}").get<double>();
    {%- endfor %}

    {% for variable_type, variable_info in receptor_info["Parameters"].items() %}
    // receptor parameter {{variable_type }}
    {%- set variable = variable_info["ASTVariable"] %}
    {%- set rhs_expression = variable_info["rhs_expression"] %}
    {{ variable.name}}.push_back({{ vector_printer.print(rhs_expression, "neuron_"+receptor_name+"_receptor_count-1") -}});
    {%- endfor %}

    {%- for variable_type, variable_info in receptor_info["Parameters"].items() %}
        {%- set variable = variable_info["ASTVariable"] %}
    if( receptor_params.contains( "{{variable.name}}" ) )
        {{variable.name}}[neuron_{{ receptor_name }}_receptor_count-1] = receptor_params.at("{{variable.name}}").get<double>();
    {%- endfor %}

    // set propagators to ode toolbox returned value
  {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
  {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
    {{state_variable_name}}.push_back(0);
  {%- endfor %}
  {%- endfor %}

    // initial values for kernel state variables, set to zero
  {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
  {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
    {{state_variable_name}}.push_back(0);
  {%- endfor %}
  {%- endfor %}

    // user declared internals in order they were declared
  {%- for internal_name, internal_declaration in receptor_info["internals_used_declared"] %}
    {{internal_name}}.push_back(0);
  {%- endfor %}
}

void {{receptor_name}}{{cm_unique_suffix}}::calibrate(double time_resolution)
{

    std::vector< double > {{ printer_no_origin.print(receptor_info["analytic_helpers"]["__h"]["ASTVariable"]) }}(neuron_{{ receptor_name }}_receptor_count, time_resolution);

  {%- for state_name, state_declaration in receptor_info["States"].items() %}
    std::vector< double > {{state_name}} = (neuron_{{ receptor_name }}_receptor_count, {{ printer_no_origin.print(state_declaration["rhs_expression"])}});
  {%- endfor %}

  for(std::size_t i = 0; i < neuron_{{ receptor_name }}_receptor_count; i++){
    // set propagators to ode toolbox returned value
  {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
  {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
    {{state_variable_name}}[i] = {{ vector_printer.print(state_variable_info["init_expression"], "i") }};
  {%- endfor %}
  {%- endfor %}

    // initial values for kernel state variables, set to zero
  {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
  {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
    {{state_variable_name}}[i] = 0;
  {%- endfor %}
  {%- endfor %}

    // user declared internals in order they were declared
  {%- for internal_name, internal_declaration in receptor_info["internals_used_declared"] %}
    {{internal_name}}[i] = {{ vector_printer.print(internal_declaration.get_expression(), "i") }};
  {%- endfor %}

  }

  s_val = std::vector<double>(neuron_{{ receptor_name }}_receptor_count, 0);
  g_val = std::vector<double>(neuron_{{ receptor_name }}_receptor_count, 0);
  i_val = std::vector<double>(neuron_{{ receptor_name }}_receptor_count, 0);
  d_i_tot_dv = std::vector<double>(neuron_{{ receptor_name }}_receptor_count, 0);

  if (GPU_{{receptor_name}}_vars == nullptr)
  {
    throw std::runtime_error("{{receptor_name}} base variable array was not initialized before calibrate()");
  }
  if (N_{{receptor_name}}_PARAM > 0 && GPU_{{receptor_name}}_param == nullptr)
  {
    throw std::runtime_error("{{receptor_name}} base parameter array was not initialized before calibrate()");
  }

  GPU_v_comp = GPU_{{receptor_name}}_vars + mechanism_stride * i_v_comp;

  GPU_s_val =
      GPU_{{receptor_name}}_vars + mechanism_stride * i_s_val;

  GPU_i_tot_{{receptor_name}} =
      GPU_{{receptor_name}}_vars + mechanism_stride * i_i_tot_{{receptor_name}};

  GPU_g_val =
      GPU_{{receptor_name}}_vars + mechanism_stride * i_g_val;

  GPU_i_val =
      GPU_{{receptor_name}}_vars + mechanism_stride * i_i_val;

  GPU_i_tot_dv =
      GPU_{{receptor_name}}_vars + mechanism_stride * i_i_tot_dv;

  GPU_d_i_tot_dv =
      GPU_{{receptor_name}}_vars + mechanism_stride * i_d_i_tot_dv;

    //model specific states
    {%- for variable_name, variable_info in receptor_info["States"].items() %}
  GPU_{{ variable_name }} = GPU_{{receptor_name}}_vars + mechanism_stride * i_{{ variable_name }};
    {%- endfor %}

    {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  GPU_{{state_variable_name}} = GPU_{{receptor_name}}_vars + mechanism_stride * i_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  GPU_{{state_variable_name}} = GPU_{{receptor_name}}_vars + mechanism_stride * i_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    //model specific parameters
    {%- for param_name, param_declaration in receptor_info["Parameters"].items() %}
  GPU_{{param_name}} = GPU_{{receptor_name}}_param + mechanism_stride * i_{{param_name}};
    {%- endfor %}

    {%- for internal_name, internal_declaration in receptor_info["internals_used_declared"] %}
  GPU_{{internal_name}} = GPU_{{receptor_name}}_param + mechanism_stride * i_{{internal_name}};
    {%- endfor %}

//copy data to base-neuron device variables:
  for(std::size_t rec_id = 0; rec_id < neuron_{{ receptor_name }}_receptor_count; rec_id++){
    const std::size_t slot = rec_id;
    if (slot >= static_cast<std::size_t>(mechanism_stride))
    {
      continue;
    }

    float recordable_value = static_cast<float>(s_val[rec_id]);
    cudaMemcpy(GPU_s_val + slot, &recordable_value, sizeof(float), cudaMemcpyHostToDevice);
    recordable_value = static_cast<float>(i_tot_{{receptor_name}}[rec_id]);
    cudaMemcpy(GPU_i_tot_{{receptor_name}} + slot, &recordable_value, sizeof(float), cudaMemcpyHostToDevice);
    recordable_value = static_cast<float>(g_val[rec_id]);
    cudaMemcpy(GPU_g_val + slot, &recordable_value, sizeof(float), cudaMemcpyHostToDevice);
    recordable_value = static_cast<float>(i_val[rec_id]);
    cudaMemcpy(GPU_i_val + slot, &recordable_value, sizeof(float), cudaMemcpyHostToDevice);
    recordable_value = 0.0f;
    cudaMemcpy(GPU_i_tot_dv + slot, &recordable_value, sizeof(float), cudaMemcpyHostToDevice);
    recordable_value = static_cast<float>(d_i_tot_dv[rec_id]);
    cudaMemcpy(GPU_d_i_tot_dv + slot, &recordable_value, sizeof(float), cudaMemcpyHostToDevice);

    {%- for variable_name, variable_info in receptor_info["States"].items() %}
    recordable_value = static_cast<float>({{ variable_name }}[rec_id]);
    cudaMemcpy(GPU_{{ variable_name }} + slot, &recordable_value, sizeof(float), cudaMemcpyHostToDevice);
    {% endfor -%}

    {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
    recordable_value = static_cast<float>({{state_variable_name}}[rec_id]);
    cudaMemcpy(GPU_{{state_variable_name}} + slot, &recordable_value, sizeof(float), cudaMemcpyHostToDevice);
      {% endfor -%}
    {% endfor -%}

    {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
    recordable_value = static_cast<float>({{state_variable_name}}[rec_id]);
    cudaMemcpy(GPU_{{state_variable_name}} + slot, &recordable_value, sizeof(float), cudaMemcpyHostToDevice);
      {% endfor -%}
    {% endfor -%}

    {%- for param_name, param_declaration in receptor_info["Parameters"].items() %}
    recordable_value = static_cast<float>({{param_name}}[rec_id]);
    cudaMemcpy(GPU_{{param_name}} + slot, &recordable_value, sizeof(float), cudaMemcpyHostToDevice);
    {% endfor -%}

    {%- for internal_name, internal_declaration in receptor_info["internals_used_declared"] %}
    recordable_value = static_cast<float>({{internal_name}}[rec_id]);
    cudaMemcpy(GPU_{{internal_name}} + slot, &recordable_value, sizeof(float), cudaMemcpyHostToDevice);
    {% endfor -%}
  }
}

struct {{receptor_name}}{{cm_unique_suffix}}Device
{
  static constexpr int i_v_comp = i_{{ receptor_name }}_v_comp;
  static constexpr int i_s_val = i_{{ receptor_name }}_s_val;
  static constexpr int i_g_val = i_{{ receptor_name }}_g_val;
  static constexpr int i_i_val = i_{{ receptor_name }}_i_val;
  static constexpr int i_i_tot_dv = i_{{ receptor_name }}_i_tot_dv;
  static constexpr int i_d_i_tot_dv = i_{{ receptor_name }}_d_i_tot_dv;

  float* y;
  float* param;
  float* population_vars;
  int* compartment_association;
  int* receptor_index;
  int* global_self_spikes;
  double* global_time_resolution;
  int mechanism_stride;
  int population_n_var;
  int population_n_param;
  int population_compartment_count;
  int population_voltage_base_index;
  std::size_t total_mechanism_count;
  {%- for ode in receptor_info["Dependencies"]["concentrations"] %}
  float* dep_{{ode.lhs.name}};
  {%- endfor %}
  {%- for inline in receptor_info["Dependencies"]["receptors"] %}
  float* dep_{{inline.variable_name}};
  {%- endfor %}
  {%- for inline in receptor_info["Dependencies"]["channels"] %}
  float* dep_{{inline.variable_name}};
  {%- endfor %}
  {%- for inline in receptor_info["Dependencies"]["continuous"] %}
  float* dep_{{inline.variable_name}};
  {%- endfor %}

{%- for function in receptor_info["Functions"] %}
  {{ device_function_declaration.DeviceFunctionDeclaration(function, function.get_name()) }}
  {
  {%-   filter indent(4,True) %}
  {%-   with ast = function.get_stmts_body() %}
  {%-     set printer = printer_no_origin %}
  {%-     include "directives_cpp/StmtsBody.jinja2" %}
  {%-   endwith %}
  {%-   endfilter %}
  }
{%- endfor %}

{%- set device_black_list = namespace(names=["self_spikes"]) %}
{%- for ode in receptor_info["Dependencies"]["concentrations"] %}
{%- set device_black_list.names = device_black_list.names + [ode.lhs.name] %}
{%- endfor %}
{%- for inline in receptor_info["Dependencies"]["receptors"] %}
{%- set device_black_list.names = device_black_list.names + [inline.variable_name] %}
{%- endfor %}
{%- for inline in receptor_info["Dependencies"]["channels"] %}
{%- set device_black_list.names = device_black_list.names + [inline.variable_name] %}
{%- endfor %}
{%- for inline in receptor_info["Dependencies"]["continuous"] %}
{%- set device_black_list.names = device_black_list.names + [inline.variable_name] %}
{%- endfor %}
{%- for replacement, expression in receptor_info["cse_function_replacements"].items() %}
{%- set device_black_list.names = device_black_list.names + [replacement] %}
{%- endfor %}
{%- for replacement, expression in receptor_info["cse_body_replacements"].items() %}
{%- set device_black_list.names = device_black_list.names + [replacement] %}
{%- endfor %}

  __device__ __forceinline__
  void update(std::size_t i) const
  {
      const int i_neuron = static_cast<int>(i) / mechanism_stride;
      const int slot = static_cast<int>(i) % mechanism_stride;
      if (slot < 0 || slot >= mechanism_stride)
      {
        return;
      }
      float* y = this->y + i_neuron * population_n_var;
      float* param = this->param == nullptr ? nullptr : this->param + i_neuron * population_n_param;
      const double self_spikes = static_cast<double>(global_self_spikes[i_neuron]);
      const int comp = compartment_association[i];
      const int local_comp = comp - i_neuron * population_compartment_count;
      const int voltage_index =
        i_neuron * population_n_var + population_voltage_base_index + local_comp;
      y[i_v_comp*mechanism_stride+slot] = population_vars[voltage_index];
      {%- for ode in receptor_info["Dependencies"]["concentrations"] %}
      const double {{ode.lhs.name}} = dep_{{ode.lhs.name}} == nullptr ? 0.0 : dep_{{ode.lhs.name}}[comp];
      {%- endfor %}
      {%- for inline in receptor_info["Dependencies"]["receptors"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for inline in receptor_info["Dependencies"]["channels"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for inline in receptor_info["Dependencies"]["continuous"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for replacement, expression in receptor_info["cse_function_replacements"].items() %}
      const double {{ replacement }} = {{ cuda_printer.print(expression, "slot", black_list=device_black_list.names, stride="mechanism_stride") }};
      {%- endfor %}
      {%- for replacement, expression in receptor_info["cse_body_replacements"].items() %}
      const double {{ replacement }} = {{ cuda_printer.print(expression, "slot", black_list=device_black_list.names, stride="mechanism_stride") }};
      {%- endfor %}
      {%- for ode_variable, ode_info in receptor_info["ODEs"].items() %}
          {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
      y[i_{{ propagator }}*mechanism_stride+slot] = {{ cuda_printer.print(propagator_info["init_expression"], "slot", black_list=device_black_list.names, stride="mechanism_stride") }};
          {%- endfor %}
          {%- for state, state_solution_info in ode_info["transformed_solutions"][0]["states"].items() %}
      y[i_{{state}}*mechanism_stride+slot] = {{ cuda_printer.print(state_solution_info["update_expression"], "slot", black_list=device_black_list.names, stride="mechanism_stride") }};
          {%- endfor %}
      {%- endfor %}

      // update kernel state variable / compute recaptic conductance
      {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items() %}
      y[i_{{state_variable_name}}*mechanism_stride+slot] = {{ cuda_printer.print(state_variable_info["update_expression"], "slot", black_list=device_black_list.names, stride="mechanism_stride") }};
          {%- if convolution_info["spikes"]["name"] == "self_spikes" %}
      y[i_{{state_variable_name}}*mechanism_stride+slot] += self_spikes * {{ cuda_printer.print(state_variable_info["init_expression"], "slot", black_list=device_black_list.names, stride="mechanism_stride") }};
          {%- else %}
      y[i_{{state_variable_name}}*mechanism_stride+slot] += y[i_s_val*mechanism_stride+slot] * {{ cuda_printer.print(state_variable_info["init_expression"], "slot", black_list=device_black_list.names, stride="mechanism_stride") }};
          {%- endif %}
      {%- endfor %}
      {%- endfor %}

      // total current
      // this expression should be the transformed inline expression
