__global__
void {{receptor_name}}_device_update({{receptor_name}}{{cm_unique_suffix}}Device device,
                                     float* port_input_arr,
                                     int port_input_arr_step,
                                     int port_input_port_step,
                                     float* compartment_g,
                                     float* compartment_i,
                                     int total_compartment_count)
{
  std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < device.total_mechanism_count)
  {
      const int i_neuron = static_cast<int>(i) / device.mechanism_stride;
      const int slot = static_cast<int>(i) % device.mechanism_stride;
      float* y = device.y + i_neuron * device.population_n_var;
      float input_value = 0.0f;
      if (port_input_arr != nullptr)
      {
        const int receptor = device.receptor_index[i];
        if (receptor >= 0)
        {
          float* input = port_input_arr + i_neuron * port_input_arr_step + receptor * port_input_port_step;
          input_value = *input;
          *input = 0.0f;
        }
      }
      y[device.i_s_val * device.mechanism_stride + slot] = input_value;
      device.update(i);
      device.update_block(i);
      const int compartment = device.compartment_association[i];
      if (compartment >= 0 && compartment < total_compartment_count)
      {
        atomicAdd(compartment_g + compartment, y[device.i_g_val * device.mechanism_stride + slot]);
        atomicAdd(compartment_i + compartment, y[device.i_i_val * device.mechanism_stride + slot]);
      }
  }
}

__global__
void {{receptor_name}}_device_self_spike_block({{receptor_name}}{{cm_unique_suffix}}Device device)
{
  std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < device.total_mechanism_count
      && device.global_self_spikes[i / device.mechanism_stride])
  {
      device.self_spike_block(i);
  }
}

__global__
void {{receptor_name}}_aggregate_total_current_kernel({{receptor_name}}{{cm_unique_suffix}}Device device,
                                                     float* compartment_current,
                                                     int compartment_count)
{
  const std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < device.total_mechanism_count)
  {
    const int i_neuron = static_cast<int>(i) / device.mechanism_stride;
    const int slot = static_cast<int>(i) % device.mechanism_stride;
    const float* y = device.y + i_neuron * device.population_n_var;
    const int compartment = device.compartment_association[i];
    if (compartment >= 0 && compartment < compartment_count)
    {
      atomicAdd(compartment_current + compartment,
                y[i_i_tot_{{receptor_name}} * device.mechanism_stride + slot]);
    }
  }
}

void {{receptor_name}}{{cm_unique_suffix}}::configure_population(
  float* var_arr,
  float* param_arr,
  int n_var,
  int n_param,
  int neuron_count,
  int compartment_count,
  int compartment_voltage_base_index,
  int mechanism_count,
  int mechanism_var_base_index,
  int mechanism_param_base_index,
  const std::vector<int>& global_compartment_association,
  const std::vector<int>& receptor_indices,
  int* global_self_spikes,
  double* global_time_resolution)
{
  population_neuron_count = neuron_count;
  population_n_var = n_var;
  population_n_param = n_param;
  population_compartment_count = compartment_count;
  population_voltage_base_index = compartment_voltage_base_index;
  mechanism_stride = mechanism_count;
  neuron_{{receptor_name}}_receptor_count = mechanism_count;
  var_base_index = mechanism_var_base_index;
  param_base_index = mechanism_param_base_index;
  GPU_population_vars = var_arr;
  GPU_{{receptor_name}}_vars = var_arr == nullptr ? nullptr : var_arr + var_base_index;
  GPU_{{receptor_name}}_param = param_arr == nullptr ? nullptr : param_arr + param_base_index;
  GPU_self_spikes = global_self_spikes;
  GPU_time_resolution = global_time_resolution;

  const std::size_t total_count = global_compartment_association.size();
  if (total_count > 0)
  {
    cudaMalloc(&GPU_compartment_association, total_count * sizeof(int));
    cudaMemcpy(GPU_compartment_association,
               global_compartment_association.data(),
               total_count * sizeof(int),
               cudaMemcpyHostToDevice);
    cudaMalloc(&GPU_rec_idx, total_count * sizeof(int));
    cudaMemcpy(GPU_rec_idx,
               receptor_indices.data(),
               total_count * sizeof(int),
               cudaMemcpyHostToDevice);
  }
}

void {{receptor_name}}{{cm_unique_suffix}}::f_numstep_device(float* /*shared_v_comp*/, float* compartment_g, float* compartment_i, int total_compartment_count, long /*lag*/, float* port_input_arr, int port_input_arr_step, int port_input_port_step{% for ode in receptor_info["Dependencies"]["concentrations"] %}, float* dep_{{ode.lhs.name}}{% endfor %}{% for inline in receptor_info["Dependencies"]["receptors"] %}, float* dep_{{inline.variable_name}}{% endfor %}{% for inline in receptor_info["Dependencies"]["channels"] %}, float* dep_{{inline.variable_name}}{% endfor %}{% for inline in receptor_info["Dependencies"]["continuous"] %}, float* dep_{{inline.variable_name}}{% endfor %}, cudaStream_t stream)
{
  if (neuron_{{ receptor_name }}_receptor_count == 0)
  {
    return;
  }

  const int threads_per_block = 256;
  const std::size_t total_count = population_neuron_count * neuron_{{receptor_name}}_receptor_count;
  const int blocks = (total_count + threads_per_block - 1) / threads_per_block;

  bind_device_dependencies({% for ode in receptor_info["Dependencies"]["concentrations"] %}{% if not loop.first %}, {% endif %}dep_{{ode.lhs.name}}{% endfor %}{% if receptor_info["Dependencies"]["concentrations"] and (receptor_info["Dependencies"]["receptors"] or receptor_info["Dependencies"]["channels"] or receptor_info["Dependencies"]["continuous"]) %}, {% endif %}{% for inline in receptor_info["Dependencies"]["receptors"] %}{% if not loop.first %}, {% endif %}dep_{{inline.variable_name}}{% endfor %}{% if receptor_info["Dependencies"]["receptors"] and (receptor_info["Dependencies"]["channels"] or receptor_info["Dependencies"]["continuous"]) %}, {% endif %}{% for inline in receptor_info["Dependencies"]["channels"] %}{% if not loop.first %}, {% endif %}dep_{{inline.variable_name}}{% endfor %}{% if receptor_info["Dependencies"]["channels"] and receptor_info["Dependencies"]["continuous"] %}, {% endif %}{% for inline in receptor_info["Dependencies"]["continuous"] %}{% if not loop.first %}, {% endif %}dep_{{inline.variable_name}}{% endfor %});
  {{receptor_name}}{{cm_unique_suffix}}Device& device = device_view();
  {{receptor_name}}_device_update<<<blocks, threads_per_block, 0, stream>>>(device,
                                                                port_input_arr,
                                                                port_input_arr_step,
                                                                port_input_port_step,
                                                                compartment_g,
                                                                compartment_i,
                                                                total_compartment_count);
}

void {{receptor_name}}{{cm_unique_suffix}}::add_total_current_to_device(float* compartment_current, int compartment_count, cudaStream_t stream) const
{
  if (neuron_{{ receptor_name }}_receptor_count == 0)
  {
    return;
  }
  const int threads_per_block = 256;
  const std::size_t total_count = population_neuron_count * neuron_{{receptor_name}}_receptor_count;
  const int blocks = (total_count + threads_per_block - 1) / threads_per_block;
  {{receptor_name}}{{cm_unique_suffix}}Device& device = const_cast<{{receptor_name}}{{cm_unique_suffix}}*>(this)->device_view();
  {{receptor_name}}_aggregate_total_current_kernel<<<blocks, threads_per_block, 0, stream>>>(device,
                                                                                compartment_current,
                                                                                compartment_count);
}

