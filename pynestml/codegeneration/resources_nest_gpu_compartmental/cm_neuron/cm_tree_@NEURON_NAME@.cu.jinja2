float profile_elapsed_ms(cudaEvent_t start, cudaEvent_t stop)
{
  float elapsed_ms = 0.0f;
  cudaEventElapsedTime(&elapsed_ms, start, stop);
  return elapsed_ms;
}

__device__ __forceinline__ int
neuron_index_from_global_compartment(int global_compartment, int compartments_per_neuron)
{
  return global_compartment / compartments_per_neuron;
}

__device__ __forceinline__ int
local_compartment_index_from_global_compartment(int global_compartment, int compartments_per_neuron)
{
  return global_compartment % compartments_per_neuron;
}

__global__ void cm_tree_construct_matrix_kernel(float* population_vars,
                                                int n_var,
                                                int compartment_voltage_base_index,
                                                const float* ca__div__dt,
                                                const float* gl__times__el,
                                                const float* matrix_diagonal,
                                                float* gg,
                                                float* ff,
                                                const float* mech_g,
                                                const float* mech_i,
                                                int compartment_count,
                                                int total_compartment_count)
{
  const int global_compartment = blockIdx.x * blockDim.x + threadIdx.x;
  if (global_compartment >= total_compartment_count)
  {
    return;
  }

  const int i_neuron =
    neuron_index_from_global_compartment(global_compartment, compartment_count);
  const int local_compartment =
    local_compartment_index_from_global_compartment(global_compartment, compartment_count);
  const int voltage_index =
    i_neuron * n_var + compartment_voltage_base_index + local_compartment;
  const float voltage = population_vars[voltage_index];
  gg[global_compartment] = matrix_diagonal[global_compartment] + mech_g[global_compartment];
  ff[global_compartment] = ca__div__dt[global_compartment] * voltage
    + gl__times__el[global_compartment] + mech_i[global_compartment];
}

__global__ void cm_tree_downsweep_level_kernel(const int* level_nodes,
                                               int level_node_count,
                                               const int* child_offsets,
                                               const int* child_indices,
                                               const float* hh,
                                               float* gg,
                                               float* ff)
{
  const int level_index = blockIdx.x * blockDim.x + threadIdx.x;
  if (level_index >= level_node_count)
  {
    return;
  }

  const int node = level_nodes[level_index];
  float node_g = gg[node];
  float node_f = ff[node];
  for (int child_entry = child_offsets[node + 1] - 1; child_entry >= child_offsets[node]; --child_entry)
  {
    const int child = child_indices[child_entry];
    const float factor = hh[child] / gg[child];
    node_g -= hh[child] * factor;
    node_f -= ff[child] * factor;
  }
  gg[node] = node_g;
  ff[node] = node_f;
}

__global__ void cm_tree_solve_root_and_upsweep_kernel(float* population_vars,
                                                      int n_var,
                                                      int compartment_voltage_base_index,
                                                      const float* gg,
                                                      const float* ff,
                                                      const float* hh,
                                                      const int* parent_index,
                                                      int neuron_count,
                                                      int compartment_count,
                                                      const float* thresholds,
                                                      int* self_spikes)
{
  const int i_neuron = blockIdx.x * blockDim.x + threadIdx.x;
  if (i_neuron >= neuron_count || compartment_count <= 0)
  {
    return;
  }

  const int compartment_base = i_neuron * compartment_count;
  float* compartment_voltages =
    population_vars + i_neuron * n_var + compartment_voltage_base_index;
  const float previous_soma_voltage_value = compartment_voltages[0];
  self_spikes[i_neuron] = 0;

  compartment_voltages[0] = ff[compartment_base] / gg[compartment_base];
  for (int local = 1; local < compartment_count; ++local)
  {
    const int i = compartment_base + local;
    const int parent = parent_index[i];
    const int parent_local = parent - compartment_base;
    const float parent_v = parent >= 0 ? compartment_voltages[parent_local] : 0.0f;
    compartment_voltages[local] = (ff[i] - parent_v * hh[i]) / gg[i];
  }
  self_spikes[i_neuron] =
    (compartment_voltages[0] >= thresholds[i_neuron] && previous_soma_voltage_value < thresholds[i_neuron]) ? 1 : 0;
}
}

Compartment{{cm_unique_suffix}}::Compartment{{cm_unique_suffix}}( const long compartment_index, const long parent_index)
  : comp_index( compartment_index )
  , p_index( parent_index )
  , parent( nullptr )
  , v_comp( new double(0.0) )
  , ca( 1.0 )
  , gc( 0.01 )
  , gl( 0.1 )
  , el( -70. )
  , gg0( nullptr )
  , ca__div__dt( nullptr )
  , gl__times__el( nullptr )
  , ff( nullptr )
  , gg( nullptr )
  , hh( 0.0 )
{
  *v_comp = el;
}

Compartment{{cm_unique_suffix}}::Compartment{{cm_unique_suffix}}( const long compartment_index, const long parent_index,
    double* v_comp_ref, double* ca__div__dt_ref, double* gl__times__el_ref, double* gg0_ref, double* gg_ref, double* ff_ref )
  : comp_index( compartment_index )
  , p_index( parent_index )
  , parent( nullptr )
  , v_comp( v_comp_ref )
  , ca( 1.0 )
  , gc( 0.01 )
  , gl( 0.1 )
  , el( -70. )
  , gg0( gg0_ref )
  , ca__div__dt( ca__div__dt_ref )
  , gl__times__el( gl__times__el_ref )
  , ff( ff_ref )
  , gg( gg_ref )
  , hh( 0.0 )
{
  *v_comp = el;
}
Compartment{{cm_unique_suffix}}::Compartment{{cm_unique_suffix}}( const long compartment_index,
  const long parent_index,
  const nlohmann::json& compartment_params,
  double* v_comp_ref, double* ca__div__dt_ref, double* gl__times__el_ref, double* gg0_ref, double* gg_ref, double* ff_ref)
  : comp_index( compartment_index )
  , p_index( parent_index )
  , parent( nullptr )
  , v_comp( v_comp_ref )
  , ca( 1.0 )
  , gc( 0.01 )
  , gl( 0.1 )
  , el( -70. )
  , gg0( gg0_ref )
  , ca__div__dt( ca__div__dt_ref )
  , gl__times__el( gl__times__el_ref )
  , ff( ff_ref )
  , gg( gg_ref )
  , hh( 0.0 )
{

  if (compartment_params.contains("C_m")) ca = compartment_params["C_m"];
  if (compartment_params.contains("g_C")) gc = compartment_params["g_C"];
  if (compartment_params.contains("g_L")) gl = compartment_params["g_L"];
  if (compartment_params.contains("e_L")) el = compartment_params["e_L"];
  double v_comp_update = el;
  if (compartment_params.contains("v_comp")) v_comp_update = compartment_params["v_comp"];

  *v_comp = v_comp_update;
}

void
Compartment{{cm_unique_suffix}}::calibrate( double time_resolution )
{

  const double dt = time_resolution;
  // used in vectorized passive loop
  *ca__div__dt = ca / dt;
  *gl__times__el = gl * el;
  *gg0 = *ca__div__dt + gl;
}

CompTree{{cm_unique_suffix}}::CompTree{{cm_unique_suffix}}()
  : root_( -1, -1 )
  , size_( 0 )
{
  compartments_.resize( 0 );
}

CompTree{{cm_unique_suffix}}::~CompTree{{cm_unique_suffix}}()
{
  if (update_graph_exec_ != nullptr)
  {
    cudaStreamSynchronize(nullptr);
  }
  destroy_update_graph();
  if (update_graph_capture_stream_ != nullptr)
  {
    cudaStreamDestroy(update_graph_capture_stream_);
  }
}

void
CompTree{{cm_unique_suffix}}::destroy_update_graph()
{
  if (update_graph_exec_ != nullptr)
  {
    cudaGraphExecDestroy(update_graph_exec_);
    update_graph_exec_ = nullptr;
  }
  if (update_graph_ != nullptr)
  {
    cudaGraphDestroy(update_graph_);
    update_graph_ = nullptr;
  }
}

/**
 * Add a compartment to the tree structure via the python interface
 * root shoud have -1 as parent index. Add root compartment first.
 * Assumes parent of compartment is already added
 */
void
CompTree{{cm_unique_suffix}}::add_compartment( const long parent_index )
{
  v_comp_vec.push_back(0.0);
  ca__div__dt_vec.push_back(0.0);
  gl__times__el_vec.push_back(0.0);
  gg0_vec.push_back(0.0);
  gg_vec.push_back(0.0);
  ff_vec.push_back(0.0);
  size_t comp_index = v_comp_vec.size()-1;

  Compartment{{cm_unique_suffix}}* compartment = new Compartment{{cm_unique_suffix}}(
    size_, parent_index, &(v_comp_vec[comp_index]), &(ca__div__dt_vec[comp_index]),
    &(gl__times__el_vec[comp_index]), &(gg0_vec[comp_index]), &(gg_vec[comp_index]), &(ff_vec[comp_index])
  );

  neuron_currents.add_compartment();
  add_compartment( compartment, parent_index );
}

