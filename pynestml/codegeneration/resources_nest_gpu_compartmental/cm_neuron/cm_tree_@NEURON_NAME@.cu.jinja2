namespace
{
__global__ void cm_tree_construct_matrix_kernel(float* v_comp,
                                                const float* ca__div__dt,
                                                const float* gl__times__el,
                                                const float* gg0,
                                                const float* gc,
                                                const int* parent_index,
                                                float* gg,
                                                float* ff,
                                                float* hh,
                                                const float* mech_g,
                                                const float* mech_i,
                                                int n_comp)
{
  const int i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i >= n_comp)
  {
    return;
  }

  float g = gg0[i] + mech_g[i];
  if (parent_index[i] >= 0)
  {
    g += gc[i];
    hh[i] = -gc[i];
  }
  else
  {
    hh[i] = 0.0f;
  }

  for (int child = 0; child < n_comp; ++child)
  {
    if (parent_index[child] == i)
    {
      g += gc[child];
    }
  }

  gg[i] = g;
  ff[i] = ca__div__dt[i] * v_comp[i] + gl__times__el[i] + mech_i[i];
}

__global__ void cm_tree_solve_matrix_kernel(float* v_comp,
                                            float* gg,
                                            float* ff,
                                            const float* hh,
                                            const int* parent_index,
                                            int n_comp,
                                            float threshold,
                                            int* self_spikes,
                                            float* previous_soma_voltage)
{
  if (threadIdx.x != 0 || blockIdx.x != 0 || n_comp <= 0)
  {
    return;
  }

  const float previous_soma_voltage_value = v_comp[0];
  if (self_spikes != nullptr)
  {
    self_spikes[0] = 0;
  }
  if (previous_soma_voltage != nullptr)
  {
    previous_soma_voltage[0] = previous_soma_voltage_value;
  }

  for (int i = n_comp - 1; i > 0; --i)
  {
    const int parent = parent_index[i];
    if (parent >= 0)
    {
      const float g_val = hh[i] * hh[i] / gg[i];
      const float f_val = ff[i] * hh[i] / gg[i];
      gg[parent] -= g_val;
      ff[parent] -= f_val;
    }
  }

  v_comp[0] = ff[0] / gg[0];
  for (int i = 1; i < n_comp; ++i)
  {
    const int parent = parent_index[i];
    const float parent_v = parent >= 0 ? v_comp[parent] : 0.0f;
    v_comp[i] = (ff[i] - parent_v * hh[i]) / gg[i];
  }
  if (self_spikes != nullptr)
  {
    self_spikes[0] = (v_comp[0] >= threshold && previous_soma_voltage_value < threshold) ? 1 : 0;
  }
}
}

Compartment{{cm_unique_suffix}}::Compartment{{cm_unique_suffix}}( const long compartment_index, const long parent_index)
  : comp_index( compartment_index )
  , p_index( parent_index )
  , parent( nullptr )
  , v_comp( new double(0.0) )
  , ca( 1.0 )
  , gc( 0.01 )
  , gl( 0.1 )
  , el( -70. )
  , gg0( nullptr )
  , ca__div__dt( nullptr )
  , gl__times__el( nullptr )
  , ff( nullptr )
  , gg( nullptr )
  , hh( 0.0 )
{
  *v_comp = el;
}

