void
CompTree{{cm_unique_suffix}}::add_compartment( Compartment{{cm_unique_suffix}}* compartment, const long parent_index )
{
  size_++;

  if ( parent_index >= 0 )
  {
    /**
     * we do not raise an UnknownCompartment exception from within
     * get_compartment(), because we want to print a more informative
     * exception message
     */
    Compartment{{cm_unique_suffix}}* parent = get_compartment( parent_index, get_root(), 0 );
    if ( parent == nullptr )
    {
      std::string msg = "does not exist in tree, but was specified as a parent compartment";
      throw std::runtime_error(msg);
    }

    parent->children.push_back( *compartment );
  }
  else
  {
    // we raise an error if the root already exists
    if ( root_.comp_index >= 0 )
    {
      std::string msg = ", the root, has already been instantiated";
      throw std::runtime_error(msg);
    }
    root_ = *compartment;
  }

  compartment_indices_.push_back( compartment->comp_index );

  set_compartments();
}

/**
 * Get the compartment corresponding to the provided index in the tree.
 *
 * This function gets the compartments by a recursive search through the tree.
 *
 * The overloaded functions looks only in the subtree of the provided compartment,
 * and also has the option to throw an error if no compartment corresponding to
 * `compartment_index` is found in the tree
 */
Compartment{{cm_unique_suffix}}*
CompTree{{cm_unique_suffix}}::get_compartment( const long compartment_index ) const
{
  return get_compartment( compartment_index, get_root(), 1 );
}

Compartment{{cm_unique_suffix}}*
CompTree{{cm_unique_suffix}}::get_compartment( const long compartment_index, Compartment{{cm_unique_suffix}}* compartment, const long raise_flag ) const
{
  Compartment{{cm_unique_suffix}}* r_compartment = nullptr;

  if ( compartment->comp_index == compartment_index )
  {
    r_compartment = compartment;
  }
  else
  {
    auto child_it = compartment->children.begin();
    while ( ( not r_compartment ) && child_it != compartment->children.end() )
    {
      r_compartment = get_compartment( compartment_index, &( *child_it ), 0 );
      ++child_it;
    }
  }

  if ( ( not r_compartment ) && raise_flag )
  {
    std::string msg = "does not exist in tree";
    throw std::runtime_error(msg);
  }

  return r_compartment;
}

/**
 * Get the compartment corresponding to the provided index in the tree. Optimized
 * trough the use of a pointer vector containing all compartments. Calling this
 * function before CompTree{{cm_unique_suffix}}::init_pointers() is called will result in a segmentation
 * fault
 */
Compartment{{cm_unique_suffix}}*
CompTree{{cm_unique_suffix}}::get_compartment_opt( const long compartment_idx ) const
{
  return compartments_[ compartment_idx ];
}

/**
 * Initialize all tree structure pointers
 */
void
CompTree{{cm_unique_suffix}}::init_pointers(int* global_self_spikes, double* global_time_resolution)
{
  set_parents();
  set_compartments();
  set_compartment_variables();
  neuron_currents.init_pointers(global_self_spikes, global_time_resolution);
}

void
CompTree{{cm_unique_suffix}}::init_base_arrays(float* var_arr, int n_var, int i_neuron, int base_index)
{
  if (var_arr == nullptr)
  {
    throw std::runtime_error("Compartment tree requires initialized BaseNeuron var_arr_ storage");
  }
  GPU_v_comp = var_arr + i_neuron * n_var + base_index;
  base_arrays_initialized_ = true;

  for (long compartment_index = 0; compartment_index < size_; ++compartment_index)
  {
    const float v_comp = static_cast<float>(v_comp_vec[compartment_index]);
    gpuErrchk(cudaMemcpy(GPU_v_comp + compartment_index, &v_comp, sizeof(float), cudaMemcpyHostToDevice));
  }
}

void
CompTree{{cm_unique_suffix}}::sync_device_tree_from_host()
{
  if (!base_arrays_initialized_)
  {
    throw std::runtime_error("Compartment tree device storage has not been initialized");
  }

  const std::size_t n_comp = static_cast<std::size_t>(size_);
  if (n_comp == 0)
  {
    return;
  }

  if (!device_tree_initialized_)
  {
    gpuErrchk(cudaMalloc(&GPU_ca__div__dt, n_comp * sizeof(float)));
    gpuErrchk(cudaMalloc(&GPU_gl__times__el, n_comp * sizeof(float)));
    gpuErrchk(cudaMalloc(&GPU_gg0, n_comp * sizeof(float)));
    gpuErrchk(cudaMalloc(&GPU_gg, n_comp * sizeof(float)));
    gpuErrchk(cudaMalloc(&GPU_ff, n_comp * sizeof(float)));
    gpuErrchk(cudaMalloc(&GPU_hh, n_comp * sizeof(float)));
    gpuErrchk(cudaMalloc(&GPU_gc, n_comp * sizeof(float)));
    gpuErrchk(cudaMalloc(&GPU_parent_index, n_comp * sizeof(int)));
    gpuErrchk(cudaMalloc(&GPU_mech_g, n_comp * sizeof(float)));
    gpuErrchk(cudaMalloc(&GPU_mech_i, n_comp * sizeof(float)));
    device_tree_initialized_ = true;
  }

  std::vector<float> ca__div__dt_host(n_comp, 0.0f);
  std::vector<float> gl__times__el_host(n_comp, 0.0f);
  std::vector<float> gg0_host(n_comp, 0.0f);
  std::vector<float> gc_host(n_comp, 0.0f);
  std::vector<int> parent_index_host(n_comp, -1);
  for (std::size_t i = 0; i < n_comp; ++i)
  {
    ca__div__dt_host[i] = static_cast<float>(ca__div__dt_vec[i]);
    gl__times__el_host[i] = static_cast<float>(gl__times__el_vec[i]);
    gg0_host[i] = static_cast<float>(gg0_vec[i]);
    gc_host[i] = static_cast<float>(compartments_[i]->gc);
    parent_index_host[i] = static_cast<int>(compartments_[i]->p_index);
  }

  gpuErrchk(cudaMemcpy(GPU_ca__div__dt, ca__div__dt_host.data(), n_comp * sizeof(float), cudaMemcpyHostToDevice));
  gpuErrchk(cudaMemcpy(GPU_gl__times__el, gl__times__el_host.data(), n_comp * sizeof(float), cudaMemcpyHostToDevice));
  gpuErrchk(cudaMemcpy(GPU_gg0, gg0_host.data(), n_comp * sizeof(float), cudaMemcpyHostToDevice));
  gpuErrchk(cudaMemcpy(GPU_gc, gc_host.data(), n_comp * sizeof(float), cudaMemcpyHostToDevice));
  gpuErrchk(cudaMemcpy(GPU_parent_index, parent_index_host.data(), n_comp * sizeof(int), cudaMemcpyHostToDevice));
}

/**
 * For each compartments, sets its pointer towards its parent compartment
 */
void
CompTree{{cm_unique_suffix}}::set_parents()
{
  for ( auto compartment_idx_it = compartment_indices_.begin(); compartment_idx_it != compartment_indices_.end();
        ++compartment_idx_it )
  {
    Compartment{{cm_unique_suffix}}* comp_ptr = get_compartment( *compartment_idx_it );
    // will be nullptr if root
    Compartment{{cm_unique_suffix}}* parent_ptr = get_compartment( comp_ptr->p_index, &root_, 0 );
    comp_ptr->parent = parent_ptr;
  }
}

/**
 * Creates a vector of compartment pointers, organized in the order in which they were
 * added by `add_compartment()`
 */
void
CompTree{{cm_unique_suffix}}::set_compartments()
{
  compartments_.clear();

  for ( auto compartment_idx_it = compartment_indices_.begin(); compartment_idx_it != compartment_indices_.end();
        ++compartment_idx_it )
  {
    compartments_.push_back( get_compartment( *compartment_idx_it ) );
  }
}

/**
 * Set pointer variables within a compartment
 */
void
CompTree{{cm_unique_suffix}}::set_compartment_variables()
{
  //reset compartment pointers due to unsafe pointers in vectors when resizing during compartment creation
  for( size_t i = 0; i < v_comp_vec.size(); i++){
    compartments_[i]->v_comp = &(v_comp_vec[i]);
    compartments_[i]->ca__div__dt = &(ca__div__dt_vec[i]);
    compartments_[i]->gl__times__el = &(gl__times__el_vec[i]);
    compartments_[i]->gg0 = &(gg0_vec[i]);
    compartments_[i]->gg = &(gg_vec[i]);
    compartments_[i]->ff = &(ff_vec[i]);
  }
}

/**
 * Initialize state variables
 */
void
CompTree{{cm_unique_suffix}}::calibrate( double time_resolution )
{
  if ( root_.comp_index < 0 )
  {
    std::string msg = "does not exist in tree, meaning that no compartments have been added";
    throw std::runtime_error(msg);
  }

  // initialize the compartments
  for ( auto compartment_it = compartments_.begin(); compartment_it != compartments_.end(); ++compartment_it )
  {
    ( *compartment_it )->calibrate( time_resolution );
  }
  sync_device_tree_from_host();
  neuron_currents.ensure_device_shared_buffers(static_cast<int>(size_));
  neuron_currents.calibrate( time_resolution );
}

void
CompTree{{cm_unique_suffix}}::update( const long lag,
                                      float* port_input_arr,
                                      int port_input_port_step,
                                      double threshold,
                                              int* self_spikes,
                                              float* previous_soma_voltage )
{
  construct_matrix(lag, port_input_arr, port_input_port_step);
  solve_matrix(threshold, self_spikes, previous_soma_voltage);
  {%- if has_self_spike_processing.value %}
  neuron_currents.postsynaptic_synaptic_processing_device();
  {%- endif %}
}

/**
 * Construct the matrix equation to be solved to advance the model one timestep
 */
void
CompTree{{cm_unique_suffix}}::construct_matrix( const long lag, float* port_input_arr, int port_input_port_step )
{
  if (!device_tree_initialized_)
  {
    throw std::runtime_error("Compartment tree device state has not been initialized before update");
  }

  neuron_currents.f_numstep_device(GPU_v_comp,
                                   GPU_mech_g,
                                   GPU_mech_i,
                                   static_cast<int>(size_),
                                   lag,
                                   port_input_arr,
                                   port_input_port_step);

  const int block_size = 128;
  const int grid_size = (static_cast<int>(size_) + block_size - 1) / block_size;
  cm_tree_construct_matrix_kernel<<<grid_size, block_size>>>(GPU_v_comp,
                                                             GPU_ca__div__dt,
                                                             GPU_gl__times__el,
                                                             GPU_gg0,
                                                             GPU_gc,
                                                             GPU_parent_index,
                                                             GPU_gg,
                                                             GPU_ff,
                                                             GPU_hh,
                                                             GPU_mech_g,
                                                             GPU_mech_i,
                                                             static_cast<int>(size_));
}

/**
 * Solve matrix with O(n) algorithm
 */
void
CompTree{{cm_unique_suffix}}::solve_matrix(double threshold, int* self_spikes, float* previous_soma_voltage)
{
  cm_tree_solve_matrix_kernel<<<1, 1>>>(GPU_v_comp,
                                        GPU_gg,
                                        GPU_ff,
                                        GPU_hh,
                                        GPU_parent_index,
                                        static_cast<int>(size_),
                                        static_cast<float>(threshold),
                                        self_spikes,
                                        previous_soma_voltage);
}
