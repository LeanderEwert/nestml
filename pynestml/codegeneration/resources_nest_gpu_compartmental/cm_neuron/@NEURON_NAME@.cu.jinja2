{{neuronName}}::~{{neuronName}}()
{
  if (profile_update_enabled_ && profile_update_calls_ > 0)
  {
    std::cerr << "{{neuronName}} update profile: "
              << "calls=" << profile_update_calls_
              << " mechanisms_ms=" << profile_mechanisms_ms_
              << " matrix_construct_ms=" << profile_matrix_construct_ms_
              << " matrix_solve_ms=" << profile_matrix_solve_ms_
              << " self_spike_ms=" << profile_self_spike_ms_
              << " total_ms=" << profile_update_ms_
              << std::endl;
  }
}

int {{neuronName}}::Init(int i_node_0, int n_node, int /*n_port*/, int i_group)
{
  BaseNeuron::Init(i_node_0, n_node, 0, i_group);
  node_type_ = i_{{neuronName}}_model;
  profile_update_enabled_ = std::getenv("NESTML_GPU_CM_PROFILE") != nullptr;

  n_scal_var_ = 0;
  n_port_ = 0;
  n_port_var_ = 0;
  n_var_ = 0;

  n_scal_param_ = 0;
  n_param_ = 0;
  n_group_param_ = N_GROUP_PARAM;
  group_param_ = nullptr;

  param_arr_ = nullptr;
  var_arr_ = nullptr;

  scal_var_name_ = {{neuronName}}_scal_var_name;
  scal_param_name_ = {{neuronName}}_scal_param_name;
  port_var_name_ = {{neuronName}}_port_var_name;
  group_param_name_ = nullptr;

  time_resolution_ = 0.1;
  neurons_.resize(n_node);

  port_weight_arr_ = nullptr;
  port_weight_arr_step_ = 0;
  port_weight_port_step_ = 0;

  port_input_arr_ = nullptr;
  port_input_arr_step_ = 0;
  port_input_port_step_ = 0;

  return 0;
}

int {{neuronName}}::Calibrate(double /*time_min*/, float time_resolution)
{
  time_resolution_ = time_resolution;

  // Freeze and validate the shared BaseNeuron variable, parameter, and port layout before any neuron binds into it.
  ensure_runtime_layout_configured();

  // Bind each neuron to the allocated BaseNeuron arrays and initialize device state.
  std::vector<CompTree{{cm_unique_suffix}}*> trees;
  std::vector<float> thresholds;
  trees.reserve(neurons_.size());
  thresholds.reserve(neurons_.size());
  for (size_t i = 0; i < neurons_.size(); ++i)
  {
    HostNeuronState& state = neurons_[i];
    // Bind this neuron's compartments and mechanisms into their fixed slices of BaseNeuron var_arr_ and param_arr_ storage.
    init_runtime_base_arrays(state, static_cast<int>(i));
    // Finalize compartment constants and initialize this neuron's BaseNeuron-backed mechanism values.
    state.c_tree.calibrate(time_resolution_);
    trees.push_back(&state.c_tree);
    thresholds.push_back(static_cast<float>(state.V_th));
  }
  // Pack tree topology and mechanism associations for the complete population into contiguous device arrays.
  population_tree_.initialize_population_runtime(trees,
                                                 GetVarArr(),
                                                 GetParamArr(),
                                                 n_var_,
                                                 n_param_,
                                                 thresholds,
                                                 time_resolution_);
  return 0;
}

