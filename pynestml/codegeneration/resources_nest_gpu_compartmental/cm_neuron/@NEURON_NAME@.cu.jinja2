#include <cmath>
#include <config.h>
#include <iostream>

#include "{{neuronName}}.h"
#include "spike_buffer.h"

using namespace {{neuronName}}_ns;

int {{neuronName}}::Init(int i_node_0, int n_node, int /*n_port*/, int i_group)
{
  BaseNeuron::Init(i_node_0, n_node, N_PORT_VAR, i_group);
  node_type_ = i_{{neuronName}}_model;

  n_scal_var_ = N_SCAL_VAR;
  n_port_var_ = N_PORT_VAR;
  n_var_ = n_scal_var_ + n_port_var_;

  n_scal_param_ = N_SCAL_PARAM;
  n_param_ = n_scal_param_;
  n_group_param_ = N_GROUP_PARAM;
  group_param_ = new float[N_GROUP_PARAM];

  if (n_param_ > 0)
  {
    AllocParamArr();
  }
  else
  {
    param_arr_ = nullptr;
  }
  if (n_var_ > 0)
  {
    AllocVarArr();
  }
  else
  {
    var_arr_ = nullptr;
  }

  scal_var_name_ = {{neuronName}}_scal_var_name;
  scal_param_name_ = {{neuronName}}_scal_param_name;
  port_var_name_ = {{neuronName}}_port_var_name;
  group_param_name_ = {{neuronName}}_group_param_name;

  SetGroupParam("h_min_rel", 1.0e-3);
  SetGroupParam("h0_rel", 1.0e-2);
  h_ = group_param_[i_h0_rel] * 0.1;
  time_resolution_ = 0.1;
  neurons_.resize(n_node);
  for (auto& state : neurons_)
  {
    ensure_device_shared_buffers(state);
  }

  float input_weight = 1.0;
  gpuErrchk(cudaMalloc(&port_weight_arr_, sizeof(float)));
  gpuErrchk(cudaMemcpy(port_weight_arr_, &input_weight, sizeof(float), cudaMemcpyHostToDevice));
  port_weight_arr_step_ = 0;
  port_weight_port_step_ = 0;

{%- if neuron.get_spike_input_ports() | length > 0 %}
  port_input_arr_ = GetVarArr() + n_scal_var_ + GetPortVarIdx("{{neuron.get_spike_input_ports()[0].get_symbol_name()}}");
  port_input_arr_step_ = n_var_;
  port_input_port_step_ = 1;
{%- endif %}

  return 0;
}

int {{neuronName}}::Calibrate(double /*time_min*/, float time_resolution)
{
  h_min_ = group_param_[i_h_min_rel] * time_resolution;
  h_ = group_param_[i_h0_rel] * time_resolution;
  time_resolution_ = time_resolution;
  for (auto& state : neurons_)
  {
    state.time_resolution = time_resolution_;
    ensure_device_shared_buffers(state);
    state.c_tree.init_pointers(state.GPU_self_spikes, state.GPU_time_resolution);
    state.c_tree.set_syn_buffers(state.syn_buffers);
    state.c_tree.pre_run_hook(time_resolution_);
  }
  return 0;
}

int {{neuronName}}::Update(long long /*it*/, double t1)
{
  const long to_step = static_cast<long>(t1 / time_resolution_);
  for (size_t i = 0; i < neurons_.size(); ++i)
  {
    HostNeuronState& state = neurons_[i];
{%- if neuron.get_spike_input_ports() | length > 0 %}
    read_spikes(state, i, N_PORT_VAR);
{%- endif %}

    for (long lag = to_step - 1; lag < to_step; ++lag)
    {
      state.self_spikes = 0;
      gpuErrchk(cudaMemcpy(state.GPU_self_spikes, &state.self_spikes, sizeof(int), cudaMemcpyHostToDevice));

      const double v_0_prev = *(state.c_tree.get_root()->v_comp);

      state.c_tree.construct_matrix(lag);
      state.c_tree.solve_matrix();

      const double v_comp = *(state.c_tree.get_root()->v_comp);
      std::cout << "[{{neuronName}} debug] neuron=" << i
                << " lag=" << lag
                << " v_comp=" << v_comp
                << std::endl;
      state.c_tree.neuron_currents.debug_print_channel_currents(i, lag);
      state.c_tree.neuron_currents.debug_print_concentrations(i, lag);
      state.c_tree.neuron_currents.debug_print_receptor_currents(i, lag);
      state.c_tree.neuron_currents.debug_print_continuous_input_currents(i, lag);

      if (v_comp >= state.V_th && v_0_prev < state.V_th)
      {
        std::cout << "[{{neuronName}} debug] neuron=" << i
                  << " lag=" << lag
                  << " soma_spike=1"
                  << " v_comp=" << v_comp
                  << " V_th=" << state.V_th
                  << std::endl;
        state.self_spikes = 1;
        gpuErrchk(cudaMemcpy(state.GPU_self_spikes, &state.self_spikes, sizeof(int), cudaMemcpyHostToDevice));
        state.c_tree.neuron_currents.postsynaptic_synaptic_processing(time_resolution_);
      }
    }
  }
  return 0;
}

int {{neuronName}}::SetNeuronVariablesDict(int i_neuron, int n_neuron, nlohmann::json dict)
{
  if (neurons_.size() < static_cast<size_t>(n_neuron))
  {
    neurons_.resize(n_neuron);
  }
  ensure_device_shared_buffers(neurons_[i_neuron]);
  set_status(neurons_[i_neuron], dict);
  return 0;
}

void {{neuronName}}::ensure_device_shared_buffers(HostNeuronState& state)
{
  if (state.GPU_self_spikes == nullptr)
  {
    gpuErrchk(cudaMalloc(&state.GPU_self_spikes, sizeof(int)));
  }
  if (state.GPU_time_resolution == nullptr)
  {
    gpuErrchk(cudaMalloc(&state.GPU_time_resolution, sizeof(double)));
  }
  state.time_resolution = time_resolution_;
  gpuErrchk(cudaMemcpy(state.GPU_self_spikes, &state.self_spikes, sizeof(int), cudaMemcpyHostToDevice));
  gpuErrchk(cudaMemcpy(state.GPU_time_resolution, &state.time_resolution, sizeof(double), cudaMemcpyHostToDevice));
}

void {{neuronName}}::set_status(HostNeuronState& state, const nlohmann::json& statusdict)
{
  if (statusdict.contains("V_th"))
  {
    state.V_th = statusdict["V_th"];
  }

  if (statusdict.contains("compartments"))
  {
    const nlohmann::json& compartments = statusdict["compartments"];
    if (compartments.is_array())
    {
      for (const auto& compartment : compartments)
      {
        add_compartment_(state, compartment);
      }
    }
    else
    {
      add_compartment_(state, compartments);
    }
  }

  if (statusdict.contains("receptors"))
  {
    const nlohmann::json& receptors = statusdict["receptors"];
    if (receptors.is_array())
    {
      for (const auto& receptor : receptors)
      {
        add_receptor_(state, receptor);
      }
    }
    else
    {
      add_receptor_(state, receptors);
    }
  }

  if (statusdict.contains("continuous_inputs"))
  {
    const nlohmann::json& continuous_inputs = statusdict["continuous_inputs"];
    if (continuous_inputs.is_array())
    {
      for (const auto& continuous_input : continuous_inputs)
      {
        add_continuous_input_(state, continuous_input);
      }
    }
    else
    {
      add_continuous_input_(state, continuous_inputs);
    }
  }
}

void {{neuronName}}::add_compartment_(HostNeuronState& state, const nlohmann::json& dd)
{
  const long parent_idx = dd["parent_idx"];
  if (dd.contains("params"))
  {
    state.c_tree.add_compartment(parent_idx, dd["params"]);
  }
  else
  {
    state.c_tree.add_compartment(parent_idx);
  }
}

void {{neuronName}}::add_receptor_(HostNeuronState& state, const nlohmann::json& dd)
{
  const long compartment_idx = dd["comp_idx"];
  const std::string receptor_type = dd["receptor_type"];

  const size_t syn_idx = state.syn_buffers.size();
  state.syn_buffers.push_back(0.0);

  if (dd.contains("params"))
  {
    state.c_tree.neuron_currents.add_mechanism(receptor_type, compartment_idx, dd["params"], syn_idx);
  }
  else
  {
    state.c_tree.neuron_currents.add_mechanism(receptor_type, compartment_idx, syn_idx);
  }
}

void {{neuronName}}::add_continuous_input_(HostNeuronState& state, const nlohmann::json& dd)
{
  const long compartment_idx = dd["comp_idx"];
  const std::string continuous_input_type = dd["continuous_input_type"];

  const size_t continuous_idx = state.syn_buffers.size();
  state.syn_buffers.push_back(0.0);

  if (dd.contains("params"))
  {
    state.c_tree.neuron_currents.add_mechanism(continuous_input_type, compartment_idx, dd["params"], continuous_idx);
  }
  else
  {
    state.c_tree.neuron_currents.add_mechanism(continuous_input_type, compartment_idx, continuous_idx);
  }
}

void {{neuronName}}::read_spikes(HostNeuronState& state, int i_neuron, size_t n_port_var)
{
  std::vector<float> host_values(n_port_var, 0.0);
  float* spike_values = port_input_arr_ + i_neuron * port_input_arr_step_;
  gpuErrchk(cudaMemcpy(host_values.data(), spike_values, n_port_var * sizeof(float), cudaMemcpyDeviceToHost));

  for (size_t i = 0; i < n_port_var && i < state.syn_buffers.size(); ++i)
  {
    if (host_values[i] != 0.0)
    {
      std::cout << "[{{neuronName}} debug] neuron=" << i_neuron
                << " receptor=" << i
                << " spike_arrival=1"
                << " value=" << host_values[i]
                << std::endl;
      state.syn_buffers[i] = host_values[i];
      host_values[i] = 0.0;
    }
  }

  gpuErrchk(cudaMemcpy(spike_values, host_values.data(), n_port_var * sizeof(float), cudaMemcpyHostToDevice));
}
