{
  ensure_runtime_layout_configured();
  try
  {
    return BaseNeuron::GetVarPt(i_neuron, var_name, port);
  }
  catch (...)
  {
  }

  std::string resolved_var_name = var_name;
  {%- for receptor_name, receptor_info in recs_info.items() %}
  {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
  {
    const std::string public_prefix = "{{convolution_info["kernel"]["name"]}}";
    const std::string internal_prefix = "__{{receptor_name}}_{{convolution}}";
