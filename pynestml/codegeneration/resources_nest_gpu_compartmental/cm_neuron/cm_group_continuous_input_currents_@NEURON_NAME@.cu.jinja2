void {{continuous_name}}{{cm_unique_suffix}}::calibrate(double time_resolution)
{
  if (neuron_{{ continuous_name }}_continuous_input_count == 0)
  {
    GPU_{{continuous_name}}_vars = nullptr;
    GPU_{{continuous_name}}_param = nullptr;
    return;
  }

  for(std::size_t i = 0; i < neuron_{{ continuous_name }}_continuous_input_count; i++){
    {%- if "time_resolution_var" in continuous_info %}
    double {{ printer_no_origin.print(continuous_info["time_resolution_var"]) }} = time_resolution;
    {%- endif %}

    {%- for ode_variable, ode_info in continuous_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
    {{ propagator }}[i] = {{ vector_printer.print(propagator_info["init_expression"], "i", continuous_info["non_vec_vars"]) }};
      {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in continuous_info["convolutions"].items() %}
    {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
    {{state_variable_name}}[i] = {{ vector_printer.print(state_variable_info["init_expression"], "i", continuous_info["non_vec_vars"]) }};
    {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in continuous_info["convolutions"].items() %}
    {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
    {{state_variable_name}}[i] = 0;
    {%- endfor %}
    {%- endfor %}

    {%- for internal_name, internal_declaration in continuous_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
    {{variable.name}}[i] = {{ vector_printer.print(internal_declaration["rhs_expression"], "i", continuous_info["non_vec_vars"]) }};
    {%- endfor %}
  }

  g_val = std::vector<double>(neuron_{{ continuous_name }}_continuous_input_count, 0);
  i_val = std::vector<double>(neuron_{{ continuous_name }}_continuous_input_count, 0);
  d_i_tot_dv = std::vector<double>(neuron_{{ continuous_name }}_continuous_input_count, 0);

  cudaMalloc(&GPU_{{continuous_name}}_vars, neuron_{{continuous_name}}_continuous_input_count * N_{{continuous_name}}_VARS * sizeof(double));
  if (N_{{continuous_name}}_PARAM > 0)
  {
    cudaMalloc(&GPU_{{continuous_name}}_param, neuron_{{continuous_name}}_continuous_input_count * N_{{continuous_name}}_PARAM * sizeof(double));
  }
  else
  {
    GPU_{{continuous_name}}_param = nullptr;
  }

  GPU_v_comp = GPU_{{continuous_name}}_vars + neuron_{{continuous_name}}_continuous_input_count * i_v_comp;
  GPU_i_tot_{{continuous_name}} = GPU_{{continuous_name}}_vars + neuron_{{continuous_name}}_continuous_input_count * i_i_tot_{{continuous_name}};
  GPU_g_val = GPU_{{continuous_name}}_vars + neuron_{{continuous_name}}_continuous_input_count * i_g_val;
  GPU_i_val = GPU_{{continuous_name}}_vars + neuron_{{continuous_name}}_continuous_input_count * i_i_val;
  GPU_d_i_tot_dv = GPU_{{continuous_name}}_vars + neuron_{{continuous_name}}_continuous_input_count * i_d_i_tot_dv;

    {%- for variable_name, variable_info in continuous_info["States"].items() %}
  GPU_{{ variable_name }} = GPU_{{continuous_name}}_vars + neuron_{{continuous_name}}_continuous_input_count * i_{{ variable_name }};
    {%- endfor %}

    {%- for ode_variable, ode_info in continuous_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
  GPU_{{ propagator }} = GPU_{{continuous_name}}_vars + neuron_{{continuous_name}}_continuous_input_count * i_{{ propagator }};
      {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in continuous_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  GPU_{{state_variable_name}} = GPU_{{continuous_name}}_vars + neuron_{{continuous_name}}_continuous_input_count * i_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in continuous_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  GPU_{{state_variable_name}} = GPU_{{continuous_name}}_vars + neuron_{{continuous_name}}_continuous_input_count * i_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    {%- for port_name, port_info in continuous_info["Continuous"].items() %}
  GPU_{{ port_name }} = GPU_{{continuous_name}}_vars + neuron_{{continuous_name}}_continuous_input_count * i_{{ port_name }};
    {%- endfor %}

    {%- for param_name, param_declaration in continuous_info["Parameters"].items() %}
  GPU_{{param_name}} = GPU_{{continuous_name}}_param + neuron_{{continuous_name}}_continuous_input_count * i_{{param_name}};
    {%- endfor %}

    {%- for internal_name, internal_declaration in continuous_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
  GPU_{{variable.name}} = GPU_{{continuous_name}}_param + neuron_{{continuous_name}}_continuous_input_count * i_{{variable.name}};
    {%- endfor %}

  cudaMemcpy(GPU_i_tot_{{continuous_name}}, i_tot_{{continuous_name}}.data(), neuron_{{continuous_name}}_continuous_input_count*sizeof(double), cudaMemcpyHostToDevice);
  cudaMemcpy(GPU_g_val, g_val.data(), neuron_{{continuous_name}}_continuous_input_count*sizeof(double), cudaMemcpyHostToDevice);
  cudaMemcpy(GPU_i_val, i_val.data(), neuron_{{continuous_name}}_continuous_input_count*sizeof(double), cudaMemcpyHostToDevice);
  cudaMemcpy(GPU_d_i_tot_dv, d_i_tot_dv.data(), neuron_{{continuous_name}}_continuous_input_count*sizeof(double), cudaMemcpyHostToDevice);

    {%- for variable_name, variable_info in continuous_info["States"].items() %}
  cudaMemcpy(GPU_{{ variable_name }}, {{ variable_name }}.data(), neuron_{{continuous_name}}_continuous_input_count*sizeof(double), cudaMemcpyHostToDevice);
    {%- endfor %}

    {%- for ode_variable, ode_info in continuous_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
  cudaMemcpy(GPU_{{propagator}}, {{propagator}}.data(), neuron_{{continuous_name}}_continuous_input_count*sizeof(double), cudaMemcpyHostToDevice);
      {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in continuous_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  cudaMemcpy(GPU_{{state_variable_name}}, {{state_variable_name}}.data(), neuron_{{continuous_name}}_continuous_input_count*sizeof(double), cudaMemcpyHostToDevice);
        {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in continuous_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  cudaMemcpy(GPU_{{state_variable_name}}, {{state_variable_name}}.data(), neuron_{{continuous_name}}_continuous_input_count*sizeof(double), cudaMemcpyHostToDevice);
        {%- endfor %}
    {%- endfor %}

    {%- for port_name, port_info in continuous_info["Continuous"].items() %}
  cudaMemcpy(GPU_{{ port_name }}, {{ port_name }}.data(), neuron_{{continuous_name}}_continuous_input_count*sizeof(double), cudaMemcpyHostToDevice);
    {%- endfor %}

    {%- for param_name, param_declaration in continuous_info["Parameters"].items() %}
  cudaMemcpy(GPU_{{param_name}}, {{param_name}}.data(), neuron_{{continuous_name}}_continuous_input_count*sizeof(double), cudaMemcpyHostToDevice);
    {%- endfor %}

    {%- for internal_name, internal_declaration in continuous_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
  cudaMemcpy(GPU_{{variable.name}}, {{variable.name}}.data(), neuron_{{continuous_name}}_continuous_input_count*sizeof(double), cudaMemcpyHostToDevice);
    {%- endfor %}
}

struct {{continuous_name}}{{cm_unique_suffix}}Device
{
  double* y;
  double* param;
  int* global_self_spikes;
  double* global_time_resolution;
  std::size_t neuron_{{continuous_name}}_continuous_input_count;

{%- for function in continuous_info["Functions"] %}
  {{ device_function_declaration.DeviceFunctionDeclaration(function, function.get_name()) }}
  {
  {%-   filter indent(4,True) %}
  {%-   with ast = function.get_stmts_body() %}
  {%-     set printer = printer_no_origin %}
  {%-     include "directives_cpp/StmtsBody.jinja2" %}
  {%-   endwith %}
  {%-   endfilter %}
  }
{%- endfor %}

  __device__ __forceinline__
  void update(std::size_t i) const
  {
      const double self_spikes = static_cast<double>(global_self_spikes[0]);
      {%- if "time_resolution_var" in continuous_info %}
      double {{ printer_no_origin.print(continuous_info["time_resolution_var"]) }} = global_time_resolution[0];
      {%- endif %}

      {%- for ode_variable, ode_info in continuous_info["ODEs"].items() %}
          {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
      y[i_{{ propagator }}+i] = {{ cuda_printer.print(propagator_info["init_expression"], "i", black_list=["self_spikes"]) }};
          {%- endfor %}
          {%- for state, state_solution_info in ode_info["transformed_solutions"][0]["states"].items() %}
      y[i_{{state}}+i] = {{ cuda_printer.print(state_solution_info["update_expression"], "i", black_list=["self_spikes"]) }};
          {%- endfor %}
      {%- endfor %}

      {%- for convolution, convolution_info in continuous_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items() %}
      y[i_{{state_variable_name}}+i] = {{ cuda_printer.print(state_variable_info["update_expression"], "i", black_list=["self_spikes"]) }};
      y[i_{{state_variable_name}}+i] += self_spikes * {{ cuda_printer.print(state_variable_info["init_expression"], "i", black_list=["self_spikes"]) }};
      {%- endfor %}
      {%- endfor %}

      y[i_i_tot_{{continuous_name}}+i] = {{ cuda_printer.print(continuous_info["root_expression"], "i", black_list=["self_spikes"]) }};
      y[i_d_i_tot_dv+i] = {{ cuda_printer.print(continuous_info["inline_derivative"], "i", black_list=["self_spikes"]) }};
      y[i_g_val+i] = - y[i_d_i_tot_dv+i];
      y[i_i_val+i] = y[i_i_tot_{{continuous_name}}+i] - y[i_d_i_tot_dv+i] * y[i_v_comp+i];
  }

  __device__ __forceinline__
  void update_block(std::size_t i) const
  {
      const double self_spikes = static_cast<double>(global_self_spikes[0]);
      double __resolution = global_time_resolution[0];
    {%- if continuous_info["Blocks"] and continuous_info["Blocks"]["UpdateBlock"] and continuous_info["Blocks"]["UpdateBlock"].get_stmts_body().get_stmts()|length %}
      {%- set function = continuous_info["Blocks"]["UpdateBlock"] %}
      {%- filter indent(4, True) %}
      {%- with ast = function.get_stmts_body() %}
      {%- set printer = cuda_printer.printer("i", black_list=["self_spikes"]) %}
      {%-     include "cm_directives_cpp/StmtsBody.jinja2" %}
      {%- endwith %}
      {%- endfilter %}
    {%- endif %}
  }

  __device__ __forceinline__
  void self_spike_block(std::size_t i) const
  {
      const double self_spikes = static_cast<double>(global_self_spikes[0]);
      double __resolution = global_time_resolution[0];
    {%- if continuous_info["Blocks"] and continuous_info["Blocks"]["SelfSpikesFunction"] and continuous_info["Blocks"]["SelfSpikesFunction"].get_stmts_body().get_stmts()|length %}
      {%- set function = continuous_info["Blocks"]["SelfSpikesFunction"] %}
      {%- filter indent(4, True) %}
      {%- with ast = function.get_stmts_body() %}
      {%- set printer = cuda_printer.printer("i", black_list=["self_spikes"]) %}
      {%-     include "cm_directives_cpp/StmtsBody.jinja2" %}
      {%- endwith %}
      {%- endfilter %}
    {%- endif %}
  }
};

__global__
void {{continuous_name}}_device_update({{continuous_name}}{{cm_unique_suffix}}Device device)
{
  std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < device.neuron_{{continuous_name}}_continuous_input_count)
  {
      device.update(i);
  }
}

__global__
void {{continuous_name}}_device_update_block({{continuous_name}}{{cm_unique_suffix}}Device device)
{
  std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < device.neuron_{{continuous_name}}_continuous_input_count)
  {
      device.update_block(i);
  }
}

__global__
void {{continuous_name}}_device_self_spike_block({{continuous_name}}{{cm_unique_suffix}}Device device)
{
  std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < device.neuron_{{continuous_name}}_continuous_input_count && device.global_self_spikes[0])
  {
      device.self_spike_block(i);
  }
}

void {{continuous_name}}{{cm_unique_suffix}}::f_update()
{
  {%- if not (continuous_info["Blocks"] and continuous_info["Blocks"]["UpdateBlock"] and continuous_info["Blocks"]["UpdateBlock"].get_stmts_body().get_stmts()|length) %}
  return;
  {%- else %}
  if (neuron_{{ continuous_name }}_continuous_input_count == 0)
  {
    return;
  }
  const int threads_per_block = 256;
  const int blocks = (neuron_{{continuous_name}}_continuous_input_count + threads_per_block - 1) / threads_per_block;
  {{continuous_name}}{{cm_unique_suffix}}Device device{GPU_{{continuous_name}}_vars, GPU_{{continuous_name}}_param, GPU_self_spikes, GPU_time_resolution, neuron_{{continuous_name}}_continuous_input_count};
  {{continuous_name}}_device_update_block<<<blocks, threads_per_block>>>(device);
  {%- endif %}
}

void {{continuous_name}}{{cm_unique_suffix}}::f_self_spike()
{
  {%- if not (continuous_info["Blocks"] and continuous_info["Blocks"]["SelfSpikesFunction"] and continuous_info["Blocks"]["SelfSpikesFunction"].get_stmts_body().get_stmts()|length) %}
  return;
  {%- else %}
  if (neuron_{{ continuous_name }}_continuous_input_count == 0)
  {
    return;
  }
  const int threads_per_block = 256;
  const int blocks = (neuron_{{continuous_name}}_continuous_input_count + threads_per_block - 1) / threads_per_block;
  {{continuous_name}}{{cm_unique_suffix}}Device device{GPU_{{continuous_name}}_vars, GPU_{{continuous_name}}_param, GPU_self_spikes, GPU_time_resolution, neuron_{{continuous_name}}_continuous_input_count};
  {{continuous_name}}_device_self_spike_block<<<blocks, threads_per_block>>>(device);
  {%- endif %}
}

