{
  if (neuron_{{ ion_channel_name }}_channel_count == 0)
  {
    return;
  }
  const int threads_per_block = 256;
  const std::size_t total_count = population_neuron_count * neuron_{{ion_channel_name}}_channel_count;
  const int blocks = (total_count + threads_per_block - 1) / threads_per_block;
  {{ion_channel_name}}{{cm_unique_suffix}}Device device{GPU_{{ion_channel_name}}_vars, GPU_{{ion_channel_name}}_param, GPU_population_vars, GPU_compartment_association, GPU_self_spikes, GPU_time_resolution, mechanism_stride, population_n_var, population_n_param, population_compartment_count, population_voltage_base_index, total_count{% for ode in channel_info["Dependencies"]["concentrations"] %}, nullptr{% endfor %}{% for inline in channel_info["Dependencies"]["receptors"] %}, nullptr{% endfor %}{% for inline in channel_info["Dependencies"]["channels"] %}, nullptr{% endfor %}{% for inline in channel_info["Dependencies"]["continuous"] %}, nullptr{% endfor %}};
