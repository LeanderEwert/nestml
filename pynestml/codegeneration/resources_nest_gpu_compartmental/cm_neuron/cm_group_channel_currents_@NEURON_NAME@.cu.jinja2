    value = static_cast<float>({{propagator}}[chan_id]);
    cudaMemcpy(GPU_{{propagator}} + chan_id, &value, sizeof(float), cudaMemcpyHostToDevice);
      {% endfor -%}
    {% endfor -%}

    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
    value = static_cast<float>({{state_variable_name}}[chan_id]);
    cudaMemcpy(GPU_{{state_variable_name}} + chan_id, &value, sizeof(float), cudaMemcpyHostToDevice);
      {% endfor -%}
    {% endfor -%}

    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
    value = static_cast<float>({{state_variable_name}}[chan_id]);
    cudaMemcpy(GPU_{{state_variable_name}} + chan_id, &value, sizeof(float), cudaMemcpyHostToDevice);
      {% endfor -%}
    {% endfor -%}

    {%- for param_name, param_declaration in channel_info["Parameters"].items() %}
    value = static_cast<float>({{param_name}}[chan_id]);
    cudaMemcpy(GPU_{{param_name}} + chan_id, &value, sizeof(float), cudaMemcpyHostToDevice);
    {% endfor -%}

    {%- for internal_name, internal_declaration in channel_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
    value = static_cast<float>({{variable.name}}[chan_id]);
    cudaMemcpy(GPU_{{variable.name}} + chan_id, &value, sizeof(float), cudaMemcpyHostToDevice);
    {% endfor -%}
  }
}

struct {{ion_channel_name}}{{cm_unique_suffix}}Device
{
  static constexpr int i_v_comp = i_{{ ion_channel_name }}_v_comp;
  static constexpr int i_g_val = i_{{ ion_channel_name }}_g_val;
  static constexpr int i_i_val = i_{{ ion_channel_name }}_i_val;
  static constexpr int i_d_i_tot_dv = i_{{ ion_channel_name }}_d_i_tot_dv;

  float* y;
  float* param;
  int* compartment_association;
  int* global_self_spikes;
  double* global_time_resolution;
  int recordable_max;
  std::size_t neuron_{{ion_channel_name}}_channel_count;
  {%- for ode in channel_info["Dependencies"]["concentrations"] %}
  float* dep_{{ode.lhs.name}};
  {%- endfor %}
  {%- for inline in channel_info["Dependencies"]["receptors"] %}
  float* dep_{{inline.variable_name}};
  {%- endfor %}
  {%- for inline in channel_info["Dependencies"]["channels"] %}
  float* dep_{{inline.variable_name}};
  {%- endfor %}
  {%- for inline in channel_info["Dependencies"]["continuous"] %}
  float* dep_{{inline.variable_name}};
  {%- endfor %}

{%- set device_black_list = namespace(names=["self_spikes"]) %}
{%- if "time_resolution_var" in channel_info %}
{%- set device_black_list.names = device_black_list.names + [printer_no_origin.print(channel_info["time_resolution_var"])] %}
{%- endif %}
{%- for ode in channel_info["Dependencies"]["concentrations"] %}
{%- set device_black_list.names = device_black_list.names + [ode.lhs.name] %}
{%- endfor %}
{%- for inline in channel_info["Dependencies"]["receptors"] %}
{%- set device_black_list.names = device_black_list.names + [inline.variable_name] %}
{%- endfor %}
{%- for inline in channel_info["Dependencies"]["channels"] %}
{%- set device_black_list.names = device_black_list.names + [inline.variable_name] %}
{%- endfor %}
{%- for inline in channel_info["Dependencies"]["continuous"] %}
{%- set device_black_list.names = device_black_list.names + [inline.variable_name] %}
{%- endfor %}
{%- for replacement, expression in channel_info["cse_function_replacements"].items() %}
{%- set device_black_list.names = device_black_list.names + [replacement] %}
{%- endfor %}
{%- for replacement, expression in channel_info["cse_body_replacements"].items() %}
{%- set device_black_list.names = device_black_list.names + [replacement] %}
{%- endfor %}

{%- for function in channel_info["Functions"] %}
  {{ device_function_declaration.DeviceFunctionDeclaration(function, function.get_name()) }}
  {
  {%-   filter indent(4,True) %}
  {%-   with ast = function.get_stmts_body() %}
  {%-     set printer = printer_no_origin %}
  {%-     include "directives_cpp/StmtsBody.jinja2" %}
  {%-   endwith %}
  {%-   endfilter %}
  }
{%- endfor %}

  __device__ __forceinline__
  void update(std::size_t i) const
  {
      const int slot = static_cast<int>(i);
      const double self_spikes = static_cast<double>(global_self_spikes[0]);
      const int comp = compartment_association[slot];
      {%- if "time_resolution_var" in channel_info %}
      double {{ printer_no_origin.print(channel_info["time_resolution_var"]) }} = global_time_resolution[0];
      {%- endif %}
      {%- for ode in channel_info["Dependencies"]["concentrations"] %}
      const double {{ode.lhs.name}} = dep_{{ode.lhs.name}} == nullptr ? 0.0 : dep_{{ode.lhs.name}}[comp];
      {%- endfor %}
      {%- for inline in channel_info["Dependencies"]["receptors"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for inline in channel_info["Dependencies"]["channels"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for inline in channel_info["Dependencies"]["continuous"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for replacement, expression in channel_info["cse_function_replacements"].items() %}
      const double {{ replacement }} = {{ cuda_printer.print(expression, "slot", black_list=device_black_list.names, stride="recordable_max") }};
      {%- endfor %}
      {%- for replacement, expression in channel_info["cse_body_replacements"].items() %}
      const double {{ replacement }} = {{ cuda_printer.print(expression, "slot", black_list=device_black_list.names, stride="recordable_max") }};
      {%- endfor %}
      {%- for ode_variable, ode_info in channel_info["ODEs"].items() %}
          {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
      y[i_{{ propagator }}*recordable_max+slot] = {{ cuda_printer.print(propagator_info["init_expression"], "slot", black_list=device_black_list.names, stride="recordable_max") }};
          {%- endfor %}
          {%- for state, state_solution_info in ode_info["transformed_solutions"][0]["states"].items() %}
      y[i_{{state}}*recordable_max+slot] = {{ cuda_printer.print(state_solution_info["update_expression"], "slot", black_list=device_black_list.names, stride="recordable_max") }};
          {%- endfor %}
      {%- endfor %}

      {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items() %}
      y[i_{{state_variable_name}}*recordable_max+slot] = {{ cuda_printer.print(state_variable_info["update_expression"], "slot", black_list=device_black_list.names, stride="recordable_max") }};
      {%- endfor %}
      {%- endfor %}

      y[i_i_tot_{{ion_channel_name}}*recordable_max+slot] = {{ cuda_printer.print(channel_info["root_expression"], "slot", black_list=device_black_list.names, stride="recordable_max") }};
      y[i_d_i_tot_dv*recordable_max+slot] = {{ cuda_printer.print(channel_info["inline_derivative"], "slot", black_list=device_black_list.names, stride="recordable_max") }};
      y[i_g_val*recordable_max+slot] = - y[i_d_i_tot_dv*recordable_max+slot];
      y[i_i_val*recordable_max+slot] = y[i_i_tot_{{ion_channel_name}}*recordable_max+slot] - y[i_d_i_tot_dv*recordable_max+slot] * y[i_v_comp*recordable_max+slot];
  }
};

__global__
void {{ion_channel_name}}_device_update({{ion_channel_name}}{{cm_unique_suffix}}Device device)
{
  std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < device.neuron_{{ion_channel_name}}_channel_count)
  {
      device.update(i);
  }
}

__global__
void {{ion_channel_name}}_copy_compartment_voltage_kernel(const float* shared_v_comp,
                                                          const int* compartment_association,
                                                          float* mechanism_v_comp,
                                                          std::size_t mechanism_count)
{
  const std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < mechanism_count)
  {
    mechanism_v_comp[i] = shared_v_comp[compartment_association[i]];
  }
}

__global__
void {{ion_channel_name}}_aggregate_currents_kernel(const float* mechanism_g,
                                                    const float* mechanism_i,
                                                    const int* compartment_association,
                                                    float* compartment_g,
                                                    float* compartment_i,
                                                    int compartment_count,
                                                    std::size_t mechanism_count)
{
  const std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < mechanism_count)
  {
    const int compartment = compartment_association[i];
    if (compartment >= 0 && compartment < compartment_count)
    {
      atomicAdd(compartment_g + compartment, mechanism_g[i]);
      atomicAdd(compartment_i + compartment, mechanism_i[i]);
    }
  }
}

__global__
void {{ion_channel_name}}_aggregate_total_current_kernel(const float* mechanism_current,
                                                        const int* compartment_association,
                                                        float* compartment_current,
                                                        int compartment_count,
                                                        std::size_t mechanism_count)
{
  const std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < mechanism_count)
  {
    const int compartment = compartment_association[i];
    if (compartment >= 0 && compartment < compartment_count)
    {
      atomicAdd(compartment_current + compartment, mechanism_current[i]);
    }
  }
}

std::pair< std::vector< double >, std::vector< double > > {{ion_channel_name}}{{cm_unique_suffix}}::f_numstep(std::vector< double > v_comp {% for ode in channel_info["Dependencies"]["concentrations"] %}, std::vector< double > {{ode.lhs.name}}{% endfor %}{% if channel_info["Dependencies"]["receptors"]|length %}
                        {% endif %}{% for inline in channel_info["Dependencies"]["receptors"] %}, std::vector< double > {{inline.variable_name}}{% endfor %}{% if channel_info["Dependencies"]["channels"]|length %}
                        {% endif %}{% for inline in channel_info["Dependencies"]["channels"] %}, std::vector< double > {{inline.variable_name}}{% endfor %}{% if channel_info["Dependencies"]["continuous"]|length %}
                        {% endif %}{% for inline in channel_info["Dependencies"]["continuous"] %}, std::vector< double > {{inline.variable_name}}{% endfor %})
{
  if (neuron_{{ ion_channel_name }}_channel_count == 0)
  {
    return std::make_pair(g_val, i_val);
  }

  for(std::size_t chan_id = 0; chan_id < neuron_{{ ion_channel_name }}_channel_count; chan_id++){
