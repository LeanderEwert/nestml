        {{ variable.name}}.push_back({{ vector_printer.print(rhs_expression, "neuron_"+ion_channel_name+"_channel_count-1", channel_info["non_vec_vars"]) -}});
        if(channel_params.contains("{{variable.name}}"))
            {{variable.name}}[neuron_{{ ion_channel_name }}_channel_count-1] = channel_params.at("{{variable.name}}").get<double>();
