void {{ion_channel_name}}{{cm_unique_suffix}}::pre_run_hook(double time_resolution)
{%- endif %}
{
  if (neuron_{{ ion_channel_name }}_channel_count == 0)
  {
    return;
  }
  if (GPU_{{ion_channel_name}}_vars == nullptr)
  {
    throw std::runtime_error("{{ion_channel_name}} base variable array was not initialized before pre_run_hook()");
  }
  if (N_{{ion_channel_name}}_PARAM > 0 && GPU_{{ion_channel_name}}_param == nullptr)
  {
    throw std::runtime_error("{{ion_channel_name}} base parameter array was not initialized before pre_run_hook()");
  }

  cudaMalloc(&GPU_compartment_association, neuron_{{ion_channel_name}}_channel_count * sizeof(int));
  std::vector<int> compartment_association_int(compartment_association.begin(), compartment_association.end());
  cudaMemcpy(GPU_compartment_association,
             compartment_association_int.data(),
             neuron_{{ion_channel_name}}_channel_count * sizeof(int),
             cudaMemcpyHostToDevice);

  for(std::size_t i = 0; i < neuron_{{ ion_channel_name }}_channel_count; i++){
    {%- if "time_resolution_var" in channel_info %}
    double {{ printer_no_origin.print(channel_info["time_resolution_var"]) }} = time_resolution;
    {%- endif %}
    {%- for ode_variable, ode_info in channel_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
    {{ propagator }}[i] = {{ vector_printer.print(propagator_info["init_expression"], "i", channel_info["non_vec_vars"]) }};
      {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
    {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
    {{state_variable_name}}[i] = {{ vector_printer.print(state_variable_info["init_expression"], "i", channel_info["non_vec_vars"]) }};
    {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
    {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
    {{state_variable_name}}[i] = 0;
    {%- endfor %}
    {%- endfor %}
  }

  g_val = std::vector<double>(neuron_{{ ion_channel_name }}_channel_count, 0);
  i_val = std::vector<double>(neuron_{{ ion_channel_name }}_channel_count, 0);
  d_i_tot_dv = std::vector<double>(neuron_{{ ion_channel_name }}_channel_count, 0);

  GPU_v_comp = GPU_{{ion_channel_name}}_vars + recordable_max * i_v_comp;
  GPU_i_tot_{{ion_channel_name}} = GPU_{{ion_channel_name}}_vars + recordable_max * i_i_tot_{{ion_channel_name}};
  GPU_g_val = GPU_{{ion_channel_name}}_vars + recordable_max * i_g_val;
  GPU_i_val = GPU_{{ion_channel_name}}_vars + recordable_max * i_i_val;
  GPU_d_i_tot_dv = GPU_{{ion_channel_name}}_vars + recordable_max * i_d_i_tot_dv;

    {%- for variable_name, variable_info in channel_info["States"].items() %}
  GPU_{{ variable_name }} = GPU_{{ion_channel_name}}_vars + recordable_max * i_{{ variable_name }};
    {%- endfor %}

    {%- for ode_variable, ode_info in channel_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
  GPU_{{ propagator }} = GPU_{{ion_channel_name}}_vars + recordable_max * i_{{ propagator }};
      {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  GPU_{{state_variable_name}} = GPU_{{ion_channel_name}}_vars + recordable_max * i_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  GPU_{{state_variable_name}} = GPU_{{ion_channel_name}}_vars + recordable_max * i_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    {%- for param_name, param_declaration in channel_info["Parameters"].items() %}
  GPU_{{param_name}} = GPU_{{ion_channel_name}}_param + recordable_max * i_{{param_name}};
    {%- endfor %}

    {%- for internal_name, internal_declaration in channel_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
  GPU_{{variable.name}} = GPU_{{ion_channel_name}}_param + recordable_max * i_{{variable.name}};
    {%- endfor %}

  for(std::size_t chan_id = 0; chan_id < neuron_{{ ion_channel_name }}_channel_count; chan_id++){
    float value = static_cast<float>(i_tot_{{ion_channel_name}}[chan_id]);
    cudaMemcpy(GPU_i_tot_{{ion_channel_name}} + chan_id, &value, sizeof(float), cudaMemcpyHostToDevice);
    value = static_cast<float>(g_val[chan_id]);
    cudaMemcpy(GPU_g_val + chan_id, &value, sizeof(float), cudaMemcpyHostToDevice);
    value = static_cast<float>(i_val[chan_id]);
    cudaMemcpy(GPU_i_val + chan_id, &value, sizeof(float), cudaMemcpyHostToDevice);
    value = static_cast<float>(d_i_tot_dv[chan_id]);
    cudaMemcpy(GPU_d_i_tot_dv + chan_id, &value, sizeof(float), cudaMemcpyHostToDevice);

    {%- for variable_name, variable_info in channel_info["States"].items() %}
    value = static_cast<float>({{ variable_name }}[chan_id]);
    cudaMemcpy(GPU_{{ variable_name }} + chan_id, &value, sizeof(float), cudaMemcpyHostToDevice);
    {% endfor -%}

    {%- for ode_variable, ode_info in channel_info["ODEs"].items() %}
