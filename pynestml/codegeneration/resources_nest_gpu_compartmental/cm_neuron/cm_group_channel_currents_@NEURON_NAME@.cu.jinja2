void {{ion_channel_name}}{{cm_unique_suffix}}::calibrate(double time_resolution)
{
  if (neuron_{{ ion_channel_name }}_channel_count == 0)
  {
    return;
  }
  if (GPU_{{ion_channel_name}}_vars == nullptr)
  {
    throw std::runtime_error("{{ion_channel_name}} base variable array was not initialized before calibrate()");
  }
  if (N_{{ion_channel_name}}_PARAM > 0 && GPU_{{ion_channel_name}}_param == nullptr)
  {
    throw std::runtime_error("{{ion_channel_name}} base parameter array was not initialized before calibrate()");
  }

  for(std::size_t i = 0; i < neuron_{{ ion_channel_name }}_channel_count; i++){
    {%- if "time_resolution_var" in channel_info %}
    double {{ printer_no_origin.print(channel_info["time_resolution_var"]) }} = time_resolution;
    {%- endif %}
    {%- for ode_variable, ode_info in channel_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
    {{ propagator }}[i] = 0;
      {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
    {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
    {{state_variable_name}}[i] = 0;
    {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
    {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
    {{state_variable_name}}[i] = 0;
    {%- endfor %}
    {%- endfor %}
  }

  g_val = std::vector<double>(neuron_{{ ion_channel_name }}_channel_count, 0);
  i_val = std::vector<double>(neuron_{{ ion_channel_name }}_channel_count, 0);
  d_i_tot_dv = std::vector<double>(neuron_{{ ion_channel_name }}_channel_count, 0);

  GPU_v_comp = GPU_{{ion_channel_name}}_vars + mechanism_stride * i_v_comp;
  GPU_i_tot_{{ion_channel_name}} = GPU_{{ion_channel_name}}_vars + mechanism_stride * i_i_tot_{{ion_channel_name}};
  GPU_g_val = GPU_{{ion_channel_name}}_vars + mechanism_stride * i_g_val;
  GPU_i_val = GPU_{{ion_channel_name}}_vars + mechanism_stride * i_i_val;
  GPU_d_i_tot_dv = GPU_{{ion_channel_name}}_vars + mechanism_stride * i_d_i_tot_dv;

    {%- for variable_name, variable_info in channel_info["States"].items() %}
  GPU_{{ variable_name }} = GPU_{{ion_channel_name}}_vars + mechanism_stride * i_{{ variable_name }};
    {%- endfor %}

    {%- for ode_variable, ode_info in channel_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
  GPU_{{ propagator }} = GPU_{{ion_channel_name}}_vars + mechanism_stride * i_{{ propagator }};
      {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  GPU_{{state_variable_name}} = GPU_{{ion_channel_name}}_vars + mechanism_stride * i_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  GPU_{{state_variable_name}} = GPU_{{ion_channel_name}}_vars + mechanism_stride * i_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    {%- for param_name, param_declaration in channel_info["Parameters"].items() %}
  GPU_{{param_name}} = GPU_{{ion_channel_name}}_param + mechanism_stride * i_{{param_name}};
    {%- endfor %}

    {%- for internal_name, internal_declaration in channel_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
  GPU_{{variable.name}} = GPU_{{ion_channel_name}}_param + mechanism_stride * i_{{variable.name}};
    {%- endfor %}

  for(std::size_t chan_id = 0; chan_id < neuron_{{ ion_channel_name }}_channel_count; chan_id++){
    const int slot = static_cast<int>(chan_id);
    float value = static_cast<float>(i_tot_{{ion_channel_name}}[chan_id]);
    cudaMemcpy(GPU_i_tot_{{ion_channel_name}} + slot, &value, sizeof(float), cudaMemcpyHostToDevice);
    value = static_cast<float>(g_val[chan_id]);
    cudaMemcpy(GPU_g_val + slot, &value, sizeof(float), cudaMemcpyHostToDevice);
    value = static_cast<float>(i_val[chan_id]);
    cudaMemcpy(GPU_i_val + slot, &value, sizeof(float), cudaMemcpyHostToDevice);
    value = static_cast<float>(d_i_tot_dv[chan_id]);
    cudaMemcpy(GPU_d_i_tot_dv + slot, &value, sizeof(float), cudaMemcpyHostToDevice);

    {%- for variable_name, variable_info in channel_info["States"].items() %}
    value = static_cast<float>({{ variable_name }}[chan_id]);
    cudaMemcpy(GPU_{{ variable_name }} + slot, &value, sizeof(float), cudaMemcpyHostToDevice);
    {% endfor -%}

    {%- for ode_variable, ode_info in channel_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
    value = static_cast<float>({{propagator}}[chan_id]);
    cudaMemcpy(GPU_{{propagator}} + slot, &value, sizeof(float), cudaMemcpyHostToDevice);
      {% endfor -%}
    {% endfor -%}

    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
    value = static_cast<float>({{state_variable_name}}[chan_id]);
    cudaMemcpy(GPU_{{state_variable_name}} + slot, &value, sizeof(float), cudaMemcpyHostToDevice);
      {% endfor -%}
    {% endfor -%}

    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
    value = static_cast<float>({{state_variable_name}}[chan_id]);
    cudaMemcpy(GPU_{{state_variable_name}} + slot, &value, sizeof(float), cudaMemcpyHostToDevice);
      {% endfor -%}
    {% endfor -%}

    {%- for param_name, param_declaration in channel_info["Parameters"].items() %}
    value = static_cast<float>({{param_name}}[chan_id]);
    cudaMemcpy(GPU_{{param_name}} + slot, &value, sizeof(float), cudaMemcpyHostToDevice);
    {% endfor -%}

    {%- for internal_name, internal_declaration in channel_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
    value = static_cast<float>({{variable.name}}[chan_id]);
    cudaMemcpy(GPU_{{variable.name}} + slot, &value, sizeof(float), cudaMemcpyHostToDevice);
    {% endfor -%}
  }
}

struct {{ion_channel_name}}{{cm_unique_suffix}}Device
{
  static constexpr int i_v_comp = i_{{ ion_channel_name }}_v_comp;
  static constexpr int i_g_val = i_{{ ion_channel_name }}_g_val;
  static constexpr int i_i_val = i_{{ ion_channel_name }}_i_val;
  static constexpr int i_d_i_tot_dv = i_{{ ion_channel_name }}_d_i_tot_dv;

  float* y;
  float* param;
  float* population_vars;
  int* compartment_association;
  int* global_self_spikes;
  double* global_time_resolution;
  int mechanism_stride;
  int population_n_var;
  int population_n_param;
  int population_compartment_count;
  int population_voltage_base_index;
  std::size_t total_mechanism_count;
  {%- for ode in channel_info["Dependencies"]["concentrations"] %}
  float* dep_{{ode.lhs.name}};
  {%- endfor %}
  {%- for inline in channel_info["Dependencies"]["receptors"] %}
  float* dep_{{inline.variable_name}};
  {%- endfor %}
  {%- for inline in channel_info["Dependencies"]["channels"] %}
  float* dep_{{inline.variable_name}};
  {%- endfor %}
  {%- for inline in channel_info["Dependencies"]["continuous"] %}
  float* dep_{{inline.variable_name}};
  {%- endfor %}

{%- set device_black_list = namespace(names=["self_spikes"]) %}
{%- if "time_resolution_var" in channel_info %}
{%- set device_black_list.names = device_black_list.names + [printer_no_origin.print(channel_info["time_resolution_var"])] %}
{%- endif %}
{%- for ode in channel_info["Dependencies"]["concentrations"] %}
{%- set device_black_list.names = device_black_list.names + [ode.lhs.name] %}
{%- endfor %}
{%- for inline in channel_info["Dependencies"]["receptors"] %}
{%- set device_black_list.names = device_black_list.names + [inline.variable_name] %}
{%- endfor %}
{%- for inline in channel_info["Dependencies"]["channels"] %}
{%- set device_black_list.names = device_black_list.names + [inline.variable_name] %}
{%- endfor %}
{%- for inline in channel_info["Dependencies"]["continuous"] %}
{%- set device_black_list.names = device_black_list.names + [inline.variable_name] %}
{%- endfor %}
{%- for replacement, expression in channel_info["cse_function_replacements"].items() %}
{%- set device_black_list.names = device_black_list.names + [replacement] %}
{%- endfor %}
{%- for replacement, expression in channel_info["cse_body_replacements"].items() %}
{%- set device_black_list.names = device_black_list.names + [replacement] %}
{%- endfor %}

{%- for function in channel_info["Functions"] %}
  {{ device_function_declaration.DeviceFunctionDeclaration(function, function.get_name()) }}
  {
  {%-   filter indent(4,True) %}
  {%-   with ast = function.get_stmts_body() %}
  {%-     set printer = printer_no_origin %}
  {%-     include "directives_cpp/StmtsBody.jinja2" %}
  {%-   endwith %}
  {%-   endfilter %}
  }
{%- endfor %}

  __device__ __forceinline__
  void update(std::size_t i) const
  {
      const int i_neuron = static_cast<int>(i) / mechanism_stride;
      const int slot = static_cast<int>(i) % mechanism_stride;
      float* y = this->y + i_neuron * population_n_var;
      float* param = this->param == nullptr ? nullptr : this->param + i_neuron * population_n_param;
      const int comp = compartment_association[i];
      const int local_comp = comp - i_neuron * population_compartment_count;
      const double self_spikes = static_cast<double>(global_self_spikes[i_neuron]);
      const int voltage_index =
        i_neuron * population_n_var + population_voltage_base_index + local_comp;
      y[i_v_comp*mechanism_stride+slot] = population_vars[voltage_index];
      {%- if "time_resolution_var" in channel_info %}
      double {{ printer_no_origin.print(channel_info["time_resolution_var"]) }} = global_time_resolution[0];
      {%- endif %}
      {%- for ode in channel_info["Dependencies"]["concentrations"] %}
      const double {{ode.lhs.name}} = dep_{{ode.lhs.name}} == nullptr ? 0.0 : dep_{{ode.lhs.name}}[comp];
      {%- endfor %}
      {%- for inline in channel_info["Dependencies"]["receptors"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for inline in channel_info["Dependencies"]["channels"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for inline in channel_info["Dependencies"]["continuous"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for replacement, expression in channel_info["cse_function_replacements"].items() %}
      const double {{ replacement }} = {{ cuda_printer.print(expression, "slot", black_list=device_black_list.names, stride="mechanism_stride") }};
      {%- endfor %}
      {%- for replacement, expression in channel_info["cse_body_replacements"].items() %}
      const double {{ replacement }} = {{ cuda_printer.print(expression, "slot", black_list=device_black_list.names, stride="mechanism_stride") }};
      {%- endfor %}
      {%- for ode_variable, ode_info in channel_info["ODEs"].items() %}
          {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
      y[i_{{ propagator }}*mechanism_stride+slot] = {{ cuda_printer.print(propagator_info["init_expression"], "slot", black_list=device_black_list.names, stride="mechanism_stride") }};
          {%- endfor %}
          {%- for state, state_solution_info in ode_info["transformed_solutions"][0]["states"].items() %}
      y[i_{{state}}*mechanism_stride+slot] = {{ cuda_printer.print(state_solution_info["update_expression"], "slot", black_list=device_black_list.names, stride="mechanism_stride") }};
          {%- endfor %}
      {%- endfor %}

      {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items() %}
      y[i_{{state_variable_name}}*mechanism_stride+slot] = {{ cuda_printer.print(state_variable_info["update_expression"], "slot", black_list=device_black_list.names, stride="mechanism_stride") }};
      {%- endfor %}
      {%- endfor %}

      y[i_i_tot_{{ion_channel_name}}*mechanism_stride+slot] = {{ cuda_printer.print(channel_info["root_expression"], "slot", black_list=device_black_list.names, stride="mechanism_stride") }};
      y[i_d_i_tot_dv*mechanism_stride+slot] = {{ cuda_printer.print(channel_info["inline_derivative"], "slot", black_list=device_black_list.names, stride="mechanism_stride") }};
      y[i_g_val*mechanism_stride+slot] = - y[i_d_i_tot_dv*mechanism_stride+slot];
      y[i_i_val*mechanism_stride+slot] = y[i_i_tot_{{ion_channel_name}}*mechanism_stride+slot] - y[i_d_i_tot_dv*mechanism_stride+slot] * y[i_v_comp*mechanism_stride+slot];
  }

  __device__ __forceinline__
  void update_block(std::size_t i) const
  {
      const int i_neuron = static_cast<int>(i) / mechanism_stride;
      const int slot = static_cast<int>(i) % mechanism_stride;
      float* y = this->y + i_neuron * population_n_var;
      float* param = this->param == nullptr ? nullptr : this->param + i_neuron * population_n_param;
      const double self_spikes = static_cast<double>(global_self_spikes[i_neuron]);
      double __resolution = global_time_resolution[0];
      const int comp = compartment_association[i];
      {%- for ode in channel_info["Dependencies"]["concentrations"] %}
      const double {{ode.lhs.name}} = dep_{{ode.lhs.name}} == nullptr ? 0.0 : dep_{{ode.lhs.name}}[comp];
      {%- endfor %}
      {%- for inline in channel_info["Dependencies"]["receptors"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for inline in channel_info["Dependencies"]["channels"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for inline in channel_info["Dependencies"]["continuous"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
    {%- if channel_info["Blocks"] and channel_info["Blocks"]["UpdateBlock"] and channel_info["Blocks"]["UpdateBlock"].get_stmts_body().get_stmts()|length %}
      {%- set function = channel_info["Blocks"]["UpdateBlock"] %}
      {%- filter indent(4, True) %}
      {%- with ast = function.get_stmts_body() %}
      {%- set printer = cuda_printer.printer("slot", black_list=device_black_list.names, stride="mechanism_stride") %}
      {%-     include "cm_directives_cpp/StmtsBody.jinja2" %}
      {%- endwith %}
      {%- endfilter %}
    {%- endif %}
  }

  __device__ __forceinline__
  void self_spike_block(std::size_t i) const
  {
      const int i_neuron = static_cast<int>(i) / mechanism_stride;
      const int slot = static_cast<int>(i) % mechanism_stride;
      float* y = this->y + i_neuron * population_n_var;
      float* param = this->param == nullptr ? nullptr : this->param + i_neuron * population_n_param;
      const int comp = compartment_association[i];
      const double self_spikes = static_cast<double>(global_self_spikes[i_neuron]);
      double __resolution = global_time_resolution[0];
      {%- if "time_resolution_var" in channel_info %}
      double {{ printer_no_origin.print(channel_info["time_resolution_var"]) }} = global_time_resolution[0];
      {%- endif %}
      {%- for ode in channel_info["Dependencies"]["concentrations"] %}
      const double {{ode.lhs.name}} = dep_{{ode.lhs.name}} == nullptr ? 0.0 : dep_{{ode.lhs.name}}[comp];
      {%- endfor %}
      {%- for inline in channel_info["Dependencies"]["receptors"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for inline in channel_info["Dependencies"]["channels"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for inline in channel_info["Dependencies"]["continuous"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
    {%- if channel_info["Blocks"] and channel_info["Blocks"]["SelfSpikesFunction"] and channel_info["Blocks"]["SelfSpikesFunction"].get_stmts_body().get_stmts()|length %}
      {%- set function = channel_info["Blocks"]["SelfSpikesFunction"] %}
      {%- filter indent(4, True) %}
      {%- with ast = function.get_stmts_body() %}
      {%- set printer = cuda_printer.printer("slot", black_list=device_black_list.names, stride="mechanism_stride") %}
      {%-     include "cm_directives_cpp/StmtsBody.jinja2" %}
      {%- endwith %}
      {%- endfilter %}
    {%- endif %}
  }
};

__global__
void {{ion_channel_name}}_device_update({{ion_channel_name}}{{cm_unique_suffix}}Device device,
                                        float* compartment_g,
                                        float* compartment_i,
                                        int total_compartment_count)
{
  std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < device.total_mechanism_count)
  {
      device.update(i);
      device.update_block(i);
      const int i_neuron = static_cast<int>(i) / device.mechanism_stride;
      const int slot = static_cast<int>(i) % device.mechanism_stride;
      const float* y = device.y + i_neuron * device.population_n_var;
      const int compartment = device.compartment_association[i];
      if (compartment >= 0 && compartment < total_compartment_count)
      {
        atomicAdd(compartment_g + compartment, y[device.i_g_val * device.mechanism_stride + slot]);
        atomicAdd(compartment_i + compartment, y[device.i_i_val * device.mechanism_stride + slot]);
      }
  }
}

__global__
void {{ion_channel_name}}_device_self_spike_block({{ion_channel_name}}{{cm_unique_suffix}}Device device)
{
  std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < device.total_mechanism_count
      && device.global_self_spikes[i / device.mechanism_stride])
  {
      device.self_spike_block(i);
  }
}

__global__
void {{ion_channel_name}}_aggregate_total_current_kernel({{ion_channel_name}}{{cm_unique_suffix}}Device device,
                                                        float* compartment_current,
                                                        int compartment_count)
{
  const std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < device.total_mechanism_count)
  {
    const int i_neuron = static_cast<int>(i) / device.mechanism_stride;
    const int slot = static_cast<int>(i) % device.mechanism_stride;
    const float* y = device.y + i_neuron * device.population_n_var;
    const int compartment = device.compartment_association[i];
    if (compartment >= 0 && compartment < compartment_count)
    {
      atomicAdd(compartment_current + compartment,
                y[i_i_tot_{{ion_channel_name}} * device.mechanism_stride + slot]);
    }
  }
}

void {{ion_channel_name}}{{cm_unique_suffix}}::configure_population(
  float* var_arr,
  float* param_arr,
  int n_var,
  int n_param,
  int neuron_count,
  int compartment_count,
  int compartment_voltage_base_index,
  int mechanism_count,
  int mechanism_var_base_index,
  int mechanism_param_base_index,
  const std::vector<int>& global_compartment_association,
  int* global_self_spikes,
  double* global_time_resolution)
{
  population_neuron_count = neuron_count;
  population_n_var = n_var;
  population_n_param = n_param;
  population_compartment_count = compartment_count;
  population_voltage_base_index = compartment_voltage_base_index;
  mechanism_stride = mechanism_count;
  neuron_{{ion_channel_name}}_channel_count = mechanism_count;
  var_base_index = mechanism_var_base_index;
  param_base_index = mechanism_param_base_index;
  GPU_population_vars = var_arr;
  GPU_{{ion_channel_name}}_vars = var_arr == nullptr ? nullptr : var_arr + var_base_index;
  GPU_{{ion_channel_name}}_param = param_arr == nullptr ? nullptr : param_arr + param_base_index;
  GPU_self_spikes = global_self_spikes;
  GPU_time_resolution = global_time_resolution;

  if (!global_compartment_association.empty())
  {
    cudaMalloc(&GPU_compartment_association, global_compartment_association.size() * sizeof(int));
    cudaMemcpy(GPU_compartment_association,
               global_compartment_association.data(),
               global_compartment_association.size() * sizeof(int),
               cudaMemcpyHostToDevice);
  }
}

void {{ion_channel_name}}{{cm_unique_suffix}}::f_numstep_device(float* /*shared_v_comp*/, float* compartment_g, float* compartment_i, int total_compartment_count, long /*lag*/{% for ode in channel_info["Dependencies"]["concentrations"] %}, float* dep_{{ode.lhs.name}}{% endfor %}{% for inline in channel_info["Dependencies"]["receptors"] %}, float* dep_{{inline.variable_name}}{% endfor %}{% for inline in channel_info["Dependencies"]["channels"] %}, float* dep_{{inline.variable_name}}{% endfor %}{% for inline in channel_info["Dependencies"]["continuous"] %}, float* dep_{{inline.variable_name}}{% endfor %}, cudaStream_t stream)
{
  if (neuron_{{ ion_channel_name }}_channel_count == 0)
  {
    return;
  }

  const int threads_per_block = 256;
  const std::size_t total_count = population_neuron_count * neuron_{{ion_channel_name}}_channel_count;
  const int blocks = (total_count + threads_per_block - 1) / threads_per_block;
  {{ion_channel_name}}{{cm_unique_suffix}}Device device{GPU_{{ion_channel_name}}_vars, GPU_{{ion_channel_name}}_param, GPU_population_vars, GPU_compartment_association, GPU_self_spikes, GPU_time_resolution, mechanism_stride, population_n_var, population_n_param, population_compartment_count, population_voltage_base_index, total_count{% for ode in channel_info["Dependencies"]["concentrations"] %}, dep_{{ode.lhs.name}}{% endfor %}{% for inline in channel_info["Dependencies"]["receptors"] %}, dep_{{inline.variable_name}}{% endfor %}{% for inline in channel_info["Dependencies"]["channels"] %}, dep_{{inline.variable_name}}{% endfor %}{% for inline in channel_info["Dependencies"]["continuous"] %}, dep_{{inline.variable_name}}{% endfor %}};
  {{ion_channel_name}}_device_update<<<blocks, threads_per_block, 0, stream>>>(device,
                                                                   compartment_g,
                                                                   compartment_i,
                                                                   total_compartment_count);
}

