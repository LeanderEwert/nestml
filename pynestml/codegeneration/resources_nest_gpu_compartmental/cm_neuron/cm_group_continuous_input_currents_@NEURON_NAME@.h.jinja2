{#-
cm_group_continuous_input_currents_@NEURON_NAME@.h.jinja2

Continuous-input mechanism classes for NEST GPU compartmental models.
#}
{%- if tracing %}/* generated by {{self._TemplateReference__context.name}} */ {% endif -%}
{%- import 'directives_cpp/FunctionDeclaration.jinja2' as function_declaration with context %}
#ifndef CONTINUOUS_INPUTS_NEAT_H_{{cm_unique_suffix | upper }}
#define CONTINUOUS_INPUTS_NEAT_H_{{cm_unique_suffix | upper }}

#include <stdlib.h>
#include <vector>
#include <cmath>
#include <string>
#include <nlohmann/json.hpp>

#include <iostream>
#include <stdexcept>
#include <algorithm>

{% macro render_variable_type(variable) -%}
{%- with -%}
    {%- set symbol = variable.get_scope().resolve_to_symbol(variable.name, SymbolKind.VARIABLE) -%}
    {{ types_printer.print(symbol.type_symbol) }}
{%- endwith -%}
{%- endmacro %}

////////////////////////////////////////////////// continuous inputs

{%- for continuous_name, continuous_info in con_in_info.items() %}

enum {{ continuous_name }}VarIndexes
{
    {%- for variable_name, variable_info in continuous_info["States"].items() %}
  i_{{ variable_name }},
    {%- endfor %}

    {%- for ode_variable, ode_info in continuous_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
  i_{{ propagator }},
      {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in continuous_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  i_{{state_variable_name}},
        {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in continuous_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  i_{{state_variable_name}},
        {%- endfor %}
    {%- endfor %}

    {%- for port_name, port_info in continuous_info["Continuous"].items() %}
  i_{{ port_name }},
    {%- endfor %}

  i_v_comp,
  i_i_tot_{{ continuous_name }},
  i_g_val,
  i_i_val,
  i_d_i_tot_dv,
  N_{{ continuous_name }}_VARS
};

enum {{ continuous_name }}ParamIndexes
{
    {%- for param_name, param_declaration in continuous_info["Parameters"].items() %}
  i_{{param_name}},
    {%- endfor %}

    {%- for internal_name, internal_declaration in continuous_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
  i_{{variable.name}},
    {%- endfor %}

  N_{{ continuous_name }}_PARAM
};

class {{continuous_name}}{{cm_unique_suffix}}{
private:
  std::vector< long > continuous_idx = {};

  std::vector< double > i_tot_{{continuous_name}} = {};
  std::vector< double > g_val = {};
  std::vector< double > i_val = {};
  std::vector< double > d_i_tot_dv = {};

  {%- for pure_variable_name, variable_info in continuous_info["States"].items() %}
    {%- set variable = variable_info["ASTVariable"] %}
  std::vector<{{ render_variable_type(variable) }}> {{ variable.name }} = {};
  {%- endfor %}

  {%- for ode_variable, ode_info in continuous_info["ODEs"].items() %}
    {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
  std::vector< double > {{ propagator }} = {};
    {%- endfor %}
  {%- endfor %}

  {%- for convolution, convolution_info in continuous_info["convolutions"].items() %}
  {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  std::vector< double > {{state_variable_name}};
  {%- endfor %}
  {%- endfor %}

  {%- for convolution, convolution_info in continuous_info["convolutions"].items() %}
  {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  std::vector< double > {{state_variable_name}};
  {%- endfor %}
  {%- endfor %}

  {%- for port_name, port_info in continuous_info["Continuous"].items() %}
  std::vector< double > {{ port_name }} = {};
  std::vector< float* > {{ port_name }}_;
  {%- endfor %}

  {%- for param_name, param_declaration in continuous_info["Parameters"].items() %}
  std::vector< double > {{param_name}};
  {%- endfor %}

  {%- for internal_name, internal_declaration in continuous_info["Internals"].items() %}
    {%- set variable = internal_declaration["ASTVariable"] %}
  std::vector< double > {{variable.name}};
  {%- endfor %}

  double* GPU_{{continuous_name}}_vars;
  double* GPU_{{continuous_name}}_param;
  int* GPU_self_spikes = nullptr;
  double* GPU_time_resolution = nullptr;

  double* GPU_v_comp;
  double* GPU_i_tot_{{continuous_name}};
  double* GPU_g_val;
  double* GPU_i_val;
  double* GPU_d_i_tot_dv;

    {%- for variable_name, variable_info in continuous_info["States"].items() %}
  double* GPU_{{ variable_name }};
    {%- endfor %}

    {%- for ode_variable, ode_info in continuous_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
  double* GPU_{{ propagator }};
      {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in continuous_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  double* GPU_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in continuous_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  double* GPU_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    {%- for port_name, port_info in continuous_info["Continuous"].items() %}
  double* GPU_{{ port_name }};
    {%- endfor %}

    {%- for param_name, param_declaration in continuous_info["Parameters"].items() %}
  double* GPU_{{param_name}};
    {%- endfor %}

    {%- for internal_name, internal_declaration in continuous_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
  double* GPU_{{variable.name}};
    {%- endfor %}

public:
  {{continuous_name}}{{cm_unique_suffix}}(){};
  ~{{continuous_name}}{{cm_unique_suffix}}(){};

  void new_continuous_input(std::size_t comp_ass, const long con_in_index);
  void new_continuous_input(std::size_t comp_ass, const long con_in_index, const nlohmann::json& continuous_params);
  void init_pointers(int* global_self_spikes, double* global_time_resolution)
  {
    GPU_self_spikes = global_self_spikes;
    GPU_time_resolution = global_time_resolution;
  }

  std::size_t neuron_{{ continuous_name }}_continuous_input_count = 0;
  std::vector< size_t > compartment_association = {};

  std::pair< std::vector< double >, std::vector< double > > f_numstep(std::vector< double > v_comp, const long lag {% for ode in continuous_info["Dependencies"]["concentrations"] %}, std::vector< double > {{ode.lhs.name}}{% endfor %}{% if continuous_info["Dependencies"]["receptors"]|length %}
                        {% endif %}{% for inline in continuous_info["Dependencies"]["receptors"] %}, std::vector< double > {{inline.variable_name}}{% endfor %}{% if continuous_info["Dependencies"]["channels"]|length %}
                        {% endif %}{% for inline in continuous_info["Dependencies"]["channels"] %}, std::vector< double > {{inline.variable_name}}{% endfor %}{% if continuous_info["Dependencies"]["continuous"]|length %}
                        {% endif %}{% for inline in continuous_info["Dependencies"]["continuous"] %}, std::vector< double > {{inline.variable_name}}{% endfor %});

  void f_update();
  void f_self_spike();

{%- if nest_version.startswith("v2") or nest_version.startswith("v3.1") or nest_version.startswith("v3.2") or nest_version.startswith("v3.3") %}
  void calibrate(double time_resolution);
{%- else %}
  void pre_run_hook(double time_resolution);
{%- endif %}

  void set_buffer_ptr( std::vector< float >& continuous_buffers )
  {
    {% for port_name, port_info in continuous_info["Continuous"].items() %}
    {{port_name}}_.clear();
    {% endfor %}
    for(std::size_t i = 0; i < continuous_idx.size(); i++){
        {% for port_name, port_info in continuous_info["Continuous"].items() %}
        {{port_name}}_.push_back(&(continuous_buffers[continuous_idx[i]]));
        {% endfor %}
    }
  };

  {%- for function in continuous_info["Functions"] %}
  #pragma omp declare simd
    __attribute__((always_inline)) inline {{ function_declaration.FunctionDeclaration(function, pass_by_reference = true) -}};

  {% endfor %}

  void get_currents_per_compartment(std::vector< double >& compartment_to_current);
  void debug_print_i_tot(const std::string& mechanism_name, const std::size_t neuron_index, const long lag) const
  {
    for (std::size_t cont_id = 0; cont_id < neuron_{{ continuous_name }}_continuous_input_count; ++cont_id)
    {
      std::cout << "[{{neuronName}} debug] neuron=" << neuron_index
                << " lag=" << lag
                << " mechanism=" << mechanism_name
                << " continuous_index=" << continuous_idx[cont_id]
                << " compartment=" << compartment_association[cont_id]
                << " i_tot=" << i_tot_{{continuous_name}}[cont_id]
                << std::endl;
    }
  }

  std::vector< double > distribute_shared_vector(std::vector< double > shared_vector);
};

{% endfor %}

#endif /* #ifndef CONTINUOUS_INPUTS_NEAT_H_{{cm_unique_suffix | upper }} */
