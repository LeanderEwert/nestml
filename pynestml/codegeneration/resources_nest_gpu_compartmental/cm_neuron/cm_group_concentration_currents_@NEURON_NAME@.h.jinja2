{#-
cm_group_concentration_currents_@NEURON_NAME@.h.jinja2

Concentration mechanism classes for NEST GPU compartmental models.
#}
{%- if tracing %}/* generated by {{self._TemplateReference__context.name}} */ {% endif -%}
{%- import 'directives_cpp/FunctionDeclaration.jinja2' as function_declaration with context %}
#ifndef CONCENTRATIONS_NEAT_H_{{cm_unique_suffix | upper }}
#define CONCENTRATIONS_NEAT_H_{{cm_unique_suffix | upper }}

#include <stdlib.h>
#include <vector>
#include <cmath>
#include <string>
#include <nlohmann/json.hpp>

#include <iostream>
#include <stdexcept>
#include <algorithm>
#include <cuda_runtime.h>

{% macro render_variable_type(variable) -%}
{%- with -%}
    {%- set symbol = variable.get_scope().resolve_to_symbol(variable.name, SymbolKind.VARIABLE) -%}
    {{ types_printer.print(symbol.type_symbol) }}
{%- endwith -%}
{%- endmacro %}

///////////////////////////////////////////// concentrations

{%- for concentration_name, concentration_info in conc_info.items() %}

enum {{ concentration_name }}VarIndexes
{
    {%- for variable_name, variable_info in concentration_info["States"].items() %}
  i_{{ variable_name }},
    {%- endfor %}

    {%- for ode_variable, ode_info in concentration_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
  i_{{ propagator }},
      {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in concentration_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  i_{{state_variable_name}},
        {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in concentration_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  i_{{state_variable_name}},
        {%- endfor %}
    {%- endfor %}

  i_{{ concentration_name }}_v_comp,
  i_{{ concentration_name }},
  N_{{ concentration_name }}_VARS
};

enum {{ concentration_name }}ParamIndexes
{
    {%- for param_name, param_declaration in concentration_info["Parameters"].items() %}
  i_{{param_name}},
    {%- endfor %}

    {%- for internal_name, internal_declaration in concentration_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
  i_{{variable.name}},
    {%- endfor %}

  N_{{ concentration_name }}_PARAM
};

class {{concentration_name}}{{cm_unique_suffix}}{
private:
  static constexpr int i_v_comp = i_{{ concentration_name }}_v_comp;

  std::vector< double > {{concentration_name}} = {};
  std::vector< double > v_comp_conc_ = {};

  {%- for pure_variable_name, variable_info in concentration_info["States"].items() %}
    {%- set variable = variable_info["ASTVariable"] %}
  std::vector<{{ render_variable_type(variable) }}> {{ variable.name }} = {};
  {%- endfor %}

  {%- for ode_variable, ode_info in concentration_info["ODEs"].items() %}
    {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
  std::vector< double > {{ propagator }} = {};
    {%- endfor %}
  {%- endfor %}

  {%- for convolution, convolution_info in concentration_info["convolutions"].items() %}
  {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  std::vector< double > {{state_variable_name}};
  {%- endfor %}
  {%- endfor %}

  {%- for convolution, convolution_info in concentration_info["convolutions"].items() %}
  {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  std::vector< double > {{state_variable_name}};
  {%- endfor %}
  {%- endfor %}

  {%- for param_name, param_declaration in concentration_info["Parameters"].items() %}
  std::vector< double > {{param_name}};
  {%- endfor %}

  {%- for internal_name, internal_declaration in concentration_info["Internals"].items() %}
    {%- set variable = internal_declaration["ASTVariable"] %}
  std::vector< double > {{variable.name}};
  {%- endfor %}

  float* GPU_{{concentration_name}}_vars = nullptr;
  float* GPU_{{concentration_name}}_param = nullptr;
  int* GPU_compartment_association = nullptr;
  int* GPU_self_spikes = nullptr;
  double* GPU_time_resolution = nullptr;
  int recordable_max = 0;

  float* GPU_v_comp;
  float* GPU_{{concentration_name}};

    {%- for variable_name, variable_info in concentration_info["States"].items() %}
  float* GPU_{{ variable_name }};
    {%- endfor %}

    {%- for ode_variable, ode_info in concentration_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
  float* GPU_{{ propagator }};
      {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in concentration_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  float* GPU_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in concentration_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  float* GPU_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    {%- for param_name, param_declaration in concentration_info["Parameters"].items() %}
  float* GPU_{{param_name}};
    {%- endfor %}

    {%- for internal_name, internal_declaration in concentration_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
  float* GPU_{{variable.name}};
    {%- endfor %}

public:
  {{concentration_name}}{{cm_unique_suffix}}(){};
  ~{{concentration_name}}{{cm_unique_suffix}}(){};

  void new_concentration(std::size_t comp_ass);
  void new_concentration(std::size_t comp_ass, const nlohmann::json& concentration_params);
  void init_pointers(int* global_self_spikes, double* global_time_resolution)
  {
    GPU_self_spikes = global_self_spikes;
    GPU_time_resolution = global_time_resolution;
  }
  void init_recordable_pointers(float*, int, int, int, int)
  {
  }
  void init_base_arrays(float* var_arr, float* param_arr, int n_var, int n_param, int i_neuron, int base_index, int param_base_index, int max_recordables)
  {
    GPU_{{concentration_name}}_vars = var_arr == nullptr ? nullptr : var_arr + i_neuron * n_var + base_index;
    GPU_{{concentration_name}}_param = param_arr == nullptr ? nullptr : param_arr + i_neuron * n_param + param_base_index;
    recordable_max = max_recordables;
  }

  std::size_t neuron_{{ concentration_name }}_concentration_count = 0;
  std::vector< size_t > compartment_association = {};

  void f_numstep(std::vector< double > v_comp {% for ode in concentration_info["Dependencies"]["concentrations"] %}, std::vector< double > {{ode.lhs.name}}{% endfor %}{% if concentration_info["Dependencies"]["receptors"]|length %}
                        {% endif %}{% for inline in concentration_info["Dependencies"]["receptors"] %}, std::vector< double > {{inline.variable_name}}{% endfor %}{% if concentration_info["Dependencies"]["channels"]|length %}
                        {% endif %}{% for inline in concentration_info["Dependencies"]["channels"] %}, std::vector< double > {{inline.variable_name}}{% endfor %}{% if concentration_info["Dependencies"]["continuous"]|length %}
                        {% endif %}{% for inline in concentration_info["Dependencies"]["continuous"] %}, std::vector< double > {{inline.variable_name}}{% endfor %});
  void f_numstep_device(float* shared_v_comp, long lag{% for ode in concentration_info["Dependencies"]["concentrations"] %}, float* dep_{{ode.lhs.name}}{% endfor %}{% for inline in concentration_info["Dependencies"]["receptors"] %}, float* dep_{{inline.variable_name}}{% endfor %}{% for inline in concentration_info["Dependencies"]["channels"] %}, float* dep_{{inline.variable_name}}{% endfor %}{% for inline in concentration_info["Dependencies"]["continuous"] %}, float* dep_{{inline.variable_name}}{% endfor %});
  void add_concentrations_to_device(float* compartment_concentration, int compartment_count) const;

  void f_update();
  void f_self_spike();

{%- if nest_version.startswith("v2") or nest_version.startswith("v3.1") or nest_version.startswith("v3.2") or nest_version.startswith("v3.3") %}
  void calibrate(double time_resolution);
{%- else %}
  void pre_run_hook(double time_resolution);
{%- endif %}

  {%- for function in concentration_info["Functions"] %}
  #pragma omp declare simd
    __attribute__((always_inline)) inline {{ function_declaration.FunctionDeclaration(function, pass_by_reference = true) -}};

  {% endfor %}

  void get_concentrations_per_compartment(std::vector< double >& compartment_to_concentration);
  void sync_recordables(float* var_arr, int n_var, int i_neuron, int base_index, int max_recordables) const
  {
    int recordable_offset = base_index;

    for (std::size_t conc_id = 0; conc_id < neuron_{{ concentration_name }}_concentration_count; ++conc_id)
    {
      const std::size_t slot = conc_id;
      if (slot < static_cast<std::size_t>(max_recordables))
      {
        const float recordable_value = {{concentration_name}}.size() > conc_id ? static_cast<float>({{concentration_name}}[conc_id]) : 0.0f;
        cudaMemcpy(var_arr + i_neuron * n_var + recordable_offset + slot,
                   &recordable_value,
                   sizeof(float),
                   cudaMemcpyHostToDevice);
      }
    }
    recordable_offset += max_recordables;

    {%- for variable_name, variable_info in concentration_info["States"].items() %}
    for (std::size_t conc_id = 0; conc_id < neuron_{{ concentration_name }}_concentration_count; ++conc_id)
    {
      const std::size_t slot = conc_id;
      if (slot < static_cast<std::size_t>(max_recordables))
      {
        const float recordable_value = {{variable_name}}.size() > conc_id ? static_cast<float>({{variable_name}}[conc_id]) : 0.0f;
        cudaMemcpy(var_arr + i_neuron * n_var + recordable_offset + slot,
                   &recordable_value,
                   sizeof(float),
                   cudaMemcpyHostToDevice);
      }
    }
    recordable_offset += max_recordables;
    {% endfor -%}
  }

  void debug_print_concentration(const std::string& mechanism_name, const std::size_t neuron_index, const long lag) const
  {
    for (std::size_t conc_id = 0; conc_id < neuron_{{ concentration_name }}_concentration_count; ++conc_id)
    {
      float concentration_value = 0.0f;
      cudaMemcpy(&concentration_value, GPU_{{concentration_name}} + conc_id, sizeof(float), cudaMemcpyDeviceToHost);
      std::cout << "[{{neuronName}} debug] neuron=" << neuron_index
                << " lag=" << lag
                << " mechanism=" << mechanism_name
                << " concentration_index=" << conc_id
                << " compartment=" << compartment_association[conc_id]
                << " value=" << concentration_value
                << std::endl;
    }
  }

  std::vector< double > distribute_shared_vector(std::vector< double > shared_vector);
};

{% endfor %}

#endif /* #ifndef CONCENTRATIONS_NEAT_H_{{cm_unique_suffix | upper }} */
