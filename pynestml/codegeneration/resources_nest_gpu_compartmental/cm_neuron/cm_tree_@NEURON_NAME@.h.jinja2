#ifndef CM_TREE_{{cm_unique_suffix | upper }}_H
#define CM_TREE_{{cm_unique_suffix | upper }}_H

#include <stdlib.h>

#include <nlohmann/json.hpp>

// compartmental model
#include "{{neuronSpecificFileNamesCmSyns["groupcurrents"]}}.h"

// Includes from nestkernel:
#include <stdexcept>

#include <string>
#include <vector>

#include "cuda_error.h"

class Compartment{{cm_unique_suffix}}
{
public:
  // compartment index
  long comp_index;
  // parent compartment index
  long p_index;
  // tree structure indices
  Compartment{{cm_unique_suffix}}* parent;
  std::vector< Compartment{{cm_unique_suffix}} > children;

  // voltage variable
  double* v_comp;
  // electrical parameters
  double ca; // compartment capacitance [uF]
  double gc; // coupling conductance with parent (meaningless if root) [uS]
  double gl; // leak conductance of compartment [uS]
  double el; // leak current reversal potential [mV]
  // auxiliary variables for efficienchy
  double* gg0;
  double* ca__div__dt;
  double* gl__times__el;
  // for numerical integration
  double* ff;
  double* gg;
  double hh;

  // constructor, destructor
  Compartment{{cm_unique_suffix}}( const long compartment_index, const long parent_index);
  Compartment{{cm_unique_suffix}}( const long compartment_index, const long parent_index,
    double* v_comp_ref, double* ca__div__dt_ref, double* gl__times__el_ref, double* gg0_ref, double* gg_ref, double* ff_ref);
  Compartment{{cm_unique_suffix}}( const long compartment_index, const long parent_index, const nlohmann::json& compartment_params,
    double* v_comp_ref, double* ca__div__dt_ref, double* gl__times__el_ref, double* gg0_ref, double* gg_ref, double* ff_ref);
  ~Compartment{{cm_unique_suffix}}(){};

  // initialization
  void calibrate( double time_resolution );
}; // Compartment

class CompTree{{cm_unique_suffix}}
{
private:
  /*
  structural data containers for the compartment model
  */
  mutable Compartment{{cm_unique_suffix}} root_;
  std::vector< long > compartment_indices_;
  std::vector< Compartment{{cm_unique_suffix}}* > compartments_;

  long size_ = 0;

  // functions for pointer initialization
  void set_parents();
  void set_compartments();
  void set_compartment_variables();

  std::vector< double > v_comp_vec;
  std::vector< double > ca__div__dt_vec;
  std::vector< double > gl__times__el_vec;
  std::vector< double > gg0_vec;
  std::vector< double > gg_vec;
  std::vector< double > ff_vec;

  float* GPU_v_comp = nullptr;
  float* GPU_ca__div__dt = nullptr;
  float* GPU_gl__times__el = nullptr;
  float* GPU_gg0 = nullptr;
  float* GPU_gg = nullptr;
  float* GPU_ff = nullptr;
  float* GPU_hh = nullptr;
  float* GPU_gc = nullptr;
  float* GPU_mech_g = nullptr;
  float* GPU_mech_i = nullptr;
  int* GPU_parent_index = nullptr;
  bool base_arrays_initialized_ = false;
  bool device_tree_initialized_ = false;

public:
  // constructor, destructor
  CompTree{{cm_unique_suffix}}();
  ~CompTree{{cm_unique_suffix}}(){};

  GroupCurrents{{cm_unique_suffix}} neuron_currents;

  // initialization functions for tree structure
  void add_compartment( const long parent_index );
  void add_compartment( const long parent_index, const nlohmann::json& compartment_params );
  void add_compartment( Compartment{{cm_unique_suffix}}* compartment, const long parent_index );
  void calibrate( double time_resolution );

  void init_pointers(int* global_self_spikes, double* global_time_resolution);
  void init_base_arrays(float* var_arr, int n_var, int i_neuron, int base_index);
  void sync_device_tree_from_host();
  // get a compartment pointer from the tree
  Compartment{{cm_unique_suffix}}* get_compartment( const long compartment_index ) const;
  Compartment{{cm_unique_suffix}}* get_compartment( const long compartment_index, Compartment{{cm_unique_suffix}}* compartment, const long raise_flag ) const;
  Compartment{{cm_unique_suffix}}* get_compartment_opt( const long compartment_indx ) const;
  Compartment{{cm_unique_suffix}}*
  get_root() const
  {
    return &root_;
  };

  // get tree size (number of compartments)
  long
  get_size() const
  {
    return size_;
  };

  // advance compartment tree, mechanisms, and soma spike flag by one timestep
  void update( const long lag, float* port_input_arr, int port_input_port_step, double threshold, int* self_spikes, float* previous_soma_voltage );
  // construct the numerical integration matrix and vector
  void construct_matrix( const long lag, float* port_input_arr, int port_input_port_step );
  // solve the matrix equation for next timestep voltage
  void solve_matrix(double threshold, int* self_spikes, float* previous_soma_voltage);

}; // CompTree

#endif /* #ifndef CM_TREE_{{cm_unique_suffix | upper }}_H */
