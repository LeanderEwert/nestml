{#-
cm_group_channel_currents_@NEURON_NAME@.h.jinja2

Ion-channel mechanism classes for NEST GPU compartmental models.
#}
{%- if tracing %}/* generated by {{self._TemplateReference__context.name}} */ {% endif -%}
{%- import 'directives_cpp/FunctionDeclaration.jinja2' as function_declaration with context %}
#ifndef CHANNELS_NEAT_H_{{cm_unique_suffix | upper }}
#define CHANNELS_NEAT_H_{{cm_unique_suffix | upper }}

#include <stdlib.h>
#include <vector>
#include <cmath>
#include <string>
#include <nlohmann/json.hpp>

#include <iostream>
#include <stdexcept>
#include <algorithm>
#include <cuda_runtime.h>

{% macro render_variable_type(variable) -%}
{%- with -%}
    {%- set symbol = variable.get_scope().resolve_to_symbol(variable.name, SymbolKind.VARIABLE) -%}
    {{ types_printer.print(symbol.type_symbol) }}
{%- endwith -%}
{%- endmacro %}

////////////////////////////////////////////////// channels

{%- for ion_channel_name, channel_info in chan_info.items() %}

enum {{ ion_channel_name }}VarIndexes
{
    {%- for variable_name, variable_info in channel_info["States"].items() %}
  i_{{ variable_name }},
    {%- endfor %}

    {%- for ode_variable, ode_info in channel_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
  i_{{ propagator }},
      {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  i_{{state_variable_name}},
        {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  i_{{state_variable_name}},
        {%- endfor %}
    {%- endfor %}

  i_{{ ion_channel_name }}_v_comp,
  i_i_tot_{{ ion_channel_name }},
  i_{{ ion_channel_name }}_g_val,
  i_{{ ion_channel_name }}_i_val,
  i_{{ ion_channel_name }}_d_i_tot_dv,
  N_{{ ion_channel_name }}_VARS
};

enum {{ ion_channel_name }}ParamIndexes
{
    {%- for param_name, param_declaration in channel_info["Parameters"].items() %}
  i_{{param_name}},
    {%- endfor %}

    {%- for internal_name, internal_declaration in channel_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
  i_{{variable.name}},
    {%- endfor %}

  N_{{ ion_channel_name }}_PARAM
};

class {{ion_channel_name}}{{cm_unique_suffix}}{
private:
  static constexpr int i_v_comp = i_{{ ion_channel_name }}_v_comp;
  static constexpr int i_g_val = i_{{ ion_channel_name }}_g_val;
  static constexpr int i_i_val = i_{{ ion_channel_name }}_i_val;
  static constexpr int i_d_i_tot_dv = i_{{ ion_channel_name }}_d_i_tot_dv;

  std::vector< double > i_tot_{{ion_channel_name}} = {};
  std::vector< double > g_val = {};
  std::vector< double > i_val = {};
  std::vector< double > d_i_tot_dv = {};

  {%- for pure_variable_name, variable_info in channel_info["States"].items() %}
    {%- set variable = variable_info["ASTVariable"] %}
  std::vector<{{ render_variable_type(variable) }}> {{ variable.name }} = {};
  {%- endfor %}

  {%- for ode_variable, ode_info in channel_info["ODEs"].items() %}
    {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
  std::vector< double > {{ propagator }} = {};
    {%- endfor %}
  {%- endfor %}

  {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
  {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  std::vector< double > {{state_variable_name}};
  {%- endfor %}
  {%- endfor %}

  {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
  {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  std::vector< double > {{state_variable_name}};
  {%- endfor %}
  {%- endfor %}

  {%- for param_name, param_declaration in channel_info["Parameters"].items() %}
  std::vector< double > {{param_name}};
  {%- endfor %}

  {%- for internal_name, internal_declaration in channel_info["Internals"].items() %}
    {%- set variable = internal_declaration["ASTVariable"] %}
  std::vector< double > {{variable.name}};
  {%- endfor %}

  float* GPU_{{ion_channel_name}}_vars = nullptr;
  float* GPU_{{ion_channel_name}}_param = nullptr;
  int* GPU_compartment_association = nullptr;
  int* GPU_self_spikes = nullptr;
  double* GPU_time_resolution = nullptr;
  int mechanism_stride = 0;

  float* GPU_v_comp;
  float* GPU_i_tot_{{ion_channel_name}};
  float* GPU_g_val;
  float* GPU_i_val;
  float* GPU_d_i_tot_dv;

    //model specific states
    {%- for variable_name, variable_info in channel_info["States"].items() %}
  float* GPU_{{ variable_name }};
    {%- endfor %}

    {%- for ode_variable, ode_info in channel_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
  float* GPU_{{ propagator }};
      {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  float* GPU_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  float* GPU_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    //model specific parameters
    {%- for param_name, param_declaration in channel_info["Parameters"].items() %}
  float* GPU_{{param_name}};
    {%- endfor %}

    {%- for internal_name, internal_declaration in channel_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
  float* GPU_{{variable.name}};
    {%- endfor %}

public:
  {{ion_channel_name}}{{cm_unique_suffix}}(){};
  ~{{ion_channel_name}}{{cm_unique_suffix}}(){};

  void new_channel(std::size_t comp_ass);
  void new_channel(std::size_t comp_ass, const nlohmann::json& channel_params);
  void init_pointers(int* global_self_spikes, double* global_time_resolution)
  {
    GPU_self_spikes = global_self_spikes;
    GPU_time_resolution = global_time_resolution;
  }
  void init_base_arrays(float* var_arr, float* param_arr, int n_var, int n_param, int i_neuron, int base_index, int param_base_index, int mechanism_count)
  {
    GPU_{{ion_channel_name}}_vars = var_arr == nullptr ? nullptr : var_arr + i_neuron * n_var + base_index;
    GPU_{{ion_channel_name}}_param = param_arr == nullptr ? nullptr : param_arr + i_neuron * n_param + param_base_index;
    mechanism_stride = mechanism_count;
  }

  std::size_t neuron_{{ ion_channel_name }}_channel_count = 0;
  std::vector< size_t > compartment_association = {};

  void f_numstep_device(float* shared_v_comp, long lag{% for ode in channel_info["Dependencies"]["concentrations"] %}, float* dep_{{ode.lhs.name}}{% endfor %}{% for inline in channel_info["Dependencies"]["receptors"] %}, float* dep_{{inline.variable_name}}{% endfor %}{% for inline in channel_info["Dependencies"]["channels"] %}, float* dep_{{inline.variable_name}}{% endfor %}{% for inline in channel_info["Dependencies"]["continuous"] %}, float* dep_{{inline.variable_name}}{% endfor %});
  void add_currents_to_device(float* compartment_g, float* compartment_i, int compartment_count) const;
  void add_total_current_to_device(float* compartment_current, int compartment_count) const;

  void f_update();
  void f_self_spike();

  void calibrate(double time_resolution);

  {%- for function in channel_info["Functions"] %}
  #pragma omp declare simd
    __attribute__((always_inline)) inline {{ function_declaration.FunctionDeclaration(function, pass_by_reference = true) -}};

  {% endfor %}

};

{% endfor %}

#endif /* #ifndef CHANNELS_NEAT_H_{{cm_unique_suffix | upper }} */
