#ifndef CM_{{neuronSpecificFileNamesCmSyns["main"].upper()}}
#define CM_{{neuronSpecificFileNamesCmSyns["main"].upper()}}

#include <string>
#include "base_neuron.h"
#include "basic_neuron_nestml.h"
#include <nlohmann/json.hpp>

extern __constant__ float NESTGPUTimeResolution;

namespace basic_neuron_gpu_nestml_ns
{
enum ScalVarIndexes {
    //receptor states
        {%- for variable_name, variable_info in receptor_info["States"].items() %}
  i_{{ variable_name }},
        {%- endfor %}

        {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
            {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  i_{{state_variable_name}},
            {%- endfor %}
        {%- endfor %}

        {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
            {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  i_{{state_variable_name}},
            {%- endfor %}
        {%- endfor %}

    {%- for variable_info in receptor_info["SecondaryInlineExpressions"] %}
        {%- if variable_info.is_recordable %}
        {%- set variable = variable_info.variable_name %}
  i_{{ variable }},
        {%- endif %}
    {%- endfor %}
  N_SCAL_VAR
};

enum ScalParamIndexes {
    {%- for receptor_name, receptor_info in recs_info.items() %}
        {%- for param_name, param_declaration in receptor_info["Parameters"].items() %}
  i_{{param_name}},
        {%- endfor %}
    {% endfor -%}
  N_SCAL_PARAM
};

enum PortVarIndexes {
  i_exc_spikes,
  N_PORT_VAR
};

const std::string basic_neuron_gpu_nestml_scal_var_name[N_SCAL_VAR] = {
};

const std::string basic_neuron_gpu_nestml_scal_param_name[N_SCAL_PARAM] = {
};

const std::string basic_neuron_gpu_nestml_port_var_name[N_PORT_VAR] = {
  "exc_spikes",
};

enum GroupParamIndexes {
  i_h_min_rel = 0,  // Min. step in ODE integr. relative to time resolution
  i_h0_rel,         // Starting step in ODE integr. relative to time resolution
  N_GROUP_PARAM
};

const std::string basic_neuron_gpu_nestml_group_param_name[N_GROUP_PARAM] = {
  "h_min_rel",
  "h0_rel"
};

}; //namespace

class basic_neuron_gpu_nestml : public BaseNeuron
{
 public:
  basic_neuron_gpu_nestml() {receivesDict = true;}
  std::vector<basic_neuron_nestml> neurons;

  float h_min_;
  float h_;

  int Init(int i_node_0, int n_neuron, int n_port, int i_group,
	   unsigned long long *seed);

  int Calibrate(double, float time_resolution);

  int Update(long long it, double t1);
  int SetNeuronVariablesDict( int i_neuron, int n_neuron, nlohmann::json dict );
};

#endif /* #ifndef CM_{cm_unique_suffix | upper }}_H */
