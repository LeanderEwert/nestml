  {{concentration_name}}{{cm_unique_suffix}}Device device{GPU_{{concentration_name}}_vars, GPU_{{concentration_name}}_param, GPU_compartment_association, GPU_self_spikes, GPU_time_resolution, recordable_max, neuron_{{concentration_name}}_concentration_count{% for ode in concentration_info["Dependencies"]["concentrations"] %}, nullptr{% endfor %}{% for inline in concentration_info["Dependencies"]["receptors"] %}, nullptr{% endfor %}{% for inline in concentration_info["Dependencies"]["channels"] %}, nullptr{% endfor %}{% for inline in concentration_info["Dependencies"]["continuous"] %}, nullptr{% endfor %}};
  {{concentration_name}}_device_update<<<blocks, threads_per_block>>>(device);
  cudaDeviceSynchronize();

  for(std::size_t conc_id = 0; conc_id < neuron_{{ concentration_name }}_concentration_count; conc_id++){
    float value = 0.0f;
    cudaMemcpy(&value, GPU_{{concentration_name}} + conc_id, sizeof(float), cudaMemcpyDeviceToHost);
    {{concentration_name}}[conc_id] = static_cast<double>(value);
    {%- for variable_name, variable_info in concentration_info["States"].items() %}
    cudaMemcpy(&value, GPU_{{ variable_name }} + conc_id, sizeof(float), cudaMemcpyDeviceToHost);
    {{ variable_name }}[conc_id] = static_cast<double>(value);
    {%- endfor %}
  }

  f_update();
}

