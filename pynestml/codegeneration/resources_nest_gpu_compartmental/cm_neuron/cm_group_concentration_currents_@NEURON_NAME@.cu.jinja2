{%- if nest_version.startswith("v2") or nest_version.startswith("v3.1") or nest_version.startswith("v3.2") or nest_version.startswith("v3.3") %}
void {{concentration_name}}{{cm_unique_suffix}}::calibrate(double time_resolution)
{%- else %}
void {{concentration_name}}{{cm_unique_suffix}}::pre_run_hook(double time_resolution)
{%- endif %}
{
  if (neuron_{{ concentration_name }}_concentration_count == 0)
  {
    return;
  }
  if (GPU_{{concentration_name}}_vars == nullptr)
  {
    throw std::runtime_error("{{concentration_name}} base variable array was not initialized before pre_run_hook()");
  }
  if (N_{{concentration_name}}_PARAM > 0 && GPU_{{concentration_name}}_param == nullptr)
  {
    throw std::runtime_error("{{concentration_name}} base parameter array was not initialized before pre_run_hook()");
  }

  cudaMalloc(&GPU_compartment_association, neuron_{{concentration_name}}_concentration_count * sizeof(int));
  std::vector<int> compartment_association_int(compartment_association.begin(), compartment_association.end());
  cudaMemcpy(GPU_compartment_association,
             compartment_association_int.data(),
             neuron_{{concentration_name}}_concentration_count * sizeof(int),
             cudaMemcpyHostToDevice);

  for(std::size_t i = 0; i < neuron_{{ concentration_name }}_concentration_count; i++){
    {%- if "time_resolution_var" in concentration_info %}
    double {{ printer_no_origin.print(concentration_info["time_resolution_var"]) }} = time_resolution;
    {%- endif %}
    {%- for ode_variable, ode_info in concentration_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
    {{ propagator }}[i] = {{ vector_printer.print(propagator_info["init_expression"], "i", concentration_info["non_vec_vars"]) }};
      {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in concentration_info["convolutions"].items() %}
    {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
    {{state_variable_name}}[i] = {{ vector_printer.print(state_variable_info["init_expression"], "i", concentration_info["non_vec_vars"]) }};
    {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in concentration_info["convolutions"].items() %}
    {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
    {{state_variable_name}}[i] = 0;
    {%- endfor %}
    {%- endfor %}
  }

  GPU_v_comp = GPU_{{concentration_name}}_vars + recordable_max * i_v_comp;
  GPU_{{concentration_name}} = GPU_{{concentration_name}}_vars + recordable_max * i_{{concentration_name}};

    {%- for variable_name, variable_info in concentration_info["States"].items() %}
  GPU_{{ variable_name }} = GPU_{{concentration_name}}_vars + recordable_max * i_{{ variable_name }};
    {%- endfor %}

    {%- for ode_variable, ode_info in concentration_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
  GPU_{{ propagator }} = GPU_{{concentration_name}}_vars + recordable_max * i_{{ propagator }};
      {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in concentration_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  GPU_{{state_variable_name}} = GPU_{{concentration_name}}_vars + recordable_max * i_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in concentration_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  GPU_{{state_variable_name}} = GPU_{{concentration_name}}_vars + recordable_max * i_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    {%- for param_name, param_declaration in concentration_info["Parameters"].items() %}
  GPU_{{param_name}} = GPU_{{concentration_name}}_param + recordable_max * i_{{param_name}};
    {%- endfor %}

    {%- for internal_name, internal_declaration in concentration_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
  GPU_{{variable.name}} = GPU_{{concentration_name}}_param + recordable_max * i_{{variable.name}};
    {%- endfor %}

  for(std::size_t conc_id = 0; conc_id < neuron_{{ concentration_name }}_concentration_count; conc_id++){
    float value = static_cast<float>(v_comp_conc_[conc_id]);
    cudaMemcpy(GPU_v_comp + conc_id, &value, sizeof(float), cudaMemcpyHostToDevice);
    value = static_cast<float>({{concentration_name}}[conc_id]);
    cudaMemcpy(GPU_{{concentration_name}} + conc_id, &value, sizeof(float), cudaMemcpyHostToDevice);

    {%- for variable_name, variable_info in concentration_info["States"].items() %}
    value = static_cast<float>({{ variable_name }}[conc_id]);
    cudaMemcpy(GPU_{{ variable_name }} + conc_id, &value, sizeof(float), cudaMemcpyHostToDevice);
    {% endfor -%}

    {%- for ode_variable, ode_info in concentration_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
    value = static_cast<float>({{propagator}}[conc_id]);
    cudaMemcpy(GPU_{{propagator}} + conc_id, &value, sizeof(float), cudaMemcpyHostToDevice);
      {% endfor -%}
    {% endfor -%}

    {%- for convolution, convolution_info in concentration_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
    value = static_cast<float>({{state_variable_name}}[conc_id]);
    cudaMemcpy(GPU_{{state_variable_name}} + conc_id, &value, sizeof(float), cudaMemcpyHostToDevice);
      {% endfor -%}
    {% endfor -%}

    {%- for convolution, convolution_info in concentration_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
    value = static_cast<float>({{state_variable_name}}[conc_id]);
    cudaMemcpy(GPU_{{state_variable_name}} + conc_id, &value, sizeof(float), cudaMemcpyHostToDevice);
      {% endfor -%}
    {% endfor -%}

    {%- for param_name, param_declaration in concentration_info["Parameters"].items() %}
    value = static_cast<float>({{param_name}}[conc_id]);
    cudaMemcpy(GPU_{{param_name}} + conc_id, &value, sizeof(float), cudaMemcpyHostToDevice);
    {% endfor -%}

    {%- for internal_name, internal_declaration in concentration_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
    value = static_cast<float>({{variable.name}}[conc_id]);
    cudaMemcpy(GPU_{{variable.name}} + conc_id, &value, sizeof(float), cudaMemcpyHostToDevice);
    {% endfor -%}
  }
}

struct {{concentration_name}}{{cm_unique_suffix}}Device
{
  static constexpr int i_v_comp = i_{{ concentration_name }}_v_comp;

  float* y;
  float* param;
  int* compartment_association;
  int* global_self_spikes;
  double* global_time_resolution;
  int recordable_max;
  std::size_t neuron_{{concentration_name}}_concentration_count;
  {%- for ode in concentration_info["Dependencies"]["concentrations"] %}
  float* dep_{{ode.lhs.name}};
  {%- endfor %}
  {%- for inline in concentration_info["Dependencies"]["receptors"] %}
  float* dep_{{inline.variable_name}};
  {%- endfor %}
  {%- for inline in concentration_info["Dependencies"]["channels"] %}
  float* dep_{{inline.variable_name}};
  {%- endfor %}
  {%- for inline in concentration_info["Dependencies"]["continuous"] %}
  float* dep_{{inline.variable_name}};
  {%- endfor %}

{%- for function in concentration_info["Functions"] %}
  {{ device_function_declaration.DeviceFunctionDeclaration(function, function.get_name()) }}
  {
  {%-   filter indent(4,True) %}
  {%-   with ast = function.get_stmts_body() %}
  {%-     set printer = printer_no_origin %}
  {%-     include "directives_cpp/StmtsBody.jinja2" %}
  {%-   endwith %}
  {%-   endfilter %}
  }
{%- endfor %}

{%- set device_black_list = namespace(names=["self_spikes"]) %}
{%- if "time_resolution_var" in concentration_info %}
{%- set device_black_list.names = device_black_list.names + [printer_no_origin.print(concentration_info["time_resolution_var"])] %}
{%- endif %}
{%- for ode in concentration_info["Dependencies"]["concentrations"] %}
{%- set device_black_list.names = device_black_list.names + [ode.lhs.name] %}
{%- endfor %}
{%- for inline in concentration_info["Dependencies"]["receptors"] %}
{%- set device_black_list.names = device_black_list.names + [inline.variable_name] %}
{%- endfor %}
{%- for inline in concentration_info["Dependencies"]["channels"] %}
{%- set device_black_list.names = device_black_list.names + [inline.variable_name] %}
{%- endfor %}
{%- for inline in concentration_info["Dependencies"]["continuous"] %}
{%- set device_black_list.names = device_black_list.names + [inline.variable_name] %}
{%- endfor %}
{%- for replacement, expression in concentration_info["cse_function_replacements"].items() %}
{%- set device_black_list.names = device_black_list.names + [replacement] %}
{%- endfor %}
{%- for replacement, expression in concentration_info["cse_body_replacements"].items() %}
{%- set device_black_list.names = device_black_list.names + [replacement] %}
{%- endfor %}

  __device__ __forceinline__
  void update(std::size_t i) const
  {
      const int slot = static_cast<int>(i);
      const double self_spikes = static_cast<double>(global_self_spikes[0]);
      const int comp = compartment_association[slot];
      {%- if "time_resolution_var" in concentration_info %}
      double {{ printer_no_origin.print(concentration_info["time_resolution_var"]) }} = global_time_resolution[0];
      {%- endif %}
      {%- for ode in concentration_info["Dependencies"]["concentrations"] %}
      const double {{ode.lhs.name}} = dep_{{ode.lhs.name}} == nullptr ? 0.0 : dep_{{ode.lhs.name}}[comp];
      {%- endfor %}
      {%- for inline in concentration_info["Dependencies"]["receptors"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for inline in concentration_info["Dependencies"]["channels"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for inline in concentration_info["Dependencies"]["continuous"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for replacement, expression in concentration_info["cse_function_replacements"].items() %}
      const double {{ replacement }} = {{ cuda_printer.print(expression, "slot", black_list=device_black_list.names, stride="recordable_max") }};
      {%- endfor %}
      {%- for replacement, expression in concentration_info["cse_body_replacements"].items() %}
      const double {{ replacement }} = {{ cuda_printer.print(expression, "slot", black_list=device_black_list.names, stride="recordable_max") }};
      {%- endfor %}
      {%- for ode_variable, ode_info in concentration_info["ODEs"].items() %}
          {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
      y[i_{{ propagator }}*recordable_max+slot] = {{ cuda_printer.print(propagator_info["init_expression"], "slot", black_list=device_black_list.names, stride="recordable_max") }};
          {%- endfor %}
          {%- for state, state_solution_info in ode_info["transformed_solutions"][0]["states"].items() %}
      y[i_{{state}}*recordable_max+slot] = {{ cuda_printer.print(state_solution_info["update_expression"], "slot", black_list=device_black_list.names, stride="recordable_max") }};
          {%- endfor %}
      {%- endfor %}

      {%- for convolution, convolution_info in concentration_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items() %}
      y[i_{{state_variable_name}}*recordable_max+slot] = {{ cuda_printer.print(state_variable_info["update_expression"], "slot", black_list=device_black_list.names, stride="recordable_max") }};
      y[i_{{state_variable_name}}*recordable_max+slot] += self_spikes * {{ cuda_printer.print(state_variable_info["init_expression"], "slot", black_list=device_black_list.names, stride="recordable_max") }};
      {%- endfor %}
      {%- endfor %}
  }

  __device__ __forceinline__
  void update_block(std::size_t i) const
  {
      const int slot = static_cast<int>(i);
      const double self_spikes = static_cast<double>(global_self_spikes[0]);
      double __resolution = global_time_resolution[0];
      const int comp = compartment_association[slot];
      {%- for ode in concentration_info["Dependencies"]["concentrations"] %}
      const double {{ode.lhs.name}} = dep_{{ode.lhs.name}} == nullptr ? 0.0 : dep_{{ode.lhs.name}}[comp];
      {%- endfor %}
      {%- for inline in concentration_info["Dependencies"]["receptors"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for inline in concentration_info["Dependencies"]["channels"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for inline in concentration_info["Dependencies"]["continuous"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
    {%- if concentration_info["Blocks"] and concentration_info["Blocks"]["UpdateBlock"] and concentration_info["Blocks"]["UpdateBlock"].get_stmts_body().get_stmts()|length %}
      {%- set function = concentration_info["Blocks"]["UpdateBlock"] %}
      {%- filter indent(4, True) %}
      {%- with ast = function.get_stmts_body() %}
      {%- set printer = cuda_printer.printer("slot", black_list=device_black_list.names, stride="recordable_max") %}
      {%-     include "cm_directives_cpp/StmtsBody.jinja2" %}
      {%- endwith %}
      {%- endfilter %}
    {%- endif %}
  }

  __device__ __forceinline__
  void self_spike_block(std::size_t i) const
  {
      const int slot = static_cast<int>(i);
      const double self_spikes = static_cast<double>(global_self_spikes[0]);
      double __resolution = global_time_resolution[0];
      const int comp = compartment_association[slot];
      {%- for ode in concentration_info["Dependencies"]["concentrations"] %}
      const double {{ode.lhs.name}} = dep_{{ode.lhs.name}} == nullptr ? 0.0 : dep_{{ode.lhs.name}}[comp];
      {%- endfor %}
      {%- for inline in concentration_info["Dependencies"]["receptors"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for inline in concentration_info["Dependencies"]["channels"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
      {%- for inline in concentration_info["Dependencies"]["continuous"] %}
      const double {{inline.variable_name}} = dep_{{inline.variable_name}} == nullptr ? 0.0 : dep_{{inline.variable_name}}[comp];
      {%- endfor %}
    {%- if concentration_info["Blocks"] and concentration_info["Blocks"]["SelfSpikesFunction"] and concentration_info["Blocks"]["SelfSpikesFunction"].get_stmts_body().get_stmts()|length %}
      {%- set function = concentration_info["Blocks"]["SelfSpikesFunction"] %}
      {%- filter indent(4, True) %}
      {%- with ast = function.get_stmts_body() %}
      {%- set printer = cuda_printer.printer("slot", black_list=device_black_list.names, stride="recordable_max") %}
      {%-     include "cm_directives_cpp/StmtsBody.jinja2" %}
      {%- endwith %}
      {%- endfilter %}
    {%- endif %}
  }
};

__global__
void {{concentration_name}}_device_update({{concentration_name}}{{cm_unique_suffix}}Device device)
{
  std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < device.neuron_{{concentration_name}}_concentration_count)
  {
      device.update(i);
  }
}

__global__
void {{concentration_name}}_device_update_block({{concentration_name}}{{cm_unique_suffix}}Device device)
{
  std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < device.neuron_{{concentration_name}}_concentration_count)
  {
      device.update_block(i);
  }
}

__global__
void {{concentration_name}}_device_self_spike_block({{concentration_name}}{{cm_unique_suffix}}Device device)
{
  std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < device.neuron_{{concentration_name}}_concentration_count && device.global_self_spikes[0])
  {
      device.self_spike_block(i);
  }
}

__global__
void {{concentration_name}}_copy_compartment_voltage_kernel(const float* shared_v_comp,
                                                           const int* compartment_association,
                                                           float* mechanism_v_comp,
                                                           std::size_t mechanism_count)
{
  const std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < mechanism_count)
  {
    mechanism_v_comp[i] = shared_v_comp[compartment_association[i]];
  }
}

__global__
void {{concentration_name}}_aggregate_concentrations_kernel(const float* mechanism_concentration,
                                                            const int* compartment_association,
                                                            float* compartment_concentration,
                                                            int compartment_count,
                                                            std::size_t mechanism_count)
{
  const std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < mechanism_count)
  {
    const int compartment = compartment_association[i];
    if (compartment >= 0 && compartment < compartment_count)
    {
      atomicAdd(compartment_concentration + compartment, mechanism_concentration[i]);
    }
  }
}

void {{concentration_name}}{{cm_unique_suffix}}::f_numstep(std::vector< double > v_comp {% for ode in concentration_info["Dependencies"]["concentrations"] %}, std::vector< double > {{ode.lhs.name}}{% endfor %}{% if concentration_info["Dependencies"]["receptors"]|length %}
