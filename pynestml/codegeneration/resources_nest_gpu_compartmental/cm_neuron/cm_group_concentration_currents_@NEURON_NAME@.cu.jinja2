struct {{concentration_name}}{{cm_unique_suffix}}Device
{
  double* y;
  double* param;
  int* global_self_spikes;
  double* global_time_resolution;
  std::size_t neuron_{{concentration_name}}_concentration_count;

{%- for function in concentration_info["Functions"] %}
  {{ device_function_declaration.DeviceFunctionDeclaration(function, function.get_name()) }}
  {
  {%-   filter indent(4,True) %}
  {%-   with ast = function.get_stmts_body() %}
  {%-     set printer = printer_no_origin %}
  {%-     include "directives_cpp/StmtsBody.jinja2" %}
  {%-   endwith %}
  {%-   endfilter %}
  }
{%- endfor %}

{%- set device_black_list = ["self_spikes"] %}
{%- if "time_resolution_var" in concentration_info %}
{%- set device_black_list = device_black_list + [printer_no_origin.print(concentration_info["time_resolution_var"])] %}
{%- endif %}

  __device__ __forceinline__
  void update(std::size_t i) const
  {
      const double self_spikes = static_cast<double>(global_self_spikes[0]);
      {%- if "time_resolution_var" in concentration_info %}
      double {{ printer_no_origin.print(concentration_info["time_resolution_var"]) }} = global_time_resolution[0];
      {%- endif %}
      {%- for ode_variable, ode_info in concentration_info["ODEs"].items() %}
          {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
      y[i_{{ propagator }}+i] = {{ cuda_printer.print(propagator_info["init_expression"], "i", black_list=device_black_list) }};
          {%- endfor %}
          {%- for state, state_solution_info in ode_info["transformed_solutions"][0]["states"].items() %}
      y[i_{{state}}+i] = {{ cuda_printer.print(state_solution_info["update_expression"], "i", black_list=device_black_list) }};
          {%- endfor %}
      {%- endfor %}

      {%- for convolution, convolution_info in concentration_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items() %}
      y[i_{{state_variable_name}}+i] = {{ cuda_printer.print(state_variable_info["update_expression"], "i", black_list=device_black_list) }};
      y[i_{{state_variable_name}}+i] += self_spikes * {{ cuda_printer.print(state_variable_info["init_expression"], "i", black_list=device_black_list) }};
      {%- endfor %}
      {%- endfor %}
  }

  __device__ __forceinline__
  void update_block(std::size_t i) const
  {
      const double self_spikes = static_cast<double>(global_self_spikes[0]);
      double __resolution = global_time_resolution[0];
    {%- if concentration_info["Blocks"] and concentration_info["Blocks"]["UpdateBlock"] and concentration_info["Blocks"]["UpdateBlock"].get_stmts_body().get_stmts()|length %}
      {%- set function = concentration_info["Blocks"]["UpdateBlock"] %}
      {%- filter indent(4, True) %}
      {%- with ast = function.get_stmts_body() %}
      {%- set printer = cuda_printer.printer("i", black_list=device_black_list) %}
      {%-     include "cm_directives_cpp/StmtsBody.jinja2" %}
      {%- endwith %}
      {%- endfilter %}
    {%- endif %}
  }

  __device__ __forceinline__
  void self_spike_block(std::size_t i) const
  {
      const double self_spikes = static_cast<double>(global_self_spikes[0]);
      double __resolution = global_time_resolution[0];
    {%- if concentration_info["Blocks"] and concentration_info["Blocks"]["SelfSpikesFunction"] and concentration_info["Blocks"]["SelfSpikesFunction"].get_stmts_body().get_stmts()|length %}
      {%- set function = concentration_info["Blocks"]["SelfSpikesFunction"] %}
      {%- filter indent(4, True) %}
      {%- with ast = function.get_stmts_body() %}
      {%- set printer = cuda_printer.printer("i", black_list=device_black_list) %}
      {%-     include "cm_directives_cpp/StmtsBody.jinja2" %}
      {%- endwith %}
      {%- endfilter %}
    {%- endif %}
  }
};

__global__
void {{concentration_name}}_device_update({{concentration_name}}{{cm_unique_suffix}}Device device)
{
  std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < device.neuron_{{concentration_name}}_concentration_count)
  {
      device.update(i);
  }
}

__global__
void {{concentration_name}}_device_update_block({{concentration_name}}{{cm_unique_suffix}}Device device)
{
  std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < device.neuron_{{concentration_name}}_concentration_count)
  {
      device.update_block(i);
  }
}

__global__
void {{concentration_name}}_device_self_spike_block({{concentration_name}}{{cm_unique_suffix}}Device device)
{
  std::size_t i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < device.neuron_{{concentration_name}}_concentration_count && device.global_self_spikes[0])
  {
      device.self_spike_block(i);
  }
}

void {{concentration_name}}{{cm_unique_suffix}}::f_numstep(std::vector< double > v_comp {% for ode in concentration_info["Dependencies"]["concentrations"] %}, std::vector< double > {{ode.lhs.name}}{% endfor %}{% if concentration_info["Dependencies"]["receptors"]|length %}
                        {% endif %}{% for inline in concentration_info["Dependencies"]["receptors"] %}, std::vector< double > {{inline.variable_name}}{% endfor %}{% if concentration_info["Dependencies"]["channels"]|length %}
                        {% endif %}{% for inline in concentration_info["Dependencies"]["channels"] %}, std::vector< double > {{inline.variable_name}}{% endfor %}{% if concentration_info["Dependencies"]["continuous"]|length %}
                        {% endif %}{% for inline in concentration_info["Dependencies"]["continuous"] %}, std::vector< double > {{inline.variable_name}}{% endfor %})
{
  if (neuron_{{ concentration_name }}_concentration_count == 0)
  {
    return;
  }

  cudaMemcpy(GPU_v_comp, v_comp.data(), neuron_{{concentration_name}}_concentration_count * sizeof(double), cudaMemcpyHostToDevice);

  const int threads_per_block = 256;
  const int blocks = (neuron_{{concentration_name}}_concentration_count + threads_per_block - 1) / threads_per_block;
  {{concentration_name}}{{cm_unique_suffix}}Device device{GPU_{{concentration_name}}_vars, GPU_{{concentration_name}}_param, GPU_self_spikes, GPU_time_resolution, neuron_{{concentration_name}}_concentration_count};
  {{concentration_name}}_device_update<<<blocks, threads_per_block>>>(device);
  cudaDeviceSynchronize();

  cudaMemcpy({{concentration_name}}.data(), GPU_{{concentration_name}}, neuron_{{concentration_name}}_concentration_count * sizeof(double), cudaMemcpyDeviceToHost);

    {%- for variable_name, variable_info in concentration_info["States"].items() %}
  cudaMemcpy({{ variable_name }}.data(), GPU_{{ variable_name }}, neuron_{{concentration_name}}_concentration_count * sizeof(double), cudaMemcpyDeviceToHost);
    {%- endfor %}

  f_update();
}

