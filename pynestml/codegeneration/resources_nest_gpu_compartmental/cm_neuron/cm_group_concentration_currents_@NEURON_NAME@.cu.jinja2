        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  GPU_{{state_variable_name}} = GPU_{{concentration_name}}_vars + neuron_{{concentration_name}}_concentration_count * i_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    {%- for param_name, param_declaration in concentration_info["Parameters"].items() %}
  GPU_{{param_name}} = GPU_{{concentration_name}}_param + neuron_{{concentration_name}}_concentration_count * i_{{param_name}};
    {%- endfor %}

    {%- for internal_name, internal_declaration in concentration_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
  GPU_{{variable.name}} = GPU_{{concentration_name}}_param + neuron_{{concentration_name}}_concentration_count * i_{{variable.name}};
    {%- endfor %}

  cudaMemcpy(GPU_v_comp, v_comp_conc_.data(), neuron_{{concentration_name}}_concentration_count*sizeof(double), cudaMemcpyHostToDevice);
  cudaMemcpy(GPU_{{concentration_name}}, {{concentration_name}}.data(), neuron_{{concentration_name}}_concentration_count*sizeof(double), cudaMemcpyHostToDevice);

    {%- for variable_name, variable_info in concentration_info["States"].items() %}
  cudaMemcpy(GPU_{{ variable_name }}, {{ variable_name }}.data(), neuron_{{concentration_name}}_concentration_count*sizeof(double), cudaMemcpyHostToDevice);
    {%- endfor %}

    {%- for ode_variable, ode_info in concentration_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
  cudaMemcpy(GPU_{{propagator}}, {{propagator}}.data(), neuron_{{concentration_name}}_concentration_count*sizeof(double), cudaMemcpyHostToDevice);
      {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in concentration_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
