namespace cm_hines{{cm_unique_suffix}}
{
// Host checks and CUDA kernels use these same scalar routines. Child order,
// elimination order, voltage layout, and threshold history match plain Hines.
//
// The sweeps operate on data stored in breadth-first order so consecutive
// threads read consecutive memory. perm maps a compact global compartment
// index to its BFS position (the down-sweep visitation order); the inverse is
// downsweep_nodes itself. Voltage always stays in the original population
// layout and is never permuted.
#ifdef __CUDACC__
__host__ __device__
#endif
inline void downsweep_node(int node, const int* child_offsets,
                           const int* child_indices, const float* hh,
                           float* gg, float* ff, const int* perm)
{
  const int np = perm[node];
  float node_g = gg[np];
  float node_f = ff[np];
  for (int child_entry = child_offsets[node + 1] - 1; child_entry >= child_offsets[node]; --child_entry)
  {
    const int child = child_indices[child_entry];
    const int cp = perm[child];
    const float factor = hh[cp] / gg[cp];
    node_g -= hh[cp] * factor;
    node_f -= ff[cp] * factor;
  }
  gg[np] = node_g;
  ff[np] = node_f;
}

#ifdef __CUDACC__
__host__ __device__
#endif
// Solve the root voltage from the fully eliminated diagonal/rhs and update the
// spike history. Root is the neuron's local compartment 0.
#ifdef __CUDACC__
__host__ __device__
#endif
inline void solve_root(int i_neuron, float* population_vars,
                       int n_var, int compartment_count,
                       int compartment_voltage_base_index,
                       const float* gg, const float* ff, const int* perm,
                       const float* thresholds, int* self_spikes,
                       bool* above_threshold)
{
  const int root = i_neuron * compartment_count;
  const int root_bfs = perm[root];
  float* compartment_voltages =
    population_vars + i_neuron * n_var + compartment_voltage_base_index;
  compartment_voltages[0] = ff[root_bfs] / gg[root_bfs];
  // Remember the last threshold decision across externally assigned voltages,
  // matching the CPU compartmental neuron's thr_mem.
  const bool above = compartment_voltages[0] >= thresholds[i_neuron];
  self_spikes[i_neuron] = above && !above_threshold[i_neuron];
  above_threshold[i_neuron] = above;
}

// Compute one non-root compartment's voltage from its parent's already-solved
// voltage. i is the global compact index; voltage is written to the original
// population layout, never permuted.
#ifdef __CUDACC__
__host__ __device__
#endif
inline void upsweep_node(int i_neuron, float* population_vars,
                         int n_var, int compartment_count,
                         int compartment_voltage_base_index,
                         const float* gg, const float* ff, const float* hh,
                         const int* parent_index, const int* perm, int i)
{
  const int compartment_base = i_neuron * compartment_count;
  float* compartment_voltages =
    population_vars + i_neuron * n_var + compartment_voltage_base_index;
  const int parent = parent_index[i];
  const int parent_local = parent - compartment_base;
  const float parent_v = parent >= 0 ? compartment_voltages[parent_local] : 0.0f;
  compartment_voltages[i - compartment_base] =
    (ff[perm[i]] - parent_v * hh[perm[i]]) / gg[perm[i]];
}
}
