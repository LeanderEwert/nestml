  void ensure_device_shared_buffers(int compartment_count)
  {
    if (compartment_count <= 0)
    {
      return;
    }
    {%- for ion_channel_name, channel_info in chan_info.items() %}
    if (GPU_{{ion_channel_name}}{{channel_suffix}}_shared_current == nullptr)
    {
      cudaMalloc(&GPU_{{ion_channel_name}}{{channel_suffix}}_shared_current, compartment_count * sizeof(float));
      cudaMemset(GPU_{{ion_channel_name}}{{channel_suffix}}_shared_current, 0, compartment_count * sizeof(float));
    }
    {% endfor -%}
    {%- for concentration_name, concentration_info in conc_info.items() %}
    if (GPU_{{concentration_name}}{{concentration_suffix}}_shared_concentration == nullptr)
    {
      cudaMalloc(&GPU_{{concentration_name}}{{concentration_suffix}}_shared_concentration, compartment_count * sizeof(float));
      cudaMemset(GPU_{{concentration_name}}{{concentration_suffix}}_shared_concentration, 0, compartment_count * sizeof(float));
    }
    {% endfor -%}
    {%- for receptor_name, receptor_info in recs_info.items() %}
    if (GPU_{{receptor_name}}{{receptor_suffix}}_shared_current == nullptr)
    {
      cudaMalloc(&GPU_{{receptor_name}}{{receptor_suffix}}_shared_current, compartment_count * sizeof(float));
      cudaMemset(GPU_{{receptor_name}}{{receptor_suffix}}_shared_current, 0, compartment_count * sizeof(float));
    }
    {% endfor -%}
    {%- for receptor_name, receptor_info in recs_info.items() %}
    {%- for synapse_name, synapse_info in syns_info.items() %}
    if (GPU_{{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}_shared_current == nullptr)
    {
      cudaMalloc(&GPU_{{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}_shared_current, compartment_count * sizeof(float));
      cudaMemset(GPU_{{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}_shared_current, 0, compartment_count * sizeof(float));
    }
    {% endfor -%}
    {% endfor -%}
    {%- for continuous_name, continuous_info in con_in_info.items() %}
    if (GPU_{{continuous_name}}{{continuous_suffix}}_shared_current == nullptr)
    {
      cudaMalloc(&GPU_{{continuous_name}}{{continuous_suffix}}_shared_current, compartment_count * sizeof(float));
      cudaMemset(GPU_{{continuous_name}}{{continuous_suffix}}_shared_current, 0, compartment_count * sizeof(float));
    }
    {% endfor -%}
  }

  void refresh_device_dependency_buffers(int compartment_count)
  {
    ensure_device_shared_buffers(compartment_count);
    {%- for ion_channel_name, channel_info in chan_info.items() %}
    cudaMemset(GPU_{{ion_channel_name}}{{channel_suffix}}_shared_current, 0, compartment_count * sizeof(float));
    {{ion_channel_name}}{{channel_suffix}}.add_total_current_to_device(GPU_{{ion_channel_name}}{{channel_suffix}}_shared_current, compartment_count);
    {% endfor -%}
    {%- for concentration_name, concentration_info in conc_info.items() %}
    cudaMemset(GPU_{{concentration_name}}{{concentration_suffix}}_shared_concentration, 0, compartment_count * sizeof(float));
    {{concentration_name}}{{concentration_suffix}}.add_concentrations_to_device(GPU_{{concentration_name}}{{concentration_suffix}}_shared_concentration, compartment_count);
    {% endfor -%}
    {%- for receptor_name, receptor_info in recs_info.items() %}
    cudaMemset(GPU_{{receptor_name}}{{receptor_suffix}}_shared_current, 0, compartment_count * sizeof(float));
    {{receptor_name}}{{receptor_suffix}}.add_total_current_to_device(GPU_{{receptor_name}}{{receptor_suffix}}_shared_current, compartment_count);
      {%- for synapse_name, synapse_info in syns_info.items() %}
    cudaMemset(GPU_{{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}_shared_current, 0, compartment_count * sizeof(float));
    {{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}.add_total_current_to_device(GPU_{{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}_shared_current, compartment_count);
    {{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}.add_total_current_to_device(GPU_{{receptor_name}}{{receptor_suffix}}_shared_current, compartment_count);
      {% endfor -%}
    {% endfor -%}
    {%- for continuous_name, continuous_info in con_in_info.items() %}
    cudaMemset(GPU_{{continuous_name}}{{continuous_suffix}}_shared_current, 0, compartment_count * sizeof(float));
    {% endfor -%}
    cudaDeviceSynchronize();
  }

  void init_pointers(int* global_self_spikes, double* global_time_resolution)
  {
    {%- for ion_channel_name, channel_info in chan_info.items() %}
    {{ion_channel_name}}{{channel_suffix}}.init_pointers(global_self_spikes, global_time_resolution);
    {% endfor -%}
    {%- for concentration_name, concentration_info in conc_info.items() %}
    {{concentration_name}}{{concentration_suffix}}.init_pointers(global_self_spikes, global_time_resolution);
    {% endfor -%}
    {%- for receptor_name, receptor_info in recs_info.items() %}
    {{receptor_name}}{{receptor_suffix}}.init_pointers(global_self_spikes, global_time_resolution);
    {% endfor -%}
    {%- for receptor_name, receptor_info in recs_info.items() %}
    {%- for synapse_name, synapse_info in syns_info.items() %}
    {{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}.init_pointers(global_self_spikes, global_time_resolution);
    {% endfor -%}
    {% endfor -%}
    {%- for continuous_name, continuous_info in con_in_info.items() %}
    {{continuous_name}}{{continuous_suffix}}.init_pointers(global_self_spikes, global_time_resolution);
    {% endfor -%}
  };

  void init_recordable_pointers(float* var_arr, int n_var, int i_neuron, int base_index, int max_recordables)
  {
    int recordable_offset = base_index;

    {%- for ion_channel_name, channel_info in chan_info.items() %}
    {{ion_channel_name}}{{channel_suffix}}.init_recordable_pointers(var_arr, n_var, i_neuron, recordable_offset, max_recordables);
    recordable_offset += max_recordables * ({{channel_info["States"]|length}} + 1);
    {% endfor -%}

    {%- for concentration_name, concentration_info in conc_info.items() %}
    {{concentration_name}}{{concentration_suffix}}.init_recordable_pointers(var_arr, n_var, i_neuron, recordable_offset, max_recordables);
    recordable_offset += max_recordables * ({{concentration_info["States"]|length}} + 1);
    {% endfor -%}

    {%- for receptor_name, receptor_info in recs_info.items() %}
    {{receptor_name}}{{receptor_suffix}}.init_recordable_pointers(var_arr, n_var, i_neuron, recordable_offset, max_recordables);
    recordable_offset += max_recordables * ({{receptor_info["States"]|length}} + 2);
    {% endfor -%}

    {%- for continuous_name, continuous_info in con_in_info.items() %}
    {{continuous_name}}{{continuous_suffix}}.init_recordable_pointers(var_arr, n_var, i_neuron, recordable_offset, max_recordables);
    recordable_offset += max_recordables * ({{continuous_info["States"]|length}} + 1);
    {% endfor -%}
  };

  void init_base_arrays(float* var_arr, float* param_arr, int n_var, int n_param, int i_neuron, int base_var_index, int base_param_index, int max_recordables)
  {
    int var_offset = base_var_index;
    int param_offset = base_param_index;

    {%- for ion_channel_name, channel_info in chan_info.items() %}
    {{ion_channel_name}}{{channel_suffix}}.init_base_arrays(var_arr, param_arr, n_var, n_param, i_neuron, var_offset, param_offset, {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count);
    var_offset += {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count * N_{{ion_channel_name}}_VARS;
    param_offset += {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count * N_{{ion_channel_name}}_PARAM;
    {% endfor -%}

    {%- for concentration_name, concentration_info in conc_info.items() %}
    {{concentration_name}}{{concentration_suffix}}.init_base_arrays(var_arr, param_arr, n_var, n_param, i_neuron, var_offset, param_offset, {{concentration_name}}{{concentration_suffix}}.neuron_{{concentration_name}}_concentration_count);
    var_offset += {{concentration_name}}{{concentration_suffix}}.neuron_{{concentration_name}}_concentration_count * N_{{concentration_name}}_VARS;
    param_offset += {{concentration_name}}{{concentration_suffix}}.neuron_{{concentration_name}}_concentration_count * N_{{concentration_name}}_PARAM;
    {% endfor -%}

    {%- for receptor_name, receptor_info in recs_info.items() %}
    {{receptor_name}}{{receptor_suffix}}.init_base_arrays(var_arr, param_arr, n_var, n_param, i_neuron, var_offset, param_offset, {{receptor_name}}{{receptor_suffix}}.neuron_{{receptor_name}}_receptor_count);
    var_offset += {{receptor_name}}{{receptor_suffix}}.neuron_{{receptor_name}}_receptor_count * ({{receptor_info["States"]|length}}
      {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
        + {{convolution_info["analytic_solution"]["propagators"]|length}}
      {%- endfor %}
      {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
        + {{convolution_info["analytic_solution"]["kernel_states"]|length}}
      {%- endfor %}
      + 7);
    param_offset += {{receptor_name}}{{receptor_suffix}}.neuron_{{receptor_name}}_receptor_count * ({{receptor_info["Parameters"]|length}} + {{receptor_info["internals_used_declared"]|length}});
    {% endfor -%}

    {%- for continuous_name, continuous_info in con_in_info.items() %}
    {{continuous_name}}{{continuous_suffix}}.init_base_arrays(var_arr, param_arr, n_var, n_param, i_neuron, var_offset, param_offset, {{continuous_name}}{{continuous_suffix}}.neuron_{{continuous_name}}_continuous_input_count);
    var_offset += {{continuous_name}}{{continuous_suffix}}.neuron_{{continuous_name}}_continuous_input_count * ({{continuous_info["States"]|length}} + 1);
    {% endfor -%}
  };

