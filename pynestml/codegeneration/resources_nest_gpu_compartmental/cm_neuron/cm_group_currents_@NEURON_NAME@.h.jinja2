    {% endfor -%}
    {%- for receptor_name, receptor_info in recs_info.items() %}
    {{receptor_name}}{{receptor_suffix}}.calibrate(time_resolution);
    {% endfor -%}
    {%- for receptor_name, receptor_info in recs_info.items() %}
    {%- for synapse_name, synapse_info in syns_info.items() %}
    {{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}.calibrate(time_resolution);
    {% endfor -%}
    {% endfor -%}
    {%- for continuous_name, continuous_info in con_in_info.items() %}
    {{continuous_name}}{{continuous_suffix}}.calibrate(time_resolution);
    {% endfor -%}
{%- else %}
    {%- for ion_channel_name, channel_info in chan_info.items() %}
    {{ion_channel_name}}{{channel_suffix}}.pre_run_hook(time_resolution);
    {% endfor -%}
    {%- for concentration_name, concentration_info in conc_info.items() %}
    {{concentration_name}}{{concentration_suffix}}.pre_run_hook(time_resolution);
    {% endfor -%}
    {%- for receptor_name, receptor_info in recs_info.items() %}
    {{receptor_name}}{{receptor_suffix}}.pre_run_hook(time_resolution);
    {% endfor -%}
    {%- for receptor_name, receptor_info in recs_info.items() %}
    {%- for synapse_name, synapse_info in syns_info.items() %}
    {{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}.pre_run_hook(time_resolution);
    {% endfor -%}
    {% endfor -%}
    {%- for continuous_name, continuous_info in con_in_info.items() %}
