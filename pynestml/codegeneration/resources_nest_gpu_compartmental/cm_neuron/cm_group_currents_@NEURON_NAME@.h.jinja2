{%- if tracing %}/* generated by {{self._TemplateReference__context.name}} */ {% endif -%}
#ifndef GROUP_CURRENTS_NEAT_H_{{cm_unique_suffix | upper }}
#define GROUP_CURRENTS_NEAT_H_{{cm_unique_suffix | upper }}

#include <stdlib.h>
#include <vector>
#include <cmath>
#include <string>
#include <nlohmann/json.hpp>

#include <iostream>
#include <stdexcept>
#include <algorithm>
#include <cuda_runtime.h>

#include "{{neuronSpecificFileNamesCmSyns["channelcurrents"]}}.h"
#include "{{neuronSpecificFileNamesCmSyns["concentrationcurrents"]}}.h"
#include "{{neuronSpecificFileNamesCmSyns["receptorcurrents"]}}.h"
#include "{{neuronSpecificFileNamesCmSyns["continuouscurrents"]}}.h"

///////////////////////////////////////////// currents

{%- set channel_suffix = "_chan_" %}
{%- set concentration_suffix = "_conc_" %}
{%- set receptor_suffix = "_syn_" %}
{%- set continuous_suffix = "_con_in_" %}

class GroupCurrents{{cm_unique_suffix}} {
private:

    bool initialized = false;
  //mechanisms
  // ion channels
  {%- for ion_channel_name, channel_info in chan_info.items() %}
  {{ion_channel_name}}{{cm_unique_suffix}} {{ion_channel_name}}{{channel_suffix}};
  {% endfor -%}

  // concentrations
  {%- for concentration_name, concentration_info in conc_info.items() %}
  {{concentration_name}}{{cm_unique_suffix}} {{concentration_name}}{{concentration_suffix}};
  {% endfor -%}

  // receptors
  {%- for receptor_name, receptor_info in recs_info.items() %}
  {{receptor_name}}{{cm_unique_suffix}} {{receptor_name}}{{receptor_suffix}};
  {% endfor -%}

  // receptors with synapses
{%- for receptor_name, receptor_info in recs_info.items() %}
    {%- for synapse_name, synapse_info in syns_info.items() %}
  {{receptor_name}}{{cm_unique_suffix}}_con_{{synapse_name}} {{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}};
    {% endfor -%}
{% endfor -%}
  // continuous inputs
  {%- for continuous_name, continuous_info in con_in_info.items() %}
  {{continuous_name}}{{cm_unique_suffix}} {{continuous_name}}{{continuous_suffix}};
  {% endfor -%}

  //number of compartments
  std::size_t compartment_number = 0;

  //interdependency shared reference vectors and consecutive area vectors
  // ion channels
  {%- for ion_channel_name, channel_info in chan_info.items() %}
  std::vector < double > {{ion_channel_name}}{{channel_suffix}}_shared_current;
  std::vector < std::pair< std::size_t, int > > {{ion_channel_name}}{{channel_suffix}}_con_area;
  float* GPU_{{ion_channel_name}}{{channel_suffix}}_shared_current = nullptr;
  {% endfor -%}

  // concentrations
  {%- for concentration_name, concentration_info in conc_info.items() %}
  std::vector < double > {{concentration_name}}{{concentration_suffix}}_shared_concentration;
  std::vector < std::pair< std::size_t, int > > {{concentration_name}}{{concentration_suffix}}_con_area;
  float* GPU_{{concentration_name}}{{concentration_suffix}}_shared_concentration = nullptr;
  {% endfor -%}

  // receptors
  {%- for receptor_name, receptor_info in recs_info.items() %}
  std::vector < double > {{receptor_name}}{{receptor_suffix}}_shared_current;
  std::vector < std::pair< std::size_t, int > > {{receptor_name}}{{receptor_suffix}}_con_area;
  float* GPU_{{receptor_name}}{{receptor_suffix}}_shared_current = nullptr;
  {% endfor -%}

  // receptors with synapses
  {%- for receptor_name, receptor_info in recs_info.items() %}
  {%- for synapse_name, synapse_info in syns_info.items() %}
  std::vector < double > {{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}_shared_current;
  std::vector < std::pair< std::size_t, int > > {{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}_con_area;
  float* GPU_{{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}_shared_current = nullptr;
  {% endfor -%}
  {% endfor -%}

// continuous inputs
  {%- for continuous_name, continuous_info in con_in_info.items() %}
  std::vector < double > {{continuous_name}}{{continuous_suffix}}_shared_current;
  std::vector < std::pair< std::size_t, int > > {{continuous_name}}{{continuous_suffix}}_con_area;
  float* GPU_{{continuous_name}}{{continuous_suffix}}_shared_current = nullptr;
  {% endfor -%}

  //compartment gi states
  std::vector < std::pair < double, double > > comps_gi;

public:
  GroupCurrents{{cm_unique_suffix}}(){};
  ~GroupCurrents{{cm_unique_suffix}}(){};

  void initialize_population_runtime(const std::vector<GroupCurrents{{cm_unique_suffix}}*>& sources,
                                     float* var_arr,
                                     float* param_arr,
                                     int n_var,
                                     int n_param,
                                     int neuron_count,
                                     int compartment_count,
                                     int compartment_voltage_base_index,
                                     int* global_self_spikes,
                                     double* global_time_resolution)
  {
    if (sources.empty())
    {
      throw std::runtime_error("Cannot initialize an empty compartmental population");
    }

    {%- for ion_channel_name, channel_info in chan_info.items() %}
    {
      const auto& layout_source = sources.front()->{{ion_channel_name}}{{channel_suffix}};
      const int count = static_cast<int>(layout_source.neuron_{{ion_channel_name}}_channel_count);
      std::vector<int> associations;
      associations.reserve(neuron_count * count);
      for (int i_neuron = 0; i_neuron < neuron_count; ++i_neuron)
      {
        const auto& local = sources[i_neuron]->{{ion_channel_name}}{{channel_suffix}}.compartment_association;
        if (static_cast<int>(local.size()) != count)
        {
          throw std::runtime_error("All neurons in a compartmental GPU population must have the same {{ion_channel_name}} channel count");
        }
        for (const std::size_t local_compartment : local)
        {
          if (local_compartment >= static_cast<std::size_t>(compartment_count))
          {
            throw std::runtime_error("Channel compartment association is outside the owning neuron");
          }
          associations.push_back(i_neuron * compartment_count + static_cast<int>(local_compartment));
        }
      }
      {{ion_channel_name}}{{channel_suffix}}.configure_population(
        var_arr, param_arr, n_var, n_param, neuron_count, compartment_count,
        compartment_voltage_base_index, count,
        layout_source.get_var_base_index(),
        layout_source.get_param_base_index(),
        associations, global_self_spikes, global_time_resolution);
    }
    {% endfor -%}

    {%- for concentration_name, concentration_info in conc_info.items() %}
    {
      const auto& layout_source = sources.front()->{{concentration_name}}{{concentration_suffix}};
      const int count = static_cast<int>(layout_source.neuron_{{concentration_name}}_concentration_count);
      std::vector<int> associations;
      associations.reserve(neuron_count * count);
      for (int i_neuron = 0; i_neuron < neuron_count; ++i_neuron)
      {
        const auto& local = sources[i_neuron]->{{concentration_name}}{{concentration_suffix}}.compartment_association;
        if (static_cast<int>(local.size()) != count)
        {
          throw std::runtime_error("All neurons in a compartmental GPU population must have the same {{concentration_name}} concentration count");
        }
        for (const std::size_t local_compartment : local)
        {
          if (local_compartment >= static_cast<std::size_t>(compartment_count))
          {
            throw std::runtime_error("Concentration compartment association is outside the owning neuron");
          }
          associations.push_back(i_neuron * compartment_count + static_cast<int>(local_compartment));
        }
      }
      {{concentration_name}}{{concentration_suffix}}.configure_population(
        var_arr, param_arr, n_var, n_param, neuron_count, compartment_count,
        compartment_voltage_base_index, count,
        layout_source.get_var_base_index(),
        layout_source.get_param_base_index(),
        associations, global_self_spikes, global_time_resolution);
    }
    {% endfor -%}

    {%- for receptor_name, receptor_info in recs_info.items() %}
    {
      const auto& layout_source = sources.front()->{{receptor_name}}{{receptor_suffix}};
      const int count = static_cast<int>(layout_source.neuron_{{receptor_name}}_receptor_count);
      std::vector<int> associations;
      std::vector<int> receptor_indices;
      associations.reserve(neuron_count * count);
      receptor_indices.reserve(neuron_count * count);
      for (int i_neuron = 0; i_neuron < neuron_count; ++i_neuron)
      {
        const auto& local = sources[i_neuron]->{{receptor_name}}{{receptor_suffix}}.compartment_association;
        const auto& local_receptors = sources[i_neuron]->{{receptor_name}}{{receptor_suffix}}.get_receptor_indices();
        if (static_cast<int>(local.size()) != count || static_cast<int>(local_receptors.size()) != count)
        {
          throw std::runtime_error("All neurons in a compartmental GPU population must have the same {{receptor_name}} receptor count");
        }
        for (int i = 0; i < count; ++i)
        {
          if (local[i] >= static_cast<std::size_t>(compartment_count))
          {
            throw std::runtime_error("Receptor compartment association is outside the owning neuron");
          }
          associations.push_back(i_neuron * compartment_count + static_cast<int>(local[i]));
          receptor_indices.push_back(static_cast<int>(local_receptors[i]));
        }
      }
      {{receptor_name}}{{receptor_suffix}}.configure_population(
        var_arr, param_arr, n_var, n_param, neuron_count, compartment_count,
        compartment_voltage_base_index, count,
        layout_source.get_var_base_index(),
        layout_source.get_param_base_index(),
        associations, receptor_indices, global_self_spikes, global_time_resolution);
    }
    {% endfor -%}

    {%- for receptor_name, receptor_info in recs_info.items() %}
    {%- for synapse_name, synapse_info in syns_info.items() %}
    {
      const auto& layout_source = sources.front()->{{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}};
      const int count = static_cast<int>(layout_source.neuron_{{receptor_name}}_receptor_count);
      std::vector<int> associations;
      std::vector<int> receptor_indices;
      associations.reserve(neuron_count * count);
      receptor_indices.reserve(neuron_count * count);
      for (int i_neuron = 0; i_neuron < neuron_count; ++i_neuron)
      {
        const auto& local = sources[i_neuron]->{{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}.compartment_association;
        const auto& local_receptors = sources[i_neuron]->{{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}.get_receptor_indices();
        if (static_cast<int>(local.size()) != count || static_cast<int>(local_receptors.size()) != count)
        {
          throw std::runtime_error("All neurons in a compartmental GPU population must have the same {{receptor_name}} receptor count");
        }
        for (int i = 0; i < count; ++i)
        {
          if (local[i] >= static_cast<std::size_t>(compartment_count))
          {
            throw std::runtime_error("Receptor compartment association is outside the owning neuron");
          }
          associations.push_back(i_neuron * compartment_count + static_cast<int>(local[i]));
          receptor_indices.push_back(static_cast<int>(local_receptors[i]));
        }
      }
      {{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}.configure_population(
        var_arr, param_arr, n_var, n_param, neuron_count, compartment_count,
        compartment_voltage_base_index, count,
        layout_source.get_var_base_index(),
        layout_source.get_param_base_index(),
        associations, receptor_indices, global_self_spikes, global_time_resolution);
    }
    {% endfor -%}
    {% endfor -%}

    ensure_device_shared_buffers(neuron_count * compartment_count);
  }

  void ensure_device_shared_buffers(int compartment_count)
  {
    if (compartment_count <= 0)
    {
      return;
    }
    {%- for ion_channel_name, channel_info in chan_info.items() %}
    {%- if channel_info["requires_shared_current"] %}
    if (GPU_{{ion_channel_name}}{{channel_suffix}}_shared_current == nullptr)
    {
      cudaMalloc(&GPU_{{ion_channel_name}}{{channel_suffix}}_shared_current, compartment_count * sizeof(float));
      cudaMemset(GPU_{{ion_channel_name}}{{channel_suffix}}_shared_current, 0, compartment_count * sizeof(float));
    }
    {%- endif %}
    {% endfor -%}
    {%- for concentration_name, concentration_info in conc_info.items() %}
    {%- if concentration_info["requires_shared_concentration"] %}
    if (GPU_{{concentration_name}}{{concentration_suffix}}_shared_concentration == nullptr)
    {
      cudaMalloc(&GPU_{{concentration_name}}{{concentration_suffix}}_shared_concentration, compartment_count * sizeof(float));
      cudaMemset(GPU_{{concentration_name}}{{concentration_suffix}}_shared_concentration, 0, compartment_count * sizeof(float));
    }
    {%- endif %}
    {% endfor -%}
    {%- for receptor_name, receptor_info in recs_info.items() %}
    {%- if receptor_info["requires_shared_current"] %}
    if (GPU_{{receptor_name}}{{receptor_suffix}}_shared_current == nullptr)
    {
      cudaMalloc(&GPU_{{receptor_name}}{{receptor_suffix}}_shared_current, compartment_count * sizeof(float));
      cudaMemset(GPU_{{receptor_name}}{{receptor_suffix}}_shared_current, 0, compartment_count * sizeof(float));
    }
    {%- endif %}
    {% endfor -%}
    {%- for receptor_name, receptor_info in recs_info.items() %}
    {%- if receptor_info["requires_shared_current"] %}
    {%- for synapse_name, synapse_info in syns_info.items() %}
    if (GPU_{{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}_shared_current == nullptr)
    {
      cudaMalloc(&GPU_{{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}_shared_current, compartment_count * sizeof(float));
      cudaMemset(GPU_{{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}_shared_current, 0, compartment_count * sizeof(float));
    }
    {% endfor -%}
    {%- endif %}
    {% endfor -%}
    {%- for continuous_name, continuous_info in con_in_info.items() %}
    {%- if continuous_info["requires_shared_current"] %}
    if (GPU_{{continuous_name}}{{continuous_suffix}}_shared_current == nullptr)
    {
      cudaMalloc(&GPU_{{continuous_name}}{{continuous_suffix}}_shared_current, compartment_count * sizeof(float));
      cudaMemset(GPU_{{continuous_name}}{{continuous_suffix}}_shared_current, 0, compartment_count * sizeof(float));
    }
    {%- endif %}
    {% endfor -%}
  }

  void refresh_device_dependency_buffers(int compartment_count, cudaStream_t stream)
  {
    {%- if has_mechanism_dependencies %}
    {%- for ion_channel_name, channel_info in chan_info.items() %}
    {%- if channel_info["requires_shared_current"] %}
    cudaMemsetAsync(GPU_{{ion_channel_name}}{{channel_suffix}}_shared_current, 0, compartment_count * sizeof(float), stream);
    {{ion_channel_name}}{{channel_suffix}}.add_total_current_to_device(GPU_{{ion_channel_name}}{{channel_suffix}}_shared_current, compartment_count, stream);
    {%- endif %}
    {% endfor -%}
    {%- for concentration_name, concentration_info in conc_info.items() %}
    {%- if concentration_info["requires_shared_concentration"] %}
    cudaMemsetAsync(GPU_{{concentration_name}}{{concentration_suffix}}_shared_concentration, 0, compartment_count * sizeof(float), stream);
    {{concentration_name}}{{concentration_suffix}}.add_concentrations_to_device(GPU_{{concentration_name}}{{concentration_suffix}}_shared_concentration, compartment_count, stream);
    {%- endif %}
    {% endfor -%}
    {%- for receptor_name, receptor_info in recs_info.items() %}
    {%- if receptor_info["requires_shared_current"] %}
    cudaMemsetAsync(GPU_{{receptor_name}}{{receptor_suffix}}_shared_current, 0, compartment_count * sizeof(float), stream);
    {{receptor_name}}{{receptor_suffix}}.add_total_current_to_device(GPU_{{receptor_name}}{{receptor_suffix}}_shared_current, compartment_count, stream);
      {%- for synapse_name, synapse_info in syns_info.items() %}
    cudaMemsetAsync(GPU_{{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}_shared_current, 0, compartment_count * sizeof(float), stream);
    {{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}.add_total_current_to_device(GPU_{{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}_shared_current, compartment_count, stream);
    {{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}.add_total_current_to_device(GPU_{{receptor_name}}{{receptor_suffix}}_shared_current, compartment_count, stream);
      {% endfor -%}
    {%- endif %}
    {% endfor -%}
    {%- for continuous_name, continuous_info in con_in_info.items() %}
    {%- if continuous_info["requires_shared_current"] %}
    cudaMemsetAsync(GPU_{{continuous_name}}{{continuous_suffix}}_shared_current, 0, compartment_count * sizeof(float), stream);
    {%- endif %}
    {% endfor -%}
    {%- endif %}
  }

  void init_base_arrays(float* var_arr, float* param_arr, int n_var, int n_param, int i_neuron, int base_var_index, int base_param_index)
  {
    int var_offset = base_var_index;
    int param_offset = base_param_index;

    {%- for ion_channel_name, channel_info in chan_info.items() %}
    {{ion_channel_name}}{{channel_suffix}}.init_base_arrays(var_arr, param_arr, n_var, n_param, i_neuron, var_offset, param_offset, {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count);
    var_offset += {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count * N_{{ion_channel_name}}_VARS;
    param_offset += {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count * N_{{ion_channel_name}}_PARAM;
    {% endfor -%}

    {%- for concentration_name, concentration_info in conc_info.items() %}
    {{concentration_name}}{{concentration_suffix}}.init_base_arrays(var_arr, param_arr, n_var, n_param, i_neuron, var_offset, param_offset, {{concentration_name}}{{concentration_suffix}}.neuron_{{concentration_name}}_concentration_count);
    var_offset += {{concentration_name}}{{concentration_suffix}}.neuron_{{concentration_name}}_concentration_count * N_{{concentration_name}}_VARS;
    param_offset += {{concentration_name}}{{concentration_suffix}}.neuron_{{concentration_name}}_concentration_count * N_{{concentration_name}}_PARAM;
    {% endfor -%}

    {%- for receptor_name, receptor_info in recs_info.items() %}
    {{receptor_name}}{{receptor_suffix}}.init_base_arrays(var_arr, param_arr, n_var, n_param, i_neuron, var_offset, param_offset, {{receptor_name}}{{receptor_suffix}}.neuron_{{receptor_name}}_receptor_count);
    var_offset += {{receptor_name}}{{receptor_suffix}}.neuron_{{receptor_name}}_receptor_count * ({{receptor_info["States"]|length}}
      {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
        + {{convolution_info["analytic_solution"]["propagators"]|length}}
      {%- endfor %}
      {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
        + {{convolution_info["analytic_solution"]["kernel_states"]|length}}
      {%- endfor %}
      + 7);
    param_offset += {{receptor_name}}{{receptor_suffix}}.neuron_{{receptor_name}}_receptor_count * ({{receptor_info["Parameters"]|length}} + {{receptor_info["internals_used_declared"]|length}});
    {% endfor -%}

    {%- for continuous_name, continuous_info in con_in_info.items() %}
    {{continuous_name}}{{continuous_suffix}}.init_base_arrays(var_arr, param_arr, n_var, n_param, i_neuron, var_offset, param_offset, {{continuous_name}}{{continuous_suffix}}.neuron_{{continuous_name}}_continuous_input_count);
    var_offset += {{continuous_name}}{{continuous_suffix}}.neuron_{{continuous_name}}_continuous_input_count * ({{continuous_info["States"]|length}} + 1);
    {% endfor -%}
  };

  void append_runtime_names(std::vector<std::string>& scal_var_names, std::vector<std::string>& scal_param_names) const
  {
    {%- for ion_channel_name, channel_info in chan_info.items() %}
    {%- for variable_name, variable_info in channel_info["States"].items() %}
    for (std::size_t mech_index = 0; mech_index < {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count; ++mech_index)
    {
      scal_var_names.push_back("{{variable_name}}" + std::to_string(mech_index));
    }
    {% endfor -%}
    {%- for ode_variable, ode_info in channel_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
    for (std::size_t mech_index = 0; mech_index < {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count; ++mech_index)
    {
      scal_var_names.push_back("__{{ion_channel_name}}_{{propagator}}" + std::to_string(mech_index));
    }
      {% endfor -%}
    {% endfor -%}
    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items() %}
    for (std::size_t mech_index = 0; mech_index < {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count; ++mech_index)
    {
      scal_var_names.push_back("__{{ion_channel_name}}_{{state_variable_name}}" + std::to_string(mech_index));
    }
      {% endfor -%}
    {% endfor -%}
    {%- for convolution, convolution_info in channel_info["convolutions"].items() %}
      {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items() %}
    for (std::size_t mech_index = 0; mech_index < {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count; ++mech_index)
    {
      scal_var_names.push_back("__{{ion_channel_name}}_{{state_variable_name}}" + std::to_string(mech_index));
    }
      {% endfor -%}
    {% endfor -%}
    for (std::size_t mech_index = 0; mech_index < {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count; ++mech_index)
    {
      scal_var_names.push_back("__{{ion_channel_name}}_v_comp" + std::to_string(mech_index));
    }
    for (std::size_t mech_index = 0; mech_index < {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count; ++mech_index)
    {
      scal_var_names.push_back("i_tot_{{ion_channel_name}}" + std::to_string(mech_index));
    }
    for (std::size_t mech_index = 0; mech_index < {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count; ++mech_index)
    {
      scal_var_names.push_back("__{{ion_channel_name}}_g_val" + std::to_string(mech_index));
    }
    for (std::size_t mech_index = 0; mech_index < {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count; ++mech_index)
    {
      scal_var_names.push_back("__{{ion_channel_name}}_i_val" + std::to_string(mech_index));
    }
    for (std::size_t mech_index = 0; mech_index < {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count; ++mech_index)
    {
      scal_var_names.push_back("__{{ion_channel_name}}_d_i_tot_dv" + std::to_string(mech_index));
    }
    {%- for param_name, param_declaration in channel_info["Parameters"].items() %}
    for (std::size_t mech_index = 0; mech_index < {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count; ++mech_index)
    {
      scal_param_names.push_back("{{ion_channel_name}}_{{param_name}}" + std::to_string(mech_index));
    }
    {% endfor -%}
    {%- for internal_name, internal_declaration in channel_info["Internals"].items() %}
      {%- set variable = internal_declaration["ASTVariable"] %}
    for (std::size_t mech_index = 0; mech_index < {{ion_channel_name}}{{channel_suffix}}.neuron_{{ion_channel_name}}_channel_count; ++mech_index)
    {
      scal_param_names.push_back("{{ion_channel_name}}_{{variable.name}}" + std::to_string(mech_index));
    }
    {% endfor -%}
    {% endfor -%}

    {%- for concentration_name, concentration_info in conc_info.items() %}
    {%- for variable_name, variable_info in concentration_info["States"].items() %}
    for (std::size_t mech_index = 0; mech_index < {{concentration_name}}{{concentration_suffix}}.neuron_{{concentration_name}}_concentration_count; ++mech_index)
    {
      scal_var_names.push_back("{{variable_name}}" + std::to_string(mech_index));
    }
    {% endfor -%}
    {%- for ode_variable, ode_info in concentration_info["ODEs"].items() %}
      {%- for propagator, propagator_info in ode_info["transformed_solutions"][0]["propagators"].items() %}
    for (std::size_t mech_index = 0; mech_index < {{concentration_name}}{{concentration_suffix}}.neuron_{{concentration_name}}_concentration_count; ++mech_index)
    {
      scal_var_names.push_back("__{{concentration_name}}_{{propagator}}" + std::to_string(mech_index));
