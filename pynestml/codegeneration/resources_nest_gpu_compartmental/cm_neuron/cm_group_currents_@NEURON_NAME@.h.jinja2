    {% endfor -%}
  };

  void f_numstep_device(float* shared_v_comp, float* compartment_g, float* compartment_i, int compartment_count, const long lag, float* port_input_arr, int port_input_port_step)
  {
    if (compartment_count <= 0)
    {
      return;
    }
    cudaMemset(compartment_g, 0, compartment_count * sizeof(float));
    cudaMemset(compartment_i, 0, compartment_count * sizeof(float));
    {%- if has_device_dependencies.value %}
    refresh_device_dependency_buffers(compartment_count);
    {%- endif %}

    {%- for concentration_name, concentration_info in conc_info.items() %}
    {{ concentration_name }}{{concentration_suffix}}.f_numstep_device(shared_v_comp, lag{% for ode in concentration_info["Dependencies"]["concentrations"] %}, GPU_{{ode.lhs.name}}{{concentration_suffix}}_shared_concentration{% endfor %}{% for inline in concentration_info["Dependencies"]["receptors"] %}, GPU_{{inline.variable_name}}{{receptor_suffix}}_shared_current{% endfor %}{% for inline in concentration_info["Dependencies"]["channels"] %}, GPU_{{inline.variable_name}}{{channel_suffix}}_shared_current{% endfor %}{% for inline in concentration_info["Dependencies"]["continuous"] %}, GPU_{{inline.variable_name}}{{continuous_suffix}}_shared_current{% endfor %});
    {% endfor -%}

    {%- for ion_channel_name, channel_info in chan_info.items() %}
    {{ion_channel_name}}{{channel_suffix}}.f_numstep_device(shared_v_comp, lag{% for ode in channel_info["Dependencies"]["concentrations"] %}, GPU_{{ode.lhs.name}}{{concentration_suffix}}_shared_concentration{% endfor %}{% for inline in channel_info["Dependencies"]["receptors"] %}, GPU_{{inline.variable_name}}{{receptor_suffix}}_shared_current{% endfor %}{% for inline in channel_info["Dependencies"]["channels"] %}, GPU_{{inline.variable_name}}{{channel_suffix}}_shared_current{% endfor %}{% for inline in channel_info["Dependencies"]["continuous"] %}, GPU_{{inline.variable_name}}{{continuous_suffix}}_shared_current{% endfor %});
    {{ion_channel_name}}{{channel_suffix}}.add_currents_to_device(compartment_g, compartment_i, compartment_count);
    {% endfor -%}

    {%- for receptor_name, receptor_info in recs_info.items() %}
    {{receptor_name}}{{receptor_suffix}}.f_numstep_device(shared_v_comp, lag, port_input_arr, port_input_port_step{% for ode in receptor_info["Dependencies"]["concentrations"] %}, GPU_{{ode.lhs.name}}{{concentration_suffix}}_shared_concentration{% endfor %}{% for inline in receptor_info["Dependencies"]["receptors"] %}, GPU_{{inline.variable_name}}{{receptor_suffix}}_shared_current{% endfor %}{% for inline in receptor_info["Dependencies"]["channels"] %}, GPU_{{inline.variable_name}}{{channel_suffix}}_shared_current{% endfor %}{% for inline in receptor_info["Dependencies"]["continuous"] %}, GPU_{{inline.variable_name}}{{continuous_suffix}}_shared_current{% endfor %});
    {{receptor_name}}{{receptor_suffix}}.add_currents_to_device(compartment_g, compartment_i, compartment_count);
    {% endfor -%}

    {%- for receptor_name, receptor_info in recs_info.items() %}
    {%- for synapse_name, synapse_info in syns_info.items() %}
    {%- with  %}
    {%- set conc_dep = set(receptor_info["Dependencies"]["concentrations"]).union(synapse_info["Dependencies"]["concentrations"])%}
    {%- set rec_dep = set(receptor_info["Dependencies"]["receptors"]).union(synapse_info["Dependencies"]["receptors"])%}
    {%- set chan_dep = set(receptor_info["Dependencies"]["channels"]).union(synapse_info["Dependencies"]["channels"])%}
    {%- set con_in_dep = set(receptor_info["Dependencies"]["continuous"]).union(synapse_info["Dependencies"]["continuous"])%}
    {{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}.f_numstep_device(shared_v_comp, lag, port_input_arr, port_input_port_step{% for ode in conc_dep %}, GPU_{{ode.lhs.name}}{{concentration_suffix}}_shared_concentration{% endfor %}{% for inline in rec_dep %}, GPU_{{inline.variable_name}}{{receptor_suffix}}_shared_current{% endfor %}{% for inline in chan_dep %}, GPU_{{inline.variable_name}}{{channel_suffix}}_shared_current{% endfor %}{% for inline in con_in_dep %}, GPU_{{inline.variable_name}}{{continuous_suffix}}_shared_current{% endfor %});
    {%- endwith %}
    {{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}.add_currents_to_device(compartment_g, compartment_i, compartment_count);
    {% endfor -%}
    {% endfor -%}
  };

  void postsynaptic_synaptic_processing_device(){
    {%- if has_self_spike_processing.value %}
    {%- for receptor_name, receptor_info in recs_info.items() %}
    {%- set receptor_needs_self_spike = namespace(value=false) %}
    {%- if receptor_info["Blocks"] and receptor_info["Blocks"]["SelfSpikesFunction"] and receptor_info["Blocks"]["SelfSpikesFunction"].get_stmts_body().get_stmts()|length %}
      {%- set receptor_needs_self_spike.value = true %}
    {%- endif %}
    {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
      {%- if convolution_info["spikes"]["name"] == "self_spikes" %}
        {%- set receptor_needs_self_spike.value = true %}
      {%- endif %}
    {%- endfor %}
    {%- if receptor_needs_self_spike.value %}
        {%- for synapse_name, synapse_info in syns_info.items() %}
    {{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}.postsynaptic_synaptic_processing();
    {{receptor_name}}{{receptor_suffix}}_con_{{synapse_name}}.f_self_spike();
        {% endfor -%}
    {{receptor_name}}{{receptor_suffix}}.f_self_spike();
    {%- endif %}
    {% endfor -%}
    {%- for ion_channel_name, channel_info in chan_info.items() %}
    {%- if channel_info["Blocks"] and channel_info["Blocks"]["SelfSpikesFunction"] and channel_info["Blocks"]["SelfSpikesFunction"].get_stmts_body().get_stmts()|length %}
    {{ion_channel_name}}{{channel_suffix}}.f_self_spike();
    {%- endif %}
    {% endfor -%}
    {%- for concentration_name, concentration_info in conc_info.items() %}
    {%- if concentration_info["Blocks"] and concentration_info["Blocks"]["SelfSpikesFunction"] and concentration_info["Blocks"]["SelfSpikesFunction"].get_stmts_body().get_stmts()|length %}
    {{concentration_name}}{{concentration_suffix}}.f_self_spike();
    {%- endif %}
    {% endfor -%}
    {%- for continuous_name, continuous_info in con_in_info.items() %}
    {%- if continuous_info["Blocks"] and continuous_info["Blocks"]["SelfSpikesFunction"] and continuous_info["Blocks"]["SelfSpikesFunction"].get_stmts_body().get_stmts()|length %}
    {{continuous_name}}{{continuous_suffix}}.f_self_spike();
    {%- endif %}
    {% endfor -%}
    {%- endif %}
  };
};


