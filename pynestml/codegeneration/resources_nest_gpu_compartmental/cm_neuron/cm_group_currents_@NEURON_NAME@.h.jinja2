  void f_numstep_device(float* shared_v_comp, float* compartment_g, float* compartment_i, int compartment_count, const long lag, float* port_input_arr, int port_input_arr_step, int port_input_port_step, cudaStream_t stream = nullptr)
  {
    if (compartment_count <= 0)
    {
      return;
    }
    cudaMemsetAsync(compartment_g, 0, compartment_count * sizeof(float), stream);
    cudaMemsetAsync(compartment_i, 0, compartment_count * sizeof(float), stream);
    {%- if has_mechanism_dependencies %}
    refresh_device_dependency_buffers(compartment_count, stream);
    {%- endif %}

    {%- for concentration_name, concentration_info in conc_info.items() %}
    {{ concentration_name }}{{concentration_suffix}}.f_numstep_device(shared_v_comp, lag{% for ode in concentration_info["Dependencies"]["concentrations"] %}, GPU_{{ode.lhs.name}}{{concentration_suffix}}_shared_concentration{% endfor %}{% for inline in concentration_info["Dependencies"]["receptors"] %}, GPU_{{inline.variable_name}}{{receptor_suffix}}_shared_current{% endfor %}{% for inline in concentration_info["Dependencies"]["channels"] %}, GPU_{{inline.variable_name}}{{channel_suffix}}_shared_current{% endfor %}{% for inline in concentration_info["Dependencies"]["continuous"] %}, GPU_{{inline.variable_name}}{{continuous_suffix}}_shared_current{% endfor %}, stream);
    {% endfor -%}

    {%- for ion_channel_name, channel_info in chan_info.items() %}
    {{ion_channel_name}}{{channel_suffix}}.f_numstep_device(shared_v_comp, compartment_g, compartment_i, compartment_count, lag{% for ode in channel_info["Dependencies"]["concentrations"] %}, GPU_{{ode.lhs.name}}{{concentration_suffix}}_shared_concentration{% endfor %}{% for inline in channel_info["Dependencies"]["receptors"] %}, GPU_{{inline.variable_name}}{{receptor_suffix}}_shared_current{% endfor %}{% for inline in channel_info["Dependencies"]["channels"] %}, GPU_{{inline.variable_name}}{{channel_suffix}}_shared_current{% endfor %}{% for inline in channel_info["Dependencies"]["continuous"] %}, GPU_{{inline.variable_name}}{{continuous_suffix}}_shared_current{% endfor %}, stream);
    {% endfor -%}

    {%- for receptor_name, receptor_info in recs_info.items() %}
    {{receptor_name}}{{receptor_suffix}}.f_numstep_device(shared_v_comp, compartment_g, compartment_i, compartment_count, lag, port_input_arr, port_input_arr_step, port_input_port_step{% for ode in receptor_info["Dependencies"]["concentrations"] %}, GPU_{{ode.lhs.name}}{{concentration_suffix}}_shared_concentration{% endfor %}{% for inline in receptor_info["Dependencies"]["receptors"] %}, GPU_{{inline.variable_name}}{{receptor_suffix}}_shared_current{% endfor %}{% for inline in receptor_info["Dependencies"]["channels"] %}, GPU_{{inline.variable_name}}{{channel_suffix}}_shared_current{% endfor %}{% for inline in receptor_info["Dependencies"]["continuous"] %}, GPU_{{inline.variable_name}}{{continuous_suffix}}_shared_current{% endfor %}, stream);
    {% endfor -%}

    {%- for receptor_name, receptor_info in recs_info.items() %}
    {%- for synapse_name, synapse_info in syns_info.items() %}
    {%- with  %}
    {%- set conc_dep = set(receptor_info["Dependencies"]["concentrations"]).union(synapse_info["Dependencies"]["concentrations"])%}
    {%- set rec_dep = set(receptor_info["Dependencies"]["receptors"]).union(synapse_info["Dependencies"]["receptors"])%}
    {%- set chan_dep = set(receptor_info["Dependencies"]["channels"]).union(synapse_info["Dependencies"]["channels"])%}
    {%- set con_in_dep = set(receptor_info["Dependencies"]["continuous"]).union(synapse_info["Dependencies"]["continuous"])%}
