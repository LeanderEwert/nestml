    }
    {% endfor -%}
    {%- for receptor_name, receptor_info in recs_info.items() %}
    if({{receptor_name}}{{receptor_suffix}}.neuron_{{ receptor_name }}_receptor_count){
        con_end_index = int({{receptor_name}}{{receptor_suffix}}.compartment_association[0]);
