{%- if tracing %}/* generated by {{self._TemplateReference__context.name}} */ {% endif -%}
{%- import 'directives_cpp/FunctionDeclaration.jinja2' as function_declaration with context %}
#ifndef RECEPTORS_NEAT_H_{{cm_unique_suffix | upper }}
#define RECEPTORS_NEAT_H_{{cm_unique_suffix | upper }}

#include <stdlib.h>
#include <vector>
#include <cmath>
#include <string>
#include <nlohmann/json.hpp>

{% macro render_variable_type(variable) -%}
{%- with -%}
    {%- set symbol = variable.get_scope().resolve_to_symbol(variable.name, SymbolKind.VARIABLE) -%}
    {{ types_printer.print(symbol.type_symbol) }}
{%- endwith -%}
{%- endmacro %}

//elementwise vector operations:
#include <iostream>
#include <stdexcept>
#include <algorithm>
#include <cuda_runtime.h>

////////////////////////////////////////////////// receptors

{% macro render_time_resolution_variable(receptor_info) -%}
{# we assume here that there is only one such variable ! #}
{%- with %}
{%- for analytic_helper_name, analytic_helper_info in receptor_info["analytic_helpers"].items() -%}
{%- if analytic_helper_info["is_time_resolution"] -%}
    {{ analytic_helper_name }}
{%- endif -%}
{%- endfor -%}
{% endwith %}
{%- endmacro %}

{%- with %}
{%- for receptor_name, receptor_info in recs_info.items() %}

enum {{ receptor_name }}VarIndexes
{
    {%- for variable_name, variable_info in receptor_info["States"].items() %}
  i_{{ variable_name }},
    {%- endfor %}

    {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  i_{{state_variable_name}},
        {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  i_{{state_variable_name}},
        {%- endfor %}
    {%- endfor %}

  i_{{ receptor_name }}_v_comp,
  i_{{ receptor_name }}_s_val,
  i_i_tot_{{ receptor_name }},
  i_{{ receptor_name }}_g_val,
  i_{{ receptor_name }}_i_val,
  i_{{ receptor_name }}_i_tot_dv,
  i_{{ receptor_name }}_d_i_tot_dv,
  N_{{ receptor_name }}_VARS
};

enum {{ receptor_name }}ParamIndexes
{
    {%- for param_name, param_declaration in receptor_info["Parameters"].items() %}
  i_{{param_name}},
    {%- endfor %}

    {%- for internal_name, internal_declaration in receptor_info["internals_used_declared"] %}
  i_{{internal_name}},
    {%- endfor %}

  N_{{ receptor_name }}_PARAM
};

struct {{receptor_name}}{{cm_unique_suffix}}Device;

class {{receptor_name}}{{cm_unique_suffix}}{
private:
  static constexpr int i_v_comp = i_{{ receptor_name }}_v_comp;
  static constexpr int i_s_val = i_{{ receptor_name }}_s_val;
  static constexpr int i_g_val = i_{{ receptor_name }}_g_val;
  static constexpr int i_i_val = i_{{ receptor_name }}_i_val;
  static constexpr int i_i_tot_dv = i_{{ receptor_name }}_i_tot_dv;
  static constexpr int i_d_i_tot_dv = i_{{ receptor_name }}_d_i_tot_dv;

  // global receptor index
  std::vector< long > rec_idx = {};

  // propagators, initialized via calibrate()
  {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
  {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  std::vector< double > {{state_variable_name}};
  {%- endfor %}
  {%- endfor %}

  // kernel state variables, initialized via calibrate()
  {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
  {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  std::vector< double > {{state_variable_name}};
  {%- endfor %}
  {%- endfor %}

  // user defined parameters, initialized via calibrate()
  {%- for param_name, param_declaration in receptor_info["Parameters"].items() %}
  std::vector< double > {{param_name}};
  {%- endfor %}

      // states
    {%- for pure_variable_name, variable_info in receptor_info["States"].items() %}
        {%- set variable = variable_info["ASTVariable"] %}
        {%- set rhs_expression = variable_info["rhs_expression"] %}
  std::vector<{{ render_variable_type(variable) }}> {{ variable.name }} = {};
    {%- endfor %}

  std::vector < double > s_val = {};

  std::vector< double > i_tot_{{receptor_name}} = {};
  std::vector< double > g_val = {};
  std::vector< double > i_val = {};
  std::vector< double > d_i_tot_dv = {};

  // user declared internals in order they were declared, initialized via calibrate()
  {%- for internal_name, internal_declaration in receptor_info["internals_used_declared"] %}
  std::vector< double > {{internal_name}};
  {%- endfor %}

//device variables
  float* GPU_{{receptor_name}}_vars = nullptr;
  float* GPU_{{receptor_name}}_param = nullptr;
  int* GPU_compartment_association = nullptr;
  int* GPU_rec_idx = nullptr;
  int* GPU_self_spikes = nullptr;
  double* GPU_time_resolution = nullptr;
  int mechanism_stride = 0;
  int population_neuron_count = 1;
  int population_n_var = 0;
  int population_n_param = 0;
  int population_compartment_count = 0;
  int population_voltage_base_index = 0;
  int var_base_index = 0;
  int param_base_index = 0;
  float* GPU_population_vars = nullptr;

//non specific variables
  float* GPU_v_comp;
  float* GPU_s_val;
  float* GPU_i_tot_{{receptor_name}};
  float* GPU_g_val;
  float* GPU_i_val;
  float* GPU_i_tot_dv;
  float* GPU_d_i_tot_dv;

//model specific states
    {%- for variable_name, variable_info in receptor_info["States"].items() %}
  float* GPU_{{ variable_name }};
    {%- endfor %}

    {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["propagators"].items()%}
  float* GPU_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

    {%- for convolution, convolution_info in receptor_info["convolutions"].items() %}
        {%- for state_variable_name, state_variable_info in convolution_info["analytic_solution"]["kernel_states"].items()%}
  float* GPU_{{state_variable_name}};
        {%- endfor %}
    {%- endfor %}

//model specific parameters
    {%- for param_name, param_declaration in receptor_info["Parameters"].items() %}
  float* GPU_{{param_name}};
    {%- endfor %}

    {%- for internal_name, internal_declaration in receptor_info["internals_used_declared"] %}
  float* GPU_{{internal_name}};
    {%- endfor %}

  {{receptor_name}}{{cm_unique_suffix}}Device* device_ = nullptr;
  bool device_dependencies_bound_ = false;
  {{receptor_name}}{{cm_unique_suffix}}Device& device_view();
  void clear_device_dependencies();
  void bind_device_dependencies({% for ode in receptor_info["Dependencies"]["concentrations"] %}{% if not loop.first %}, {% endif %}float* dep_{{ode.lhs.name}}{% endfor %}{% if receptor_info["Dependencies"]["concentrations"] and (receptor_info["Dependencies"]["receptors"] or receptor_info["Dependencies"]["channels"] or receptor_info["Dependencies"]["continuous"]) %}, {% endif %}{% for inline in receptor_info["Dependencies"]["receptors"] %}{% if not loop.first %}, {% endif %}float* dep_{{inline.variable_name}}{% endfor %}{% if receptor_info["Dependencies"]["receptors"] and (receptor_info["Dependencies"]["channels"] or receptor_info["Dependencies"]["continuous"]) %}, {% endif %}{% for inline in receptor_info["Dependencies"]["channels"] %}{% if not loop.first %}, {% endif %}float* dep_{{inline.variable_name}}{% endfor %}{% if receptor_info["Dependencies"]["channels"] and receptor_info["Dependencies"]["continuous"] %}, {% endif %}{% for inline in receptor_info["Dependencies"]["continuous"] %}{% if not loop.first %}, {% endif %}float* dep_{{inline.variable_name}}{% endfor %});

public:
  // constructor, destructor
  {{receptor_name}}{{cm_unique_suffix}}(){};
  ~{{receptor_name}}{{cm_unique_suffix}}();

  void new_receptor(std::size_t comp_ass, const long rec_index);
  void new_receptor(std::size_t comp_ass, const long rec_index, const nlohmann::json& receptor_params);
  void init_base_arrays(float* vars, float* params, int n_var, int n_param, int i_neuron, int var_base_index, int param_base_index, int mechanism_count)
  {
    GPU_{{receptor_name}}_vars = vars == nullptr ? nullptr : vars + i_neuron * n_var + var_base_index;
    GPU_{{receptor_name}}_param = params == nullptr ? nullptr : params + i_neuron * n_param + param_base_index;
    mechanism_stride = mechanism_count;
    this->var_base_index = var_base_index;
    this->param_base_index = param_base_index;
  }

  void configure_population(float* var_arr,
                            float* param_arr,
                            int n_var,
                            int n_param,
                            int neuron_count,
                            int compartment_count,
                            int compartment_voltage_base_index,
                            int mechanism_count,
                            int mechanism_var_base_index,
                            int mechanism_param_base_index,
                            const std::vector<int>& global_compartment_association,
                            const std::vector<int>& receptor_indices,
                            int* global_self_spikes,
                            double* global_time_resolution);
  int get_var_base_index() const { return var_base_index; }
  int get_param_base_index() const { return param_base_index; }
  const std::vector<long>& get_receptor_indices() const { return rec_idx; }

  //number of receptors
  std::size_t neuron_{{ receptor_name }}_receptor_count = 0;

  std::vector< size_t > compartment_association = {};

  void f_numstep_device(float* shared_v_comp, float* compartment_g, float* compartment_i, int total_compartment_count, long lag, float* port_input_arr, int port_input_arr_step, int port_input_port_step{% for ode in receptor_info["Dependencies"]["concentrations"] %}, float* dep_{{ode.lhs.name}}{% endfor %}{% for inline in receptor_info["Dependencies"]["receptors"] %}, float* dep_{{inline.variable_name}}{% endfor %}{% for inline in receptor_info["Dependencies"]["channels"] %}, float* dep_{{inline.variable_name}}{% endfor %}{% for inline in receptor_info["Dependencies"]["continuous"] %}, float* dep_{{inline.variable_name}}{% endfor %}, cudaStream_t stream = nullptr);
  void add_total_current_to_device(float* compartment_current, int compartment_count, cudaStream_t stream = nullptr) const;

    void f_self_spike(cudaStream_t stream = nullptr);

  // calibration
  void calibrate(double time_resolution);
  // function declarations
  {%- for function in receptor_info["Functions"] %}
  #pragma omp declare simd
    __attribute__((always_inline)) inline {{ function_declaration.FunctionDeclaration(function, pass_by_reference = true) -}};

  {% endfor %}

};

{% endfor %}
{% endwith -%}

#endif /* #ifndef RECEPTORS_NEAT_H_{{cm_unique_suffix | upper }} */
